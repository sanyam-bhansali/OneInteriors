// One Interiors — data model
// Postgres + Prisma. Money is stored in PAISE (integer) everywhere. Never floats.
// Every model that participates in the trust record is append-only or audited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase needs BOTH, and the distinction is not optional:
  //   DATABASE_URL — Supavisor transaction pooler, port 6543, ?pgbouncer=true.
  //                  Used by PrismaClient at runtime. Serverless functions open
  //                  a connection per invocation, and the direct port will run
  //                  out of connections under any real traffic.
  //   DIRECT_URL   — direct connection, port 5432. Used by the Prisma CLI for
  //                  migrations. Migrations through the pooler hang or fail,
  //                  which is the single most common Prisma+Supabase problem.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STUDIO
  OPS
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  /// E.164. Primary identity for customers (WhatsApp OTP). Optional because ops
  /// and studio staff sign in by email before a phone is ever collected.
  phone         String?   @unique
  phoneVerified DateTime?
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("en-IN")

  /// scrypt, `s1$N$r$p$salt$hash`. OPS accounts only — see
  /// modules/auth/password.ts for why studios stay magic-link-only. Null for
  /// everyone who has not set one, which is the normal state.
  passwordHash  String?
  passwordSetAt DateTime?
  /// Consecutive failed password attempts. Cleared on any successful sign-in,
  /// including by magic link.
  failedSignIns Int       @default(0)
  /// Set when the attempt limit is reached. Password sign-in stays refused
  /// until a magic link is redeemed — deliberately not a timed lock, which an
  /// attacker simply waits out.
  lockedOutAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — DPDP erasure sets this + scrubs PII

  brief         Brief?
  studioMember  StudioMember?
  sessions      Session[]
  consents      Consent[]
  auditEntries  AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  @@index([role])
  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token. The cookie holds the plaintext; the database
  /// never does, so a dump cannot be replayed as a login.
  tokenHash  String    @unique
  userAgent  String?
  ipHash     String? // hashed, never raw — DPDP minimisation
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthChannel {
  EMAIL
  WHATSAPP
}

/// One model for both sign-in routes. Email magic links carry ops and studio
/// staff today; WhatsApp OTP carries customers when Meta approval lands. The
/// verification flow is identical either way, so it should not be two code
/// paths that drift.
model LoginChallenge {
  id         String      @id @default(cuid())
  /// Email address or E.164 phone, normalised.
  identifier String
  channel    AuthChannel
  /// SHA-256 of the token. The plaintext exists only in the email/SMS — a
  /// database leak must not hand someone a working sign-in link.
  tokenHash  String      @unique
  attempts   Int         @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  ipHash     String?
  createdAt  DateTime    @default(now())

  @@index([identifier, createdAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

// DPDP Act 2023 — consent is per-purpose, versioned, and withdrawable.
// The 20,000 imported records need a row here before any campaign touches them.
enum ConsentPurpose {
  MARKETING_EMAIL
  MARKETING_WHATSAPP
  MARKETING_SMS
  DATA_PROCESSING
  IMPORTED_LEAD // pre-existing record; source must be recorded
}

model Consent {
  id String @id @default(cuid())

  /// Null until they sign in. Consent is asked at the end of the quiz, which
  /// is before we know who they are — and asking for a phone number in order
  /// to record a consent decision would itself be collecting data we had no
  /// consent for.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The same browser token the anonymous brief uses. Claimed together.
  anonKey String?

  purpose ConsentPurpose
  granted Boolean
  source  String // "quiz_consent_step" | "hauspire_import_2026_09" | "ops_manual"

  /// The version of the notice they were shown. Consent does not carry across
  /// a material change to what we said, and that is only knowable if the
  /// version was recorded at the time.
  policyVersion String

  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([userId, purpose])
  @@index([anonKey])
  @@map("consents")
}

// ─────────────────────────────────────────────────────────────
// BRIEF — the 9-question quiz output
// ─────────────────────────────────────────────────────────────

enum PropertyType {
  BHK_1
  BHK_2
  BHK_3
  BHK_4_PLUS
  VILLA
  OTHER
}

enum BudgetTier {
  ESSENTIAL
  PREMIUM
  LUXURY
}

enum ScopeType {
  FULL_HOME
  KITCHEN_WARDROBE
  SINGLE_ROOM
  RENOVATION
}

enum Involvement {
  DECIDE_FOR_ME
  COLLABORATE
  APPROVE_EVERYTHING
}

enum PriorityFactor {
  BUDGET
  SPEED
  DESIGN_AMBITION
  MATERIAL_QUALITY
}

model Brief {
  id String @id @default(cuid())

  /// Null until the person signs in. A brief starts anonymous because asking
  /// for a phone number before showing any value is what kills quiz
  /// completion — the whole flow is built to give the reveal first and ask
  /// second.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Random token held in an httpOnly cookie, so an anonymous brief survives a
  /// reload and can be claimed on sign-in. Cleared when claimed, so a brief is
  /// never reachable by both a stale cookie and an account.
  anonKey String? @unique

  // Q1
  propertyType   PropertyType?
  carpetAreaSqft Int?
  locality       String? // Pune locality slug: "kharadi", "baner", "wakad"
  possessionOn   DateTime?

  // Q2
  scope ScopeType?

  /// Essential / Premium / Luxury. The band the customer chose — a statement
  /// about materials and finish, never a ranking of studios and never
  /// influenced by what a studio pays us.
  tier BudgetTier?

  /// Object path in the private floor-plan bucket. Never a public URL: the
  /// file is somebody's home layout, and it is served only through a short
  /// signed URL to a person who owns the brief.
  floorPlanPath String?
  floorPlanName String?

  // Q3 — paise
  budgetMinPaise BigInt?
  budgetMaxPaise BigInt?

  // Q4 / Q5 — style image picks resolve to tag slugs
  styleLikes    String[] @default([])
  styleDislikes String[] @default([]) // HARD FILTER, not a weight

  // Q6
  adults        Int?
  children      Int?
  elderly       Int?
  pets          Boolean @default(false)
  worksFromHome Boolean @default(false)

  // Q7 — ranked, index 0 = most important
  priorityRanking PriorityFactor[] @default([])

  // Q8
  involvement Involvement?

  // Q9
  moveInBy DateTime?

  completedAt DateTime? // null = abandoned mid-quiz; drives drop-off analytics
  lastStep    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches       Match[]
  shortlists    Shortlist[]
  quotations    Quotation[]
  projects      Project[]
  consultations Consultation[]
  prepRooms     PrepRoom[]
  introductions Introduction[]

  /// What the brief actually led to. See "THE CUSTOMER JOURNEY, KEPT".
  firstQuotes   FirstQuote[]
  quoteDecision QuoteDecision?

  /// Set when an anonymous brief is attached to an account. Kept for the
  /// funnel: the gap between completedAt and this is how long people take to
  /// decide we are worth a phone number.
  claimedAt DateTime?

  /// Bearer token for the read-only shared comparison.
  ///
  /// Nobody spends nine lakh rupees alone. The decision is made with a spouse,
  /// often with parents, and until now the second person could only hear about
  /// the quotes second-hand from someone reciting them from memory. This is the
  /// link that puts them in front of the same page.
  ///
  /// It is a BEARER token: anyone holding the URL can read it. That is the
  /// point — the recipient has no account and we are not making them create
  /// one — but it is also why the shared page shows the brief and the quotes
  /// and nothing else. No email, no phone, no name, and no way to act: a
  /// reader cannot request an introduction, change an answer, or see who else
  /// it was sent to.
  ///
  /// Null until the customer deliberately asks for a link. Revocable by
  /// clearing it, which is why it is nullable rather than generated up front
  /// for every brief.
  shareToken String?   @unique
  sharedAt   DateTime?

  @@index([locality, completedAt])
  @@index([anonKey])
  @@map("briefs")
}

// ─────────────────────────────────────────────────────────────
// APPLICATION — how a studio gets in
// ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Studios apply; we approve. Nobody self-serves onto the roster.
///
/// Kept SEPARATE from Studio on purpose: an application is a claim, a Studio is
/// something we have checked. Merging them would mean an unreviewed applicant
/// briefly existing as a studio row, and the whole product rests on that never
/// being possible.
///
/// Everything here is SELF-DECLARED and must be treated as such until an ops
/// check says otherwise — nothing on this model may reach a customer-facing
/// page.
model StudioApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(SUBMITTED)

  // Who
  tradeName   String
  legalName   String?
  contactName String
  email       String
  phone       String
  website     String?
  instagram   String?

  // What they say about themselves
  city            String   @default("pune")
  localities      String[] @default([])
  gstin           String?
  yearsActive     Int?
  teamSize        Int?
  minProjectPaise BigInt?
  maxProjectPaise BigInt?
  about           String?  @db.Text

  /// Where they heard about us — the cheapest acquisition signal we get.
  howHeard String?

  // Review
  reviewedById   String?
  reviewedAt     DateTime?
  decisionReason String?   @db.Text
  /// Set when approved — the Studio this became.
  studioId       String?   @unique

  /// Anti-spam: hashed, never raw.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("studio_applications")
}

// ─────────────────────────────────────────────────────────────
// STUDIO
// ─────────────────────────────────────────────────────────────

enum VerificationTier {
  UNVERIFIED
  LISTED // Tier 1 — identity
  VERIFIED // Tier 2 — trading history
  PROVEN // Tier 3 — performance through our escrow. The moat.
}

enum StudioStatus {
  ONBOARDING
  ACTIVE
  PAUSED // voluntarily not taking leads
  SUSPENDED // ops action, appealable
  REMOVED
}

model Studio {
  id   String @id @default(cuid())
  slug String @unique

  legalName  String
  tradeName  String
  about      String?  @db.Text
  city       String   @default("pune")
  localities String[] @default([]) // areas they serve

  status StudioStatus     @default(ONBOARDING)
  tier   VerificationTier @default(UNVERIFIED)

  // Registry identifiers — verified, not self-declared
  gstin       String? @unique
  cin         String? @unique
  udyamNumber String?
  panLast4    String?

  /// The studio has told us it has no GST registration.
  ///
  /// Plenty of good Pune studios are proprietorships below the threshold, and
  /// that is not a disqualification — it means we verify them a different way
  /// (PAN, bank records, an extra reference call).
  ///
  /// This exists because the onboarding rule was always "a GSTIN, or a note
  /// that you do not have one", and only the first half was representable. A
  /// studio without GST could complete every other step and then sit forever on
  /// a greyed-out submit button, with no way for ops to unblock them either.
  /// A blank field and a declared absence are different facts and the schema
  /// has to be able to tell them apart.
  gstinNotApplicable Boolean @default(false)
  /// Why, in the studio's own words. Read by whoever verifies them.
  gstinNote          String?

  /// What a studio with fewer than three completed projects has instead.
  ///
  /// The portfolio step asked for three finished projects and accepted nothing
  /// else, so a young practice was approved, invested half an hour, and then
  /// stopped dead on a step it could not pass — and it learned the requirement
  /// only *after* being accepted, which reads as a bait-and-switch even though
  /// it is not one.
  ///
  /// Three is still the bar for being listed. This is the same shape as
  /// `gstinNotApplicable`: a declared, reviewable alternative rather than a
  /// blank. Work in progress, a project completed under a previous practice, a
  /// site we can go and stand in — all of them are things ops can check, and a
  /// three-year-old practice with two finished flats and one running is exactly
  /// the kind of studio we should want.
  ///
  /// Set means "we have read what they have and we will judge it ourselves".
  /// It unblocks submission; it does not confer the tier.
  portfolioShortfallNote String? @db.Text

  // Self-declared context. Shown, but never used to compute a tier — anything
  // that affects the badge has to be something we checked.
  yearsActive Int?
  teamSize    Int?
  website     String?
  instagram   String?

  /// One line under the studio name on their profile. Written by them, or
  /// drafted by the agent and then approved by them — never published unread.
  headline String?
  /// Who this studio is genuinely not right for. Published deliberately: a
  /// studio that suits everyone suits no one, and this is what makes the rest
  /// of the profile believable.
  notFor   String? @db.Text

  /// Which onboarding steps the studio has finished. Drives their checklist and
  /// tells ops whether the ball is in our court or theirs.
  onboardingSteps Json?

  /// This row is a test record, not a business. Set = hidden everywhere.
  ///
  /// Distinct from `status`, deliberately. Every StudioStatus is a statement
  /// about a real studio: ONBOARDING is one that is filling its profile in,
  /// SUSPENDED is one under investigation, REMOVED is one we threw off for
  /// misrepresentation or a pattern of upheld disputes. Using REMOVED to tidy
  /// away something you made while testing puts a fiction in the same column
  /// the appeals process reads, and the words stop meaning anything.
  ///
  /// So this is a separate axis: not a judgement about a studio, a statement
  /// that there is no studio. It hides the row from the roster, from matching
  /// and from every ops count, while leaving it intact and reversible — which
  /// deletion is not, and which matters when the thing you hid turns out to
  /// have been real after all.
  ///
  /// A timestamp rather than a boolean, for the same reason
  /// `portfolioShortfallNote` has no companion flag: one field cannot disagree
  /// with itself, and knowing WHEN something was hidden is free.
  hiddenAsTestAt DateTime?

  // Commercial
  minProjectPaise BigInt?
  maxProjectPaise BigInt?
  designFeePaise  BigInt?

  // ── Allocation ──
  //
  // What a subscription actually buys is VOLUME — how many briefs a studio is
  // shown for. It never buys POSITION: order within a customer's matches comes
  // from the matching engine and nothing else, which is why none of these
  // fields is readable by `score.ts` except `pausedAt`, and why there is no
  // "boost" or "priority" column here for anyone to reach for later.

  /// How many projects a month this studio says it can actually take on.
  /// Self-declared and used for allocation planning, never for ranking.
  capacityPerMonth Int?

  /// Set while a studio is out of rotation — at capacity, on holiday, unpaid,
  /// or under investigation. A paused studio fails the matching hard filters
  /// outright rather than ranking low: showing a customer a studio that cannot
  /// take the work wastes the one introduction we get.
  pausedAt     DateTime?
  /// Why. Required when pausing, and shown to the studio, because a studio that
  /// discovers it is invisible without being told is a studio that leaves.
  pausedReason String?
  /// What kind of pause. Distinguishes the ones that should lift by themselves —
  /// a capacity pause ends with the month, a payment pause ends when they pay —
  /// from a deliberate one that only a human should undo.
  pauseCause   PauseCause?

  // Derived performance — recomputed by a job, never written by hand.
  // Null until enough completed projects exist. Do NOT default these to
  // flattering values; the UI must render "not enough data".
  completedProjects     Int       @default(0)
  avgVarianceDays       Float?
  upheldDisputes        Int       @default(0)
  specComplianceRate    Float?
  /// Mean past-client rating for communication, 1–5. Null until ~3 ratings.
  communicationRating   Float?
  /// 0 = hands-off, 1 = highly collaborative. Drives the working-style match.
  autonomyProfile       Float?
  performanceComputedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       StudioMember[]
  verifications VerificationCheck[]
  portfolio     PortfolioProject[]
  rateCard      RateCardItem[]
  matches       Match[]
  quotations    Quotation[]
  projects      Project[]
  subscription  Subscription?
  profileDraft  ProfileDraft?
  allocations   AllocationPeriod[]
  introductions Introduction[]

  /// First quotes generated against this studio, and the briefs it won.
  /// `wonQuoteDecisions` is named because a Studio reaches QuoteDecision
  /// twice — once through its quotes, once as the winner.
  firstQuotes       FirstQuote[]
  wonQuoteDecisions QuoteDecision[] @relation("FirstQuoteWinner")

  // The studio's own software. See the section at the foot of this file.
  branding           StudioBranding?
  products           StudioProduct[]
  studioQuotes       StudioQuote[]
  studioClients      StudioClient[]
  studioClientEvents StudioClientEvent[]
  studioSavedViews   StudioSavedView[]
  studioStages       StudioStage[]
  studioFields       StudioField[]
  studioProjects     StudioProject[]
  studioVendors      StudioVendor[]
  studioWorkOrders   StudioWorkOrder[]

  /// Past quotations the studio sent us, for deriving their rate card.
  quotationArchives QuotationArchive[]

  @@index([city, status, tier])
  /// Every customer-facing query filters paused studios out.
  @@index([pausedAt])
  @@map("studios")
}

model StudioMember {
  id String @id @default(cuid())

  /// What this person has been shown, and what they have done.
  ///
  /// On the MEMBER and not on the Studio, deliberately. A second person
  /// joining an established studio has learned none of this, and showing them
  /// a finished walkthrough because a colleague completed it two months ago is
  /// how software gets a reputation for being impenetrable. Equally it is not
  /// in the browser: somebody who switches laptop should not be walked through
  /// it twice.
  ///
  /// Shape is `{ dismissed: string[], seen: string[] }` — see
  /// `modules/studio/guide.ts`. Deliberately loose JSON: guides are added and
  /// retired often, and a migration per tour step is a tax on improving them.
  guideState Json?
  studioId   String
  studio     Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOwner    Boolean @default(false)

  createdAt DateTime @default(now())

  /// Everything this person is working. See `StudioClient.assignedTo`.
  clients StudioClient[]

  /// What they have done. SetNull on removal, so a leaver's history stays.
  clientEvents StudioClientEvent[]

  /// Their own saved views. Cascade — see the model.
  savedViews StudioSavedView[]

  @@index([studioId])
  @@map("studio_members")
}

// Every verification item is a row with a source and a date, because the
// profile publishes "GST filings current as of 12 Aug 2026", not a badge.
enum CheckType {
  PAN_NAME_MATCH
  AADHAAR_KYC
  ADDRESS_VISIT
  CONTACT_REACHABLE
  CODE_OF_CONDUCT
  GSTIN_ACTIVE
  GST_FILING_HISTORY
  MCA_STATUS
  UDYAM
  CLIENT_REFERENCE
  SITE_INSPECTION
  LITIGATION_SEARCH
  // The landing page states fifteen mandatory checks. These are the last
  // three, and they gate the VERIFIED tier like the rest — see the note on
  // TIER_CHECKS in src/modules/studio/types.ts.
  RATE_CARD_FILED
  WARRANTY_TERMS
  LABOUR_INSURANCE
}

enum CheckResult {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
  EXPIRED
}

model VerificationCheck {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  type        CheckType
  result      CheckResult @default(PENDING)
  source      String? // "gst_portal" | "idfy" | "ops:manual" | "mca"
  evidenceUrl String? // private object storage key, never public
  notes       String?     @db.Text

  checkedById String?
  checkedAt   DateTime?
  expiresAt   DateTime? // Tier 2 re-audit every 6 months

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, type])
  @@index([studioId, result])
  @@map("verification_checks")
}

model PortfolioProject {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  title        String
  locality     String?
  propertyType PropertyType?
  scope        ScopeType?
  styleTags    String[]      @default([]) // must use the same vocabulary as Brief.styleLikes
  valuePaise   BigInt?
  durationDays Int?
  completedOn  DateTime?

  images          String[] @default([])
  isRender        Boolean  @default(false) // a render labelled as a render is fine; passing one off is not
  clientConsented Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("portfolio_projects")
}

model RateCardItem {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  category  String // "modular_kitchen" | "wardrobe" | "false_ceiling" | "painting" | "electrical"
  label     String
  unit      String // "sqft" | "rft" | "unit" | "lumpsum"
  ratePaise BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, category])
  @@map("rate_card_items")
}

// ─────────────────────────────────────────────────────────────
// MATCHING
// ─────────────────────────────────────────────────────────────

model Match {
  id       String @id @default(cuid())
  briefId  String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  score         Float // 0..100, over MEASURED factors only
  factorsScored Int // e.g. 4 — UI must say "matched on 4 of 6 factors"
  factorsTotal  Int    @default(6)
  breakdown     Json // { styleOverlap: 88, budgetFit: 71, ... } incl. nulls
  reasoning     String @db.Text // the customer-facing explanation
  engineVersion String // "match@1.0.0" — never reinterpret an old score

  createdAt DateTime @default(now())

  @@unique([briefId, studioId])
  @@index([briefId, score])
  @@map("matches")
}

model Shortlist {
  id       String @id @default(cuid())
  briefId  String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  studioId String
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([briefId, studioId])
  @@map("shortlists")
}

// ─────────────────────────────────────────────────────────────
// QUOTATION
// ─────────────────────────────────────────────────────────────

enum QuotationKind {
  INDICATIVE // generated from brief + rate card. Must render its assumptions.
  FIRM // studio-issued, binding within variance band
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quotation {
  id       String @id @default(cuid())
  briefId  String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  kind   QuotationKind
  status QuotationStatus @default(DRAFT)

  subtotalPaise BigInt
  gstPaise      BigInt
  totalPaise    BigInt
  variancePct   Float? @default(15) // published band on indicative quotes

  assumptions String?   @db.Text
  validUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems QuotationLineItem[]
  project   Project?

  @@index([briefId, studioId])
  @@map("quotations")
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  category    String
  description String
  unit        String
  quantity    Float
  ratePaise   BigInt
  amountPaise BigInt
  position    Int    @default(0)

  @@index([quotationId])
  @@map("quotation_line_items")
}

// ─────────────────────────────────────────────────────────────
// PROJECT + ESCROW — the actual product
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  CONTRACTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  DISPUTED
}

model Project {
  id          String     @id @default(cuid())
  briefId     String
  brief       Brief      @relation(fields: [briefId], references: [id], onDelete: Restrict)
  studioId    String
  studio      Studio     @relation(fields: [studioId], references: [id], onDelete: Restrict)
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  reference String        @unique // human-readable: "OI-PN-2026-0042"
  status    ProjectStatus @default(CONTRACTED)

  contractValuePaise BigInt
  /// Commission on a closed project, in basis points.
  ///
  /// 500 = 5.00%, matching `COMMISSION_BPS` in
  /// src/modules/studio/subscription.ts and every business document. This
  /// defaulted to 400 until a studio dashboard was about to render a take rate
  /// computed one way against an invoice computed the other — two sources of
  /// truth for the same rate, disagreeing silently.
  ///
  /// Stored per project rather than read from a constant because a studio's
  /// rate at the moment of signing must survive a later change to the pricing
  /// page. A row already written is never re-rated.
  commissionBps      Int    @default(500) // 5.00%
  commissionPaise    BigInt @default(0)
  escrowFeeBps       Int    @default(175) // 1.75% customer-side

  committedStartOn DateTime
  committedEndOn   DateTime // the date variance is measured against
  actualEndOn      DateTime?

  contractUrl      String?
  contractSignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  escrow     EscrowTransaction[]
  disputes   Dispute[]

  @@index([studioId, status])
  @@index([status, committedEndOn])
  @@map("projects")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED // studio uploaded evidence, awaiting customer
  APPROVED // triggers escrow release
  REJECTED
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  position    Int
  title       String
  description String? @db.Text

  amountPaise BigInt
  status      MilestoneStatus @default(PENDING)

  dueOn           DateTime
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence MilestoneEvidence[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("milestones")
}

model MilestoneEvidence {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  kind         String // "photo" | "invoice" | "material_spec"
  storageKey   String
  caption      String?
  capturedAt   DateTime?
  uploadedById String

  createdAt DateTime @default(now())

  @@index([milestoneId])
  @@map("milestone_evidence")
}

enum EscrowDirection {
  DEPOSIT // customer -> escrow
  RELEASE // escrow -> studio
  REFUND // escrow -> customer
  FEE // escrow -> platform
}

enum EscrowStatus {
  INITIATED
  PENDING
  SETTLED
  FAILED
  REVERSED
}

// Append-only ledger. Corrections are new rows, never updates.
model EscrowTransaction {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestoneId String?

  direction   EscrowDirection
  status      EscrowStatus    @default(INITIATED)
  amountPaise BigInt

  providerRef     String? @unique // escrow partner's transaction id
  providerPayload Json?
  failureReason   String?

  initiatedAt DateTime  @default(now())
  settledAt   DateTime?

  @@index([projectId, direction])
  @@index([status])
  @@map("escrow_transactions")
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  UPHELD // against the studio — counts on their record
  DISMISSED
  WITHDRAWN
}

model Dispute {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  raisedByUserId String
  category       String // "delay" | "material_substitution" | "workmanship" | "billing"
  summary        String        @db.Text
  status         DisputeStatus @default(OPEN)

  resolution   String?   @db.Text
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("disputes")
}

// ─────────────────────────────────────────────────────────────
// BILLING + ALLOCATION
// ─────────────────────────────────────────────────────────────

/// Why a studio is out of rotation.
///
/// The three differ in who lifts them, which is the whole reason to record it:
/// AT_CAPACITY lifts itself when the month turns, PAYMENT_DUE lifts when the
/// invoice clears, and MANUAL only lifts when a person decides. Collapsing them
/// into one flag means either auto-resuming a studio somebody suspended, or
/// leaving a studio invisible for a month after they paid.
enum PauseCause {
  MANUAL
  AT_CAPACITY
  PAYMENT_DUE
}

/// Named for the customer-facing bands, because a studio that sits in the
/// Premium band and pays for a tier called "Verified" has two vocabularies to
/// hold in their head and will mix them up on a call with us.
///
/// Fees live in `src/modules/studio/subscription.ts`, not here — a price is a
/// commercial decision that changes, and a database enum is the wrong place to
/// find out what something costs.
enum SubscriptionTier {
  ESSENTIAL // ₹25k/mo
  PREMIUM // ₹50k/mo
  LUXURY // ₹1L/mo
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  tier   SubscriptionTier   @default(ESSENTIAL)
  status SubscriptionStatus @default(TRIAL)

  monthlyPaise BigInt @default(0)

  /// How many BRIEFS a tier guarantees per month. Not projects.
  ///
  /// The distinction is the whole promise. Whether a brief becomes a project is
  /// the customer's decision, and we do not get to guarantee other people's
  /// decisions — a studio told "sixteen projects" and given sixteen briefs has
  /// been mis-sold, and will say so.
  ///
  /// Renamed from `guaranteedProjects`, which promised exactly the thing the
  /// code comment in subscription.ts said we must never promise.
  guaranteedBriefs Int @default(0)

  startedOn   DateTime  @default(now())
  cancelledOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// One row per studio per billing month. This is how the guarantee is tracked
// and how credit rollover is computed — never recalculated ad hoc.
model AllocationPeriod {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  guaranteed Int
  // "delivered" means SIGNED CONTRACTS, not leads. Contractual definition.
  delivered  Int @default(0)
  shortfall  Int @default(0)

  creditCarriedInPaise  BigInt @default(0)
  creditCarriedOutPaise BigInt @default(0)
  invoicedPaise         BigInt @default(0)

  closedAt DateTime?

  @@unique([studioId, periodStart])
  @@index([periodStart])
  @@map("allocation_periods")
}

// ─────────────────────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────────────────────

model Consultation {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// How to reach them. Collected at the request, because this is the first
  /// point in the flow where we genuinely need to call somebody back.
  contactName  String?
  contactPhone String?
  contactEmail String?

  /// The studios they want to talk about. Studio ids, in the order they
  /// picked them — the expert reads these before the call.
  studioIds      String[] @default([])
  /// What they want to get out of it, in their own words.
  askedAbout     String?  @db.Text
  /// Free text: "weekday evenings", "Saturday morning". A slot picker would
  /// hardcode a scheduling model before we know the shape of these calls.
  preferredTimes String?

  scheduledFor DateTime?
  expertUserId String?
  status       String    @default("requested") // requested | scheduled | completed | no_show | cancelled

  // The expert's read is the training signal for the matching engine.
  outcomeNotes        String?  @db.Text
  recommendedStudioId String?
  matchWasCorrect     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([briefId])
  @@map("consultations")
}

// ─────────────────────────────────────────────────────────────
// INTRODUCTION — the handoff, and the meetings that follow
// ─────────────────────────────────────────────────────────────

/// We handed this customer to this studio.
///
/// ## Why this is its own table
///
/// It is the single event the business charges for, and until now it was
/// recorded nowhere. The expert took a call, decided, and told somebody on
/// WhatsApp. Three things depend on it and all three were running on trust:
///
///  - **Contact release.** "No studio receives your details until you tell an
///    expert which introduction you want" is on the landing page. With no row,
///    that promise had nothing to enforce it — it was a convention. Now it is a
///    query.
///  - **The commission clock.** 5% is charged on a project that came from an
///    introduction we made. A project with no introduction behind it is either
///    a data error or a studio that went around us, and both are worth seeing.
///  - **The honest denominator.** Introductions per studio, and what share of
///    them sign, is the real measure of whether matching works. The expert's
///    `matchWasCorrect` is an opinion; this is an outcome.
///
/// ## Created by a person, always
///
/// There is deliberately no code path that creates one automatically. An
/// introduction is a judgement made on a call — if it could be triggered by a
/// customer action, the expert call would stop being the gate and the whole
/// quality mechanic would quietly become optional.
model Introduction {
  id String @id @default(cuid())

  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// The call this came out of. Nullable only because an introduction could one
  /// day follow from something else; today it never does.
  consultationId String?

  introducedAt   DateTime @default(now())
  /// The expert. A human act, recorded as one.
  introducedById String

  /// When the studio became allowed to see the customer's name and phone.
  ///
  /// Separate from `introducedAt` on purpose: an expert may introduce and hold
  /// contact release until the customer has confirmed they are happy. Null
  /// means the studio knows a brief is coming and nothing about who.
  contactReleasedAt DateTime?

  /// The customer changed their mind. Contact access ends here — see
  /// `canSeeContact` in src/modules/studio/introduction-access.ts, which is the
  /// only place that decision is made.
  withdrawnAt     DateTime?
  withdrawnReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  /// One introduction per studio per brief. A second one is the same
  /// introduction, not a new one.
  @@unique([briefId, studioId])
  @@index([studioId, introducedAt])
  @@map("introductions")
}

enum AppointmentKind {
  FIRST_MEETING
  SITE_VISIT
  FOLLOW_UP
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum NoShowParty {
  CUSTOMER
  STUDIO
}

/// A meeting or site visit between a customer and a studio.
///
/// The product promises this in four separate places — "then we set up the
/// meeting or site visit with that studio directly" — and modelled it in none
/// of them until now.
///
/// Note what this is NOT: `Consultation.scheduledFor` is the expert's own call
/// with the customer, and a `VerificationCheck` site visit is us visiting the
/// studio. Three different things that all involve a date and a visit, kept
/// apart deliberately.
model Appointment {
  id String @id @default(cuid())

  introductionId String
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  kind   AppointmentKind
  status AppointmentStatus @default(PROPOSED)

  /// Stored UTC, rendered IST. One city today, and storing a local time anyway
  /// is how a calendar breaks the first time anything moves.
  startsAt     DateTime
  durationMins Int      @default(60)

  /// The flat, or the studio office. Free text because a Pune address is not a
  /// structure worth modelling for this.
  location String?

  proposedById String
  confirmedAt  DateTime?

  /// Set only alongside `NO_SHOW`, and only by a human.
  ///
  /// Never inferred from an appointment passing its end time. This ends up in a
  /// studio's delivery record, it is the first thing they will dispute, and a
  /// missed appointment has too many innocent explanations for a cron job to
  /// judge.
  noShowBy NoShowParty?

  /// Ops-internal. Never rendered on a studio-facing page — if a studio needs
  /// to know something it is said to them, not left in a field they read over
  /// our shoulder.
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([introductionId])
  @@index([startsAt, status])
  @@map("appointments")
}

/// One room of the prep pack — what the customer did with it between booking
/// the expert call and taking it.
///
/// ## Why this is a table and not a JSON blob on Brief
///
/// Because the expert reads it one room at a time on the call, and because the
/// most valuable column here is `note` — the sentence a customer writes about
/// their own kitchen. That is free-text about their home, it is the thing the
/// designer most wants to have read beforehand, and burying it inside a JSON
/// column would make it unqueryable the first time someone asks which rooms
/// people actually write about.
///
/// ## What is deliberately absent
///
/// No score, no ranking, no completeness percentage. This is preparation, not
/// an exam, and a customer who fills in two rooms and stops has still made
/// their call better. Nothing here may ever be used to deprioritise them.
model PrepRoom {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// One of ROOM_KEYS in src/modules/prepare/rooms.ts. A plain string rather
  /// than an enum because the room set is product surface that will change more
  /// often than the schema should, and a value this table does not recognise
  /// should render as an unknown room, not fail a migration.
  roomKey String

  /// How many times they pressed Shuffle. The proposal is a pure function of
  /// this plus their liked styles, so the board is reproducible from the row —
  /// we store the input, never the generated output.
  shuffle Int @default(0)

  /// Index into the room's decision options, or null for "not decided yet",
  /// which is a genuine and useful answer for the expert to see.
  chosenOption Int?

  /// The board the customer composed: element slugs from
  /// src/modules/prepare/catalogue.ts, in the order they placed them.
  ///
  /// Slugs and not ids, because the catalogue is code rather than a table — it
  /// is vocabulary, revised in pull requests with the reasoning attached, not
  /// data anyone edits at runtime. A slug this array no longer recognises is
  /// skipped when the board is read, so retiring an element never breaks a
  /// board somebody is mid-way through.
  items String[] @default([])

  /// What the customer wrote about this room, in their own words.
  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([briefId, roomKey])
  @@index([briefId])
  @@map("prep_rooms")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel  String // "push" | "whatsapp" | "email"
  template String
  payload  Json
  readAt   DateTime?
  sentAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  action     String // "verification.pass" | "escrow.release" | "studio.suspend"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipHash     String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// A drafted profile, waiting for the studio to read it.
///
/// Kept separate from `Studio` on purpose: a draft is a proposal, and it must
/// be impossible for one to be mistaken for published copy. Nothing here
/// appears anywhere public until the studio has read it and approved it, at
/// which point the text is copied onto the Studio row and `approvedAt` is set.
///
/// `issues` records what the honesty check found at generation time. A draft
/// with issues is still stored — knowing that a draft invented a number is
/// more useful than discarding it silently, and it is how we find out the
/// prompt has drifted.
model ProfileDraft {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  headline     String
  introduction String @db.Text
  notFor       String @db.Text
  /// [{ title, story }] — one per portfolio project, in the same order.
  stories      Json

  /// Which model wrote it, so a bad batch can be traced to a change.
  model       String
  /// Findings from verifyDraft() at generation time. Empty array = clean.
  issues      Json
  generatedAt DateTime @default(now())

  /// Set only when a human at the studio has read it and said yes.
  approvedAt   DateTime?
  approvedById String?

  @@map("profile_drafts")
}

/// A funnel event.
///
/// Deliberately thin, and deliberately ours rather than a third-party script:
/// under the DPDP Act the cheapest position is not to ship visitor data to
/// anyone else at all, and the questions we actually need answered — which
/// quiz question loses people, what did a qualified lead cost — are answerable
/// from our own rows.
///
/// **No personal data goes in `props`.** Not a name, phone, email or free
/// text. It carries counts, slugs and enum values only, and everything here is
/// readable by anyone with ops access.
model AnalyticsEvent {
  id   String @id @default(cuid())
  name String // "quiz.step.view" | "quiz.complete" | "match.view" | "enquiry.sent"

  /// The anonymous brief cookie token, when there is one. Lets a funnel be
  /// followed across a session without knowing who the person is.
  anonKey String?
  /// Set only once they have signed in.
  userId  String?
  briefId String?

  /// Small structured payload. Numbers, slugs and enums only — never free text.
  props Json?

  /// Where they came from. Recorded once per session, on the first event.
  source   String?
  campaign String?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonKey])
  @@index([briefId])
  @@map("analytics_events")
}

// ─────────────────────────────────────────────────────────────
// THE STUDIO'S OWN SOFTWARE
//
// Everything above this line is the marketplace: our briefs, our
// matching, our indicative quotes. Everything below belongs to the
// STUDIO and works whether or not we ever send them a lead.
//
// That distinction is the whole product thesis, so it is worth
// stating where the schema shows it. `Quotation` (above) is the
// indicative number WE produce from a studio's rate card to make two
// studios comparable on a customer's screen. `StudioQuote` (below) is
// the detailed document a studio sends its own client, on its own
// letterhead, for a project we may have had nothing to do with.
//
// Different authors, different audiences, different lifetimes. Naming
// them both "quotation" would have guaranteed somebody eventually
// wrote the wrong one to the wrong screen.
// ─────────────────────────────────────────────────────────────

/// How a line is measured. AREA is width × height in millimetres,
/// which is how carpentry is actually quoted here — the rate is per
/// square foot and the area comes off the drawing.
enum QuoteUnit {
  AREA
  SQFT
  RFT
  UNIT
}

/// The two work codes every quotation in this industry carries.
/// MODULAR is factory-made and is what a discount is usually given
/// against; ONSITE is labour and materials at the site.
enum StudioWorkCode {
  MODULAR
  ONSITE
}

enum StudioQuoteStage {
  /// Before booking. What wins the client.
  SALES
  /// After design sign-off. What the work is actually built against.
  DESIGN
}

enum StudioQuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
}

/// A studio's identity on its own documents.
///
/// This is what makes the quotation builder white-label rather than
/// ours with their name typed in. Nothing here is shown on the
/// marketplace — the public profile has its own fields — because a
/// studio's GSTIN and registered address belong on an invoice, not on
/// a listing.
model StudioBranding {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  legalName   String
  addressLine String?
  city        String  @default("Pune")
  pincode     String?
  gstin       String?
  phone       String?
  email       String?
  website     String?

  /// Storage path, never a public URL. Served through a signed link,
  /// the same way floor plans are.
  logoPath  String?
  accentHex String  @default("#1F5C4D")

  /// The studio's own words at the top of a quotation, and its own
  /// terms at the bottom. Both default to null rather than to ours:
  /// a document going out under their name must not carry copy they
  /// have never read.
  welcomeNote String? @db.Text
  terms       String? @db.Text

  /// Defaults a new quotation starts from. Basis points, so 700 = 7%.
  feeBps              Int    @default(700)
  discountBps         Int    @default(0)
  bookingAdvancePaise BigInt @default(2500000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_branding")
}

/// One studio's product master.
///
/// Per studio, always. The alternative — a shared catalogue everyone
/// draws from — sounds tidier and would mean a studio's own product
/// names, rates and descriptions were visible in a table their
/// competitors also read.
model StudioProduct {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name    String
  code    StudioWorkCode @default(MODULAR)
  unit    QuoteUnit      @default(AREA)
  details String?        @db.Text

  /// Per sqft, per rft, or per unit, depending on `unit`.
  ratePaise BigInt

  /// Which rooms this belongs in, for the first-quote builder.
  rooms String[]

  /// Starting size or count when this lands on a quotation. Millimetres.
  defaultWidthMm  Int?
  defaultHeightMm Int?
  defaultQty      Int?

  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, name])
  @@index([studioId, sortOrder])
  @@map("studio_products")
}

/// A quotation a studio sends its own client.
model StudioQuote {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Per studio, and theirs to set — AKA-2026-014, or 2300, or
  /// whatever their existing books use. Unique within the studio only.
  number String
  stage  StudioQuoteStage  @default(SALES)
  status StudioQuoteStatus @default(DRAFT)

  clientName  String
  clientPhone String?
  clientEmail String?
  society     String?
  locality    String?
  config      String?
  carpetSqft  Int?

  /// Set when this client came from us. Null for the studio's own
  /// work, which is most of it and must stay first-class.
  briefId        String?
  introductionId String?

  /// The client this was written for, once there is one.
  ///
  /// Optional, and it stays optional. A studio often writes a quotation
  /// straight off a phone call before deciding the enquiry is worth a
  /// client record, and making this required would put a data-entry step
  /// in front of the fastest thing in the product.
  clientId String?
  client   StudioClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// The figures that shaped this document, copied at creation so a
  /// later change to the studio's defaults never rewrites a quotation
  /// already sent.
  feeBps              Int
  discountBps         Int
  onSpotPaise         BigInt @default(0)
  bookingAdvancePaise BigInt

  /// Their words on this document, snapshotted for the same reason.
  welcomeNote String? @db.Text
  terms       String? @db.Text

  issuedOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines StudioQuoteLine[]

  @@unique([studioId, number])
  @@index([studioId, status, updatedAt])
  @@map("studio_quotes")
}

/// One line of a studio's quotation.
///
/// Every product field is a SNAPSHOT. Editing the product master must
/// never change a quotation already sent to a client — that is how a
/// studio ends up in an argument it cannot win about what it quoted.
model StudioQuoteLine {
  id      String      @id @default(cuid())
  quoteId String
  quote   StudioQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  room    String
  product String
  code    StudioWorkCode
  unit    QuoteUnit
  details String?        @db.Text

  widthMm  Int?
  heightMm Int?

  /// Quantity in THOUSANDTHS, as an integer.
  ///
  /// 34.39 sqft is 34390. Quantities here are genuinely fractional —
  /// an area comes out at 34.39 sqft, not 34 — and a float would drift
  /// against the money, which is integer paise. Thousandths is finer
  /// than anyone measures and crosses the server/client boundary as a
  /// plain number, which a Prisma Decimal does not.
  qtyMilli Int?

  ratePaise   BigInt
  /// Stored, not computed. A designer overrides a line total often
  /// enough that the agreed number has to be the one that prints, and
  /// on an issued document it is a fact about that document.
  amountPaise BigInt

  sortOrder Int @default(0)

  @@index([quoteId, sortOrder])
  @@map("studio_quote_lines")
}

// ─────────────────────────────────────────────────────────────
// RUNNING THE PRACTICE
//
// Clients, projects, vendors and what is owed. None of this needs
// us: a studio that never takes a single lead from the marketplace
// still has enquiries to chase, sites running and a carpenter waiting
// to be paid. That is the whole point — software they would keep using
// the day they left the roster.
//
// Two rules run through all of it.
//
//  1. NEVER STORE A TOTAL. A work order's bill, what has been paid and
//     what is left are computed from the lines and the payments, every
//     time. A stored total and a payments table disagree eventually,
//     and the disagreement is always found by a vendor who has been
//     paid twice.
//
//  2. WORK ORDER LINES ARE SNAPSHOTS. A line copies the vendor's rate
//     as it was when the order was raised. Editing a rate card later
//     must never silently reprice a bill already paid against.
// ─────────────────────────────────────────────────────────────

/// Where an enquiry came from. An enum rather than free text because
/// "Instagram", "instagram" and "IG" in one column is a source report
/// nobody can read, and the only reason to record a source is to count
/// it later.
enum ClientSource {
  ONE_INTERIORS
  REFERRAL
  REPEAT_CLIENT
  INSTAGRAM
  WEBSITE
  WALK_IN
  ARCHITECT
  OTHER
}

/// What a stage MEANS, as opposed to what it is called.
///
/// This enum is the whole reason a studio can rename its pipeline without
/// breaking the software. The stage list used to be an enum — six fixed
/// values — and a studio whose real process is "New → Calling 1 → Calling 2
/// → Effective lead → Floor plan pending → Quotation pending → Quotation
/// shared" could not write any of that down.
///
/// But Projects, the dashboard and the vendor ledger all need answers to
/// questions that survive renaming: is this client still in play, have they
/// signed, is the job finished, did it go. So a stage carries a `kind`, and
/// every query in the codebase asks the kind rather than the name. A studio
/// owns the names, the order, the colours and how many there are; the four
/// meanings are ours.
enum StageKind {
  /// Still in play. Counts on the board and in "waiting on you".
  OPEN
  /// Signed. A project may be created from a client at this kind and no
  /// other — that rule is what keeps the board and the project list from
  /// disagreeing about whether a job was won.
  WON
  /// Handed over. Off the board, not lost.
  DONE
  /// Gone. Needs a reason.
  LOST
}

/// One column of a studio's pipeline.
///
/// Seeded with six defaults on first read — see `myStages()` — and then
/// entirely theirs. A studio may add, rename, reorder, recolour and delete,
/// with two rules the software enforces: exactly one intake stage, which is
/// where a new client lands and which cannot be deleted, and at least one
/// stage of each kind, because deleting the last WON stage would leave no
/// way to start a project.
model StudioStage {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name String
  kind StageKind @default(OPEN)

  /// One of the eight tokens in `STAGE_COLOURS`. A token and not a hex
  /// value, so the palette stays coherent and dark mode stays possible.
  colour    String @default("slate")
  sortOrder Int

  /// Where a new client lands. Exactly one per studio, undeletable.
  isIntake Boolean @default(false)

  createdAt DateTime @default(now())

  clients StudioClient[]

  @@unique([studioId, name])
  @@index([studioId, sortOrder])
  @@map("studio_stages")
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

/// An extra thing a studio captures on every client.
///
/// Carpet area, society, possession month, BHK — every studio wants a
/// slightly different set and none of them is worth a schema migration. The
/// values live in `StudioClient.fields` as JSON, keyed by `key`.
///
/// `key` is machine-stable and `label` is not: renaming the label must never
/// orphan the values already captured under it, which is exactly what
/// happens if the label is the key.
model StudioField {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  key     String
  label   String
  type    FieldType @default(TEXT)
  /// SELECT only. Ignored for every other type.
  options String[]  @default([])

  /// Offer this field as a grouping on the client list. A studio working one
  /// tower at a time groups by society; one working referrals does not.
  groupBy Boolean @default(false)

  sortOrder Int

  createdAt DateTime @default(now())

  @@unique([studioId, key])
  @@index([studioId, sortOrder])
  @@map("studio_fields")
}

/// Why a client did not go ahead. Short list on purpose: seven reasons
/// a studio will actually pick between, not twenty it picks the first of.
enum LostReason {
  BUDGET
  TIMELINE
  WENT_ELSEWHERE
  NO_RESPONSE
  NOT_SERIOUS
  POSTPONED
  OTHER
}

model StudioClient {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name       String
  phone      String?
  email      String?
  society    String?
  locality   String?
  city       String  @default("Pune")
  config     String?
  carpetSqft Int?

  source     ClientSource @default(OTHER)
  sourceNote String?

  /// The studio's own column, not one of ours. `onDelete: Restrict` because
  /// deleting a stage that still holds clients would silently drop them off
  /// the board — the settings screen makes you move them first.
  stageId String
  stage   StudioStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  lostReason LostReason?
  lostNote   String?

  /// Whatever the studio defined in Settings → Fields, keyed by the field's
  /// `key`. Untyped here and validated on write against the definitions.
  fields Json @default("{}")

  /// The only field here that earns its place every single day. A client
  /// list without a next action is a list; with one, the dashboard can
  /// say "four people are waiting on you".
  nextAction   String?
  nextActionOn DateTime?

  /// Set when they came from us. Null for the studio's own work, which
  /// is most of it and stays first-class.
  briefId        String?
  introductionId String?

  notes String? @db.Text

  /// Who is working this one.
  ///
  /// **Null means the pool** — nobody has taken it yet. That is a real and
  /// common state, not a missing value: two hundred imported rows all start
  /// there, and the pool screen exists to empty it.
  ///
  /// `SetNull` on delete, so removing somebody from the studio returns their
  /// clients to the pool rather than deleting them along with the membership.
  assignedToId String?
  assignedTo   StudioMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  /// When somebody last actually spoke to them.
  ///
  /// Deliberately not `updatedAt`, which moves when anything at all changes —
  /// including a bulk assignment or an import. "Nobody has called this person
  /// in three weeks" is only true if it is measuring calls.
  lastContactedAt DateTime?

  /// Soft delete. The row stays for thirty days and is then erased along with
  /// its history, which is what the bin screen counts down to.
  ///
  /// EVERY read of this table must filter on this being null. A deleted client
  /// reappearing on the board is worse than one that never deleted.
  deletedAt DateTime?

  /// The sample lead, put on an empty board so the screen can be learned by
  /// using it rather than by reading about it.
  ///
  /// It is a real row on purpose. A painted-on example cannot be dragged
  /// between columns, given a follow-up date or quoted from, which is the
  /// entire lesson — the moment somebody touches a fake one it stops teaching
  /// and starts lying.
  ///
  /// **Because it is real, every COUNT must exclude it.** The board lists it;
  /// nothing tallies it. The leads walkthrough ticks its first step off
  /// `clientCount > 0`, so a sample left in the count would congratulate a
  /// studio for work we did on their behalf, and the morning screen would
  /// report somebody waiting who does not exist. `demoLead.ts` holds the one
  /// filter every count uses, so this rule lives in one place.
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   StudioQuote[]
  projects StudioProject[]
  events   StudioClientEvent[]

  /// One row per introduction, so a redelivery cannot create a second
  /// client for the same handoff.
  @@unique([studioId, introductionId])
  @@index([studioId, stageId, nextActionOn])
  /// The board, the pool and the bin are all "this studio, not deleted".
  @@index([studioId, deletedAt])
  @@index([studioId, assignedToId, deletedAt])
  @@map("studio_clients")
}

/// What kind of thing happened to a lead.
///
/// Kept deliberately short. AxLeads carries twenty kinds and several of them
/// exist only because a feature was planned — COLD_TRIGGER_SENT and
/// HOT_ALERTED are written by code paths that have never run in production.
/// An enum value that nothing writes is a promise on a timeline that never
/// keeps it, so these are only the events something already emits.
///
/// Adding a kind is a migration, on purpose: it forces the question of who
/// writes it and what the line reads like before it can be rendered.
enum ClientEventKind {
  /// The lead arrived. The payload says how — typed, imported, or from us.
  CREATED
  /// Moved between columns. Payload carries the from/to stage names.
  STAGE_CHANGED
  /// Somebody rang, messaged or met them. The only writer of lastContactedAt.
  CONTACTED
  /// Given to a person, or returned to the pool.
  ASSIGNED
  /// Free text the studio wrote against this lead.
  NOTE
  /// A quotation was written for them.
  QUOTED
  /// Marked lost. Payload carries the reason.
  LOST
  /// Soft-deleted, or brought back out of the bin.
  BINNED
  RESTORED
  /// The customer asked One Interiors to withdraw the introduction.
  WITHDRAWN
}

/// Who did it.
///
/// `SYSTEM` is load-bearing rather than decorative: a timeline that renders
/// every line as "you" would credit a studio member with the introduction
/// bridge creating a card at 2am. When the actor is us, the line has to say
/// so, because the studio's reading of their own history depends on knowing
/// which half they were responsible for.
enum EventActor {
  MEMBER
  SYSTEM
}

/// One line of a lead's history.
///
/// ## Why this exists
///
/// Before this table, a lead's entire past was a single overwritable `notes`
/// column and `lastContactedAt` — one timestamp, which is not a log. Edits
/// were not even written to `AuditLog`. So "what happened with the Kothari
/// enquiry" had no answer beyond whatever the last person to touch it
/// remembered, and the studio's own record of its work disappeared every time
/// somebody retyped the notes box.
///
/// It is also the foundation the rest of the CRM stands on: call outcomes,
/// stage history and the assignment trail are all reads of this table rather
/// than three more columns on the client.
///
/// ## Append-only by convention
///
/// Nothing updates a row here and nothing deletes one except the cascade from
/// its client. A history you can edit is a history you cannot rely on, and the
/// entire point is to be relied on in an argument about what was promised.
///
/// The exception is the cascade itself: erasing a client from the bin takes
/// its timeline with it, because keeping a detailed record of somebody after
/// deleting them at their own request is the opposite of what the delete was
/// for.
model StudioClientEvent {
  id String @id @default(cuid())

  /// Denormalised from the client on purpose. Every read here is "this
  /// studio's", the same as everywhere else in studio-practice, and joining
  /// through studio_clients to prove ownership on a table this chatty would
  /// make the cheapest query in the module the most expensive.
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind  ClientEventKind
  actor EventActor      @default(MEMBER)

  /// The member who did it. Null for SYSTEM, and null for a member who has
  /// since left — `onDelete: SetNull`, because losing the fact that a stage
  /// change happened is worse than losing who made it.
  byId String?
  by   StudioMember? @relation(fields: [byId], references: [id], onDelete: SetNull)

  /// The name at the time, kept alongside the id.
  ///
  /// A timeline is a historical record, so it has to survive the person
  /// leaving. Reading the name through the relation would silently rewrite
  /// two years of history to "Unknown" the day somebody is removed from the
  /// team — the id is for linking, this is for reading.
  byName String?

  /// One line, already written, in the studio's own vocabulary.
  ///
  /// Composed at write time rather than rendered from `meta` at read time.
  /// A stage rename would otherwise retroactively change what the timeline
  /// says happened, and "moved to Quoted" has to keep saying Quoted even
  /// after the column is renamed to Priced — that is what makes it a record
  /// rather than a view.
  summary String @db.Text

  /// The structured version, for anything that needs to compute rather than
  /// display: from/to stage ids, a call outcome, a lost reason.
  meta Json?

  createdAt DateTime @default(now())

  /// The timeline read: one client, newest first.
  @@index([clientId, createdAt])
  /// "What has this studio been doing", and the per-member activity read.
  @@index([studioId, createdAt])
  @@index([studioId, kind, createdAt])
  @@map("studio_client_events")
}

/// A filter somebody saved and named.
///
/// ## Per MEMBER, not per studio
///
/// "My overdue kitchens in Baner" is a person's working view, not a studio
/// policy. Sharing them would mean one person's tidy-up rearranges everybody
/// else's morning, and the first thing anyone would ask for is a way to make
/// one private — which is this, without the extra column.
///
/// The cost is that a studio cannot hand a new joiner a set of views. That is
/// a real gap and the right time to close it is when somebody asks, with a
/// `sharedAt` column, rather than by making every view shared today.
///
/// ## Why the filters are JSON
///
/// The filter shape belongs to the board and changes with it. Columns would
/// mean a migration every time a filter is added, and a saved view referencing
/// a filter that no longer exists has to degrade quietly — ignoring a key it
/// does not recognise — rather than fail to load. JSON makes that the default
/// behaviour instead of something to remember.
model StudioSavedView {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Whose view. Cascades: a member who leaves takes their views with them,
  /// because a named view nobody can explain is clutter on everybody's screen.
  memberId String
  member   StudioMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name String

  /// `{ assigned, stageIds, due, quiet, source, groupBy }` — whatever the
  /// board understands today. Unknown keys are ignored on read.
  filters Json @default("{}")

  /// The one that loads when the board opens. At most one per member, which
  /// is enforced by the write path clearing the others in the same
  /// transaction rather than by a partial unique index — Prisma cannot
  /// express one, and a raw index here would drift from the schema silently.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One name per person. A second "Overdue" is somebody meaning to edit the
  /// first and getting two instead.
  @@unique([memberId, name])
  @@index([memberId, createdAt])
  @@map("studio_saved_views")
}

/// One request against a rate-limited thing.
///
/// ## Why rows rather than a counter
///
/// A counter per window is one row and one upsert, and it is a FIXED window:
/// somebody can spend the whole quota at 09:59:59 and the whole of the next
/// one at 10:00:01, which is double the rate at exactly the moment an
/// automated caller lands. `lookup-limit.ts` already refuses that trade for
/// the in-memory limiter and the reasoning does not change here.
///
/// So each attempt is a row and the window slides. The cost is a delete of
/// expired rows on every consume, which is one indexed range delete — cheap,
/// and it keeps the table from growing without a cron.
///
/// ## Why this is not per-tenant
///
/// The bucket is whatever the caller says it is: an IP, a form id, a studio.
/// The table is infrastructure, not domain data, and scoping it to a studio
/// would make it useless for the case it exists for — an unauthenticated
/// stranger posting to a public form, who belongs to no studio at all.
model RateLimitHit {
  id String @id @default(cuid())

  /// Namespaced by the caller: `form:<id>`, `ip:<addr>`, `lookup:<addr>`.
  /// Namespacing is the caller's job so two features cannot collide on a
  /// bare IP and silently share a quota.
  bucket String

  createdAt DateTime @default(now())

  /// The only query: count and prune one bucket's recent rows.
  @@index([bucket, createdAt])
  @@map("rate_limit_hits")
}

enum ProjectStage {
  DESIGN
  EXECUTION
  FINISHING
  HANDOVER
  CLOSED
}

model StudioProject {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name  String
  stage ProjectStage @default(DESIGN)

  /// Frozen when the project is created from a won quotation, and the
  /// figure every later number is measured against. Editing the
  /// quotation afterwards must not move it.
  contractPaise BigInt?
  quoteId       String?

  startedOn    DateTime?
  targetDate   DateTime?
  handedOverOn DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders StudioWorkOrder[]

  @@index([studioId, stage])
  @@map("studio_projects")
}

/// A trade a studio subcontracts. Free text rather than an enum: every
/// studio's list is slightly different, and an enum cannot have a value
/// added by a user.
model StudioVendor {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name     String
  trade    String
  phone    String?
  gstin    String?
  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates      StudioVendorRate[]
  workOrders StudioWorkOrder[]

  @@unique([studioId, name])
  @@index([studioId, trade])
  @@map("studio_vendors")
}

/// What this vendor charges for one item.
///
/// A rate card belongs to the VENDOR, not the trade — two carpenters
/// price the same item differently, and the card that loads onto a work
/// order follows the vendor chosen.
model StudioVendorRate {
  id       String       @id @default(cuid())
  vendorId String
  vendor   StudioVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  item      String
  unit      QuoteUnit @default(SQFT)
  ratePaise BigInt

  @@unique([vendorId, item])
  @@map("studio_vendor_rates")
}

model StudioWorkOrder {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  projectId String
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   StudioVendor @relation(fields: [vendorId], references: [id])

  trade    String
  issuedOn DateTime  @default(now())
  dueOn    DateTime?
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    StudioWorkOrderLine[]
  payments StudioVendorPayment[]

  @@index([studioId, projectId])
  @@index([vendorId])
  @@map("studio_work_orders")
}

model StudioWorkOrderLine {
  id          String          @id @default(cuid())
  workOrderId String
  workOrder   StudioWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description String
  unit        QuoteUnit
  /// Thousandths, like every other quantity in this schema.
  qtyMilli    Int?
  /// The vendor's rate AS IT WAS when this order was raised.
  ratePaise   BigInt
  amountPaise BigInt

  sortOrder Int @default(0)

  @@index([workOrderId, sortOrder])
  @@map("studio_work_order_lines")
}

enum PaymentMode {
  BANK
  UPI
  CASH
  CHEQUE
}

/// Money that has left the studio.
///
/// Append-only in spirit: a correction is another row, never an edit.
/// This is the table a vendor dispute turns on, and a record somebody
/// could quietly change is not a record.
model StudioVendorPayment {
  id          String          @id @default(cuid())
  workOrderId String
  workOrder   StudioWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  paidOn      DateTime    @default(now())
  amountPaise BigInt
  mode        PaymentMode @default(BANK)
  reference   String?
  note        String?

  createdAt DateTime @default(now())

  @@index([workOrderId, paidOn])
  @@map("studio_vendor_payments")
}

// ─────────────────────────────────────────────────────────────────────
// THE CUSTOMER JOURNEY, KEPT
//
// Everything below records what a customer actually did with the quotes
// we gave them. Until this existed, the single richest signal in the
// product was thrown away: the generated quotes, which studios were put
// side by side and which lines mattered lived in sessionStorage and died
// when the tab closed. The brief survived; what the brief led to did not.
//
// ## Why this is worth a table rather than an event
//
// `AnalyticsEvent` already records that a quote was viewed. That answers
// "how many" and can never answer "which" — it carries no amounts, no
// lines and no materials, and by design it holds numbers and slugs only.
// The question this business eventually has to answer is *which quotes
// turned into work, and what did the ones that won have in common* — and
// that needs the quote itself, not a counter that one happened.
//
// ## The rule these tables obey
//
// A quote with no outcome teaches nothing. `FirstQuoteSet.wonByStudioId`
// is the column everything here exists to eventually fill; recording the
// quotes without it would be collecting homework nobody marks. It is
// nullable because most briefs never reach a decision, and an unfilled
// outcome must read as unknown rather than as a loss.
//
// ## What is deliberately NOT here
//
// The floor plan file (it is in a private bucket, and its object path is
// already on Brief). Anything the studio wrote. And any judgement about
// why one quote beat another — that is an inference, and inferences do
// not belong in the same table as facts.
// ─────────────────────────────────────────────────────────────────────

/// One studio, priced once, against one brief.
///
/// Regenerating replaces the row rather than adding a second: the customer
/// has one quote per studio at any moment and a history of supersedes would
/// make every later query ask "which one did they actually see?".
model FirstQuote {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // The commercial shape, in paise. Stored rather than recomputed, because
  // the rate card behind it moves and a quote is a thing we said on a day.
  modularPaise         BigInt
  nonModularPaise      BigInt
  modularDiscountPaise BigInt
  professionalFeePaise BigInt
  gstPaise             BigInt
  totalPaise           BigInt
  lowPaise             BigInt
  highPaise            BigInt
  variancePct          Float

  /// The one measurement that genuinely comes from the plan, and the single
  /// biggest mover of the total. Null when a standard kitchen was assumed.
  kitchenRunMm Int?

  /// Where that number came from: the plan, the customer's tape measure, or
  /// our standard. It is why the band is ±10% or ±16%, so it has to survive.
  runSource RunSource

  /// Catalogue codes this studio had filed no rate for. A quote that silently
  /// omits work is the defect the whole product argues against, so the gaps
  /// are recorded as explicitly as the prices.
  notPriced String[] @default([])

  /// Which rate data produced this. While `ratesAreReal()` is false every row
  /// here is priced on archive medians wearing a studio's name, and a year
  /// from now nobody will remember that unless the row says so.
  ratesVersion String

  builtAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines FirstQuoteLine[]

  /// One quote per studio per brief. Regenerating updates in place.
  @@unique([briefId, studioId])
  @@index([briefId, totalPaise])
  @@index([studioId, builtAt])
  @@map("first_quotes")
}

/// A line of a first quote, with its quantity and its material.
///
/// The lines are kept in full, not summarised to a room subtotal. A total
/// without the lines under it is precisely what the landing page holds up as
/// the thing wrong with every other quote in this market, and storing it that
/// way would make our own records worse than the document we showed.
model FirstQuoteLine {
  id      String     @id @default(cuid())
  quoteId String
  quote   FirstQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Catalogue code — the reason a row means the same thing across studios.
  code  String
  room  String
  label String

  /// MO / NM. Which half of the total this falls in.
  work String

  /// "1800 × 2100 mm", "104 sq ft". What the customer was shown.
  size     String
  quantity Float
  unit     String

  ratePaise   BigInt
  amountPaise BigInt

  /// THIS studio's own wording for the material. The only column that can
  /// differ between two studios on the same code, and therefore the only one
  /// that can ever explain a price gap.
  spec String

  /// False when a real kitchen run was supplied and this line used it.
  standard Boolean @default(true)

  @@unique([quoteId, code])
  @@index([code])
  @@map("first_quote_lines")
}

/// What the customer did with the quotes, and how it ended.
///
/// One row per brief. Starring and comparing are revisions of a single
/// opinion rather than a log of separate acts — somebody who stars a line and
/// unstars it has not told us two things.
model QuoteDecision {
  id      String @id @default(cuid())
  briefId String @unique
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// Studio slugs put side by side, in the order they were added.
  comparedSlugs String[] @default([])

  /// Catalogue codes the customer starred on the comparison.
  ///
  /// The most direct statement of intent anywhere in the product: not what
  /// they said they wanted in the quiz, but which work they checked the price
  /// of twice. Worth more than the brief for understanding a customer, and it
  /// was being discarded.
  starredCodes String[] @default([])

  /// Set when we know. Null means unknown, never "lost" — most briefs simply
  /// never reach a decision, and an unfilled outcome that reads as a loss
  /// would poison every rate this is eventually used to calculate.
  wonByStudioId String?
  wonByStudio   Studio? @relation("FirstQuoteWinner", fields: [wonByStudioId], references: [id], onDelete: SetNull)

  /// How we came to know. An outcome with no provenance is a rumour.
  outcomeSource OutcomeSource?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wonByStudioId])
  @@map("quote_decisions")
}

/// Where the kitchen run came from, which is what sets the band.
enum RunSource {
  /// Read from the floor plan they uploaded. ±10%.
  FLOOR_PLAN
  /// They measured it themselves. ±12%.
  CUSTOMER
  /// Nobody measured; the standard 4400mm was used. ±16%.
  STANDARD
}

/// How we learned who won. Never inferred from silence.
enum OutcomeSource {
  /// Ops recorded it after the introduction.
  OPS_RECORDED
  /// The studio marked the introduced client won in their own CRM.
  STUDIO_CRM
  /// The customer told us.
  CUSTOMER_REPORTED
}

// ─────────────────────────────────────────────────────────────
// QUOTATION ARCHIVE
//
// A studio's own past quotations, sent so we can derive their rate card
// instead of asking them to type forty numbers from memory.
//
// `modules/quotation/ingest.ts` is what turns those quotations into rates, and
// it has existed and been tested for a long time against a real archive — 934
// quotations, 25,592 line items, 412 distinct spellings of about twenty
// products. What did not exist was any way for a studio to actually send us
// anything. These two models are that missing half.
//
// The extraction itself is deliberately NOT automated here. Quotation formats
// vary wildly between studios, a parser that is wrong is worse than no parser
// because it produces a plausible rate rather than an error, and at ten
// studios a person reading the files is both affordable and more accurate.
// So: the studio uploads whatever they have, ops pulls the rows out, and
// `ingestQuotations` does the arithmetic.
// ─────────────────────────────────────────────────────────────

enum ArchiveState {
  /// Files are in. Nobody has looked yet.
  RECEIVED
  /// Ops is reading them.
  READING
  /// Rates were derived and filed against the studio's rate card.
  FILED
  /// Not usable — too few, unreadable, or not quotations. `note` says why.
  REJECTED
}

model QuotationArchive {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  state ArchiveState @default(RECEIVED)

  /// How many quotations ops counted once they opened the files.
  ///
  /// Deliberately not a count of FILES: one workbook can hold two hundred
  /// quotations and one PDF can hold a single one, so file count says nothing
  /// about whether there is enough here to derive a rate from. Null until
  /// somebody has actually looked.
  quotationCount Int?

  /// What ops wants the studio to know — why it was rejected, what is missing,
  /// what to send instead. Shown to the studio verbatim, so it is written for
  /// them rather than for us.
  note String? @db.Text

  /// The IngestReport from `ingestQuotations`, kept whole.
  ///
  /// Stored rather than recomputed because it is evidence: which rate came
  /// from how many quotations, the quartile spread behind each one, and the
  /// product strings we could not place. When a studio disputes a number a
  /// year from now, this is the answer.
  report Json?

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  files QuotationFile[]

  @@index([studioId, uploadedAt])
  @@index([state])
  @@map("quotation_archives")
}

model QuotationFile {
  id        String           @id @default(cuid())
  archiveId String
  archive   QuotationArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  /// Object path in the private quotation bucket. Never a public URL — these
  /// are somebody's commercial pricing, and they are served only through a
  /// short-lived signed link to ops. Same rule as floor plans.
  path String

  /// What the studio called it. Shown back to them so they can tell which
  /// file we could not read, and useful to ops for exactly the same reason.
  filename    String
  contentType String
  bytes       Int

  uploadedAt DateTime @default(now())

  @@index([archiveId])
  @@map("quotation_files")
}
