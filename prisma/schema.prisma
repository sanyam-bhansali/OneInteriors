  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  score         Float // 0..100, over MEASURED factors only
  factorsScored Int // e.g. 4 — UI must say "matched on 4 of 6 factors"
  factorsTotal  Int    @default(6)
  breakdown     Json // { styleOverlap: 88, budgetFit: 71, ... } incl. nulls
