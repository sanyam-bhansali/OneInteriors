// One Interiors — data model
// Postgres + Prisma. Money is stored in PAISE (integer) everywhere. Never floats.
// Every model that participates in the trust record is append-only or audited.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Supabase needs BOTH, and the distinction is not optional:
  //   DATABASE_URL — Supavisor transaction pooler, port 6543, ?pgbouncer=true.
  //                  Used by PrismaClient at runtime. Serverless functions open
  //                  a connection per invocation, and the direct port will run
  //                  out of connections under any real traffic.
  //   DIRECT_URL   — direct connection, port 5432. Used by the Prisma CLI for
  //                  migrations. Migrations through the pooler hang or fail,
  //                  which is the single most common Prisma+Supabase problem.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STUDIO
  OPS
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  /// E.164. Primary identity for customers (WhatsApp OTP). Optional because ops
  /// and studio staff sign in by email before a phone is ever collected.
  phone         String?   @unique
  phoneVerified DateTime?
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("en-IN")

  /// scrypt, `s1$N$r$p$salt$hash`. OPS accounts only — see
  /// modules/auth/password.ts for why studios stay magic-link-only. Null for
  /// everyone who has not set one, which is the normal state.
  passwordHash  String?
  passwordSetAt DateTime?
  /// Consecutive failed password attempts. Cleared on any successful sign-in,
  /// including by magic link.
  failedSignIns Int       @default(0)
  /// Set when the attempt limit is reached. Password sign-in stays refused
  /// until a magic link is redeemed — deliberately not a timed lock, which an
  /// attacker simply waits out.
  lockedOutAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — DPDP erasure sets this + scrubs PII

  brief         Brief?
  studioMember  StudioMember?
  sessions      Session[]
  identities    AuthIdentity[]
  consents      Consent[]
  auditEntries  AuditLog[]        @relation("AuditActor")
  notifications Notification[]
  /// Documents this person reviewed. SetNull on the other side — removing an
  /// ops account must not delete the record of what they decided.
  reviewedDocs  StudioDocument[]  @relation("StudioDocumentReviewer")
  reviewedRates StudioFiledRate[] @relation("FiledRateReviewer")

  /// OneReferrals: this customer's personal code (modules/portal/referral.ts).
  /// Made the first time "Your home" is opened.
  referralCode String? @unique

  expertHours  ExpertHours[] @relation("ExpertHours")
  expertBlocks ExpertBlock[] @relation("ExpertBlocks")

  /// Phones signed in to the app, for push (docs/CUSTOMER-PLATFORM-PLAN.md).
  pushDevices PushDevice[]

  @@index([role])
  @@map("users")
}

/// Who a social sign-in provider says this user is. Google since 29 Sep
/// 2026; Apple and Facebook will use the same table.
enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

/// A provider identity linked to a user — "Google account 1098765 is this
/// customer". Found by (provider, subject), never by email: emails change and
/// get recycled, the provider's subject does not. Social sign-in only ever
/// creates or reaches CUSTOMER accounts (see modules/auth/oauth-google.ts).
model AuthIdentity {
  id       String       @id @default(cuid())
  provider AuthProvider
  /// The provider's stable id for the person (OpenID `sub`).
  subject  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The verified email the provider gave at the last sign-in, for support.
  email String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the session token. The cookie holds the plaintext; the database
  /// never does, so a dump cannot be replayed as a login.
  tokenHash  String    @unique
  userAgent  String?
  ipHash     String? // hashed, never raw — DPDP minimisation
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthChannel {
  EMAIL
  WHATSAPP
}

/// One model for both sign-in routes. Email magic links carry ops and studio
/// staff today; WhatsApp OTP carries customers when Meta approval lands. The
/// verification flow is identical either way, so it should not be two code
/// paths that drift.
model LoginChallenge {
  id         String      @id @default(cuid())
  /// Email address or E.164 phone, normalised.
  identifier String
  channel    AuthChannel
  /// SHA-256 of the token. The plaintext exists only in the email/SMS — a
  /// database leak must not hand someone a working sign-in link.
  tokenHash  String      @unique
  attempts   Int         @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  ipHash     String?
  createdAt  DateTime    @default(now())

  @@index([identifier, createdAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

// DPDP Act 2023 — consent is per-purpose, versioned, and withdrawable.
// The 20,000 imported records need a row here before any campaign touches them.
enum ConsentPurpose {
  MARKETING_EMAIL
  MARKETING_WHATSAPP
  MARKETING_SMS
  DATA_PROCESSING
  IMPORTED_LEAD // pre-existing record; source must be recorded
  /// Agreed, when picking studios at the expert step, that the studios they
  /// pick may see their name and number (modules/consent/share.ts).
  SHARE_WITH_STUDIO
}

model Consent {
  id String @id @default(cuid())

  /// Null until they sign in. Consent is asked at the end of the quiz, which
  /// is before we know who they are — and asking for a phone number in order
  /// to record a consent decision would itself be collecting data we had no
  /// consent for.
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The same browser token the anonymous brief uses. Claimed together.
  anonKey String?

  purpose ConsentPurpose
  granted Boolean
  source  String // "quiz_consent_step" | "hauspire_import_2026_09" | "ops_manual"

  /// The version of the notice they were shown. Consent does not carry across
  /// a material change to what we said, and that is only knowable if the
  /// version was recorded at the time.
  policyVersion String

  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([userId, purpose])
  @@index([anonKey])
  @@map("consents")
}

// ─────────────────────────────────────────────────────────────
// BRIEF — the 9-question quiz output
// ─────────────────────────────────────────────────────────────

enum PropertyType {
  BHK_1
  BHK_2
  BHK_3
  BHK_4_PLUS
  VILLA
  OTHER
}

enum BudgetTier {
  ESSENTIAL
  PREMIUM
  LUXURY
}

enum ScopeType {
  FULL_HOME
  KITCHEN_WARDROBE
  SINGLE_ROOM
  RENOVATION
}

enum Involvement {
  DECIDE_FOR_ME
  COLLABORATE
  APPROVE_EVERYTHING
}

enum PriorityFactor {
  BUDGET
  SPEED
  DESIGN_AMBITION
  MATERIAL_QUALITY
}

/// Where the customer is with the flat. Work starts from possession, so the
/// timeline is built around it rather than around a move-in wish.
enum PossessionStatus {
  HAVE_KEYS
  EXPECTED
  NOT_SURE
}

model Brief {
  id String @id @default(cuid())

  /// Null until the person signs in. A brief starts anonymous because asking
  /// for a phone number before showing any value is what kills quiz
  /// completion — the whole flow is built to give the reveal first and ask
  /// second.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Random token held in an httpOnly cookie, so an anonymous brief survives a
  /// reload and can be claimed on sign-in. Cleared when claimed, so a brief is
  /// never reachable by both a stale cookie and an account.
  anonKey String? @unique

  /// Written only by the contact step, after the customer has agreed to the
  /// notice — never by the per-step quiz sync. The number is unverified: it is
  /// a way to reach them about this brief, not an identity (User.phone is).
  contactName  String?
  contactPhone String?
  contactEmail String?

  // Q1
  propertyType     PropertyType?
  carpetAreaSqft   Int?
  locality         String? // Pune locality slug: "kharadi", "baner", "wakad"
  /// The society or building, as typed. Free text; no list exists to pick from.
  society          String?
  /// Q9 since 29 Sep 2026: have the keys / expecting them / not sure.
  possessionStatus PossessionStatus?
  possessionOn     DateTime?

  // Q2
  scope         ScopeType?
  /// Rooms chosen for a single-room job or a renovation (quotation Room codes).
  scopeRooms    String[]   @default([])
  /// Catalogue codes unticked on the scope checklist — left out of every quote.
  excludedItems String[]   @default([])

  /// Essential / Premium / Luxury. The band the customer chose — a statement
  /// about materials and finish, never a ranking of studios and never
  /// influenced by what a studio pays us.
  tier BudgetTier?

  /// Object path in the private floor-plan bucket. Never a public URL: the
  /// file is somebody's home layout, and it is served only through a short
  /// signed URL to a person who owns the brief.
  floorPlanPath    String?
  floorPlanName    String?
  /// The confirmed reading of the plan: kitchen run, bathrooms, study, where
  /// the area came from (PlanUse). Written after the customer confirms it.
  floorPlanReading Json?

  // Q3 — paise
  budgetMinPaise BigInt?
  budgetMaxPaise BigInt?

  // Q4 / Q5 — style image picks resolve to tag slugs
  styleLikes       String[] @default([])
  styleDislikes    String[] @default([]) // HARD FILTER, not a weight
  /// Studios whose own portfolio photo they picked in the style picker —
  /// shown unnamed, with the studio's consent (brief/picker-photos.ts).
  styleStudioPicks String[] @default([])

  // Q6
  adults        Int?
  children      Int?
  elderly       Int?
  pets          Boolean @default(false)
  worksFromHome Boolean @default(false)

  /// HomeNeed values (VASTU, POOJA_ROOM, …) — strings, like styleTags, so a
  /// new need is a code change and not a migration.
  needs String[] @default([])

  // Q7 — ranked, index 0 = most important
  priorityRanking PriorityFactor[] @default([])

  // Q8
  involvement Involvement?

  /// EN | HI | MR — the language they want their studio to speak.
  language String?

  // Q9
  moveInBy DateTime?

  completedAt DateTime? // null = abandoned mid-quiz; drives drop-off analytics
  lastStep    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches       Match[]
  shortlists    Shortlist[]
  quotations    Quotation[]
  projects      Project[]
  consultations Consultation[]
  prepRooms     PrepRoom[]
  introductions Introduction[]

  /// What the brief actually led to. See "THE CUSTOMER JOURNEY, KEPT".
  firstQuotes   FirstQuote[]
  quoteDecision QuoteDecision?

  /// Set when an anonymous brief is attached to an account. Kept for the
  /// funnel: the gap between completedAt and this is how long people take to
  /// decide we are worth a phone number.
  claimedAt DateTime?

  /// Bearer token for the read-only shared comparison.
  ///
  /// Nobody spends nine lakh rupees alone. The decision is made with a spouse,
  /// often with parents, and until now the second person could only hear about
  /// the quotes second-hand from someone reciting them from memory. This is the
  /// link that puts them in front of the same page.
  ///
  /// It is a BEARER token: anyone holding the URL can read it. That is the
  /// point — the recipient has no account and we are not making them create
  /// one — but it is also why the shared page shows the brief and the quotes
  /// and nothing else. No email, no phone, no name, and no way to act: a
  /// reader cannot request an introduction, change an answer, or see who else
  /// it was sent to.
  ///
  /// Null until the customer deliberately asks for a link. Revocable by
  /// clearing it, which is why it is nullable rather than generated up front
  /// for every brief.
  shareToken String?   @unique
  sharedAt   DateTime?

  societyPlan SocietyPlan?

  /// The referral code this customer arrived through, if any — set once,
  /// never by its own owner.
  referredByCode String?

  /// The follow-up call to a customer who finished the brief and did not
  /// book the expert call (ops/follow-ups). Covered by DATA_PROCESSING, which
  /// already tells them we use their number to reach them about their matches
  /// and their call. Outcome: BOOKED | CALL_BACK | NO_ANSWER | NOT_INTERESTED.
  followUpOutcome String?
  followUpNote    String?   @db.Text
  followedUpAt    DateTime?
  /// Calls made without reaching them (NO_ANSWER / CALL_BACK). Stops at three.
  followUpTries   Int       @default(0)

  /// Made by a studio for one of its OWN clients when it started their
  /// project (project/own-project.ts, docs/studio-workspace/OWN-CLIENTS.md):
  /// a minimal brief so the customer has a home in the app. Never part of
  /// One Interiors' own funnel or ops queues. False for every brief a
  /// customer started themselves, including one later reused for an
  /// own-client project.
  madeByStudio Boolean @default(false)

  @@index([locality, completedAt])
  @@index([anonKey])
  @@map("briefs")
}

// ─────────────────────────────────────────────────────────────
// APPLICATION — how a studio gets in
// ─────────────────────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// Studios apply; we approve. Nobody self-serves onto the roster.
///
/// Kept SEPARATE from Studio on purpose: an application is a claim, a Studio is
/// something we have checked. Merging them would mean an unreviewed applicant
/// briefly existing as a studio row, and the whole product rests on that never
/// being possible.
///
/// Everything here is SELF-DECLARED and must be treated as such until an ops
/// check says otherwise — nothing on this model may reach a customer-facing
/// page.
model StudioApplication {
  id     String            @id @default(cuid())
  status ApplicationStatus @default(SUBMITTED)

  // Who
  tradeName   String
  legalName   String?
  contactName String
  email       String
  phone       String
  website     String?
  instagram   String?

  // What they say about themselves
  city            String   @default("pune")
  localities      String[] @default([])
  gstin           String?
  yearsActive     Int?
  teamSize        Int?
  minProjectPaise BigInt?
  maxProjectPaise BigInt?
  about           String?  @db.Text

  /// Where they heard about us — the cheapest acquisition signal we get.
  howHeard String?

  // Review
  reviewedById   String?
  reviewedAt     DateTime?
  decisionReason String?   @db.Text
  /// Set when approved — the Studio this became.
  studioId       String?   @unique

  /// Anti-spam: hashed, never raw.
  ipHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("studio_applications")
}

// ─────────────────────────────────────────────────────────────
// STUDIO
// ─────────────────────────────────────────────────────────────

enum VerificationTier {
  UNVERIFIED
  LISTED // Tier 1 — identity
  VERIFIED // Tier 2 — trading history
  PROVEN // Tier 3 — performance through our escrow. The moat.
}

enum StudioStatus {
  ONBOARDING
  ACTIVE
  PAUSED // voluntarily not taking leads
  SUSPENDED // ops action, appealable
  REMOVED
}

model Studio {
  id   String @id @default(cuid())
  slug String @unique

  legalName  String
  tradeName  String
  about      String?  @db.Text
  city       String   @default("pune")
  localities String[] @default([]) // areas they serve

  /// Street address, for verification rather than for display.
  ///
  /// Nullable because every studio on the roster predates the field. A NOT
  /// NULL with a default would put an invented address in the column that
  /// verification reads, and ops cannot tell a default from a real answer.
  addressLine String?

  /// Six digits, as text. Never an integer: that drops the leading zero a
  /// large share of Indian pincodes start with, and nothing is computed from
  /// one — it is an identifier that happens to be made of digits.
  pincode String?

  status StudioStatus     @default(ONBOARDING)
  tier   VerificationTier @default(UNVERIFIED)

  // Registry identifiers — verified, not self-declared
  gstin    String? @unique
  panLast4 String?

  /// The studio has told us it has no GST registration.
  ///
  /// Plenty of good Pune studios are proprietorships below the threshold, and
  /// that is not a disqualification — it means we verify them a different way
  /// (PAN, bank records, an extra reference call).
  ///
  /// This exists because the onboarding rule was always "a GSTIN, or a note
  /// that you do not have one", and only the first half was representable. A
  /// studio without GST could complete every other step and then sit forever on
  /// a greyed-out submit button, with no way for ops to unblock them either.
  /// A blank field and a declared absence are different facts and the schema
  /// has to be able to tell them apart.
  gstinNotApplicable Boolean @default(false)
  /// Why, in the studio's own words. Read by whoever verifies them.
  gstinNote          String?

  /// What a studio with fewer than three completed projects has instead.
  ///
  /// The portfolio step asked for three finished projects and accepted nothing
  /// else, so a young practice was approved, invested half an hour, and then
  /// stopped dead on a step it could not pass — and it learned the requirement
  /// only *after* being accepted, which reads as a bait-and-switch even though
  /// it is not one.
  ///
  /// Three is still the bar for being listed. This is the same shape as
  /// `gstinNotApplicable`: a declared, reviewable alternative rather than a
  /// blank. Work in progress, a project completed under a previous practice, a
  /// site we can go and stand in — all of them are things ops can check, and a
  /// three-year-old practice with two finished flats and one running is exactly
  /// the kind of studio we should want.
  ///
  /// Set means "we have read what they have and we will judge it ourselves".
  /// It unblocks submission; it does not confer the tier.
  portfolioShortfallNote String? @db.Text

  // Self-declared context. Shown, but never used to compute a tier — anything
  // that affects the badge has to be something we checked.
  yearsActive Int?
  teamSize    Int?
  website     String?
  instagram   String?

  /// One line under the studio name on their profile. Written by them, or
  /// drafted by the agent and then approved by them — never published unread.
  headline String?
  /// Who this studio is genuinely not right for. Published deliberately: a
  /// studio that suits everyone suits no one, and this is what makes the rest
  /// of the profile believable.
  notFor   String? @db.Text

  /// Which onboarding steps the studio has finished. Drives their checklist and
  /// tells ops whether the ball is in our court or theirs.
  onboardingSteps Json?

  /// This row is a test record, not a business. Set = hidden everywhere.
  ///
  /// Distinct from `status`, deliberately. Every StudioStatus is a statement
  /// about a real studio: ONBOARDING is one that is filling its profile in,
  /// SUSPENDED is one under investigation, REMOVED is one we threw off for
  /// misrepresentation or a pattern of upheld disputes. Using REMOVED to tidy
  /// away something you made while testing puts a fiction in the same column
  /// the appeals process reads, and the words stop meaning anything.
  ///
  /// So this is a separate axis: not a judgement about a studio, a statement
  /// that there is no studio. It hides the row from the roster, from matching
  /// and from every ops count, while leaving it intact and reversible — which
  /// deletion is not, and which matters when the thing you hid turns out to
  /// have been real after all.
  ///
  /// A timestamp rather than a boolean, for the same reason
  /// `portfolioShortfallNote` has no companion flag: one field cannot disagree
  /// with itself, and knowing WHEN something was hidden is free.
  hiddenAsTestAt DateTime?

  /// When ops approved a product master read from this studio's own
  /// quotations and it was written into StudioProduct. The studio is then
  /// asked to check it. See `modules/studio-quote/rates-gate.ts`.
  ratesFilledAt    DateTime?
  /// When the studio checked those rates and said they were right. Until
  /// then the quotation builder stays shut. Null for a studio that has not.
  ratesConfirmedAt DateTime?

  // Commercial
  minProjectPaise BigInt?
  maxProjectPaise BigInt?

  /// What the studio actually sells — turnkey, design plus execution, or
  /// design only. See `modules/studio/positioning.ts` for the values.
  ///
  /// The more load-bearing of this pair: a design-only practice should not be
  /// quoted for execution, and until this existed nothing could tell us it
  /// was one. The matcher can act on a column; it cannot act on a sentence in
  /// the description.
  offering String?

  /// How the studio wants to be read: budget, mid, premium, luxury.
  ///
  /// Deliberately NOT derived from `minProjectPaise`/`maxProjectPaise`, which
  /// looks derivable and is not. The range is what they will take on; this is
  /// positioning. A practice whose floor is low because it does the occasional
  /// small job for a repeat client is not thereby budget-friendly, and
  /// computing it would put a claim in a customer's hands that the studio
  /// never made.
  ///
  /// Self-declared, shown, never scored — the same rule as `yearsActive` and
  /// everything else on this side of the model.
  priceLevel String?

  /// When the studio is paid: [{ label, pct }], summing to 100.
  ///
  /// Printed on every quote this studio gets through us, in rupees on that
  /// quote's total — how much leaves a customer's account before anything is
  /// installed is the difference between two quotes at the same figure. From
  /// the studio (the rates step) or read from their own quotations; never a
  /// schedule we invent. Checked by `modules/studio/payment-phases.ts`, and a
  /// stored value that fails the checks is read as none.
  paymentPhases Json?

  /// Studio OS Phase 1 (docs/studio-os/PHASE-1-SALES.md): the studio's
  /// payment schedule for its own sales, set in Settings, Payment stages
  /// (owner): [{ label, note, kind: 'FIXED' | 'PCT', amountPaise?, pct?,
  /// refundDays? }]. Fixed amounts first (Hauspire's booking advance), the
  /// percentages are of the contract after them and total exactly 100.
  /// Checked by `modules/studio-sales/payment-template.ts`; null or a stored
  /// value that fails the checks reads as Hauspire's default. Copied onto a
  /// quotation's sales final, so a later change never rewrites a booked one.
  paymentTemplate Json?

  /// Studio OS Phase 2 (docs/studio-os/PHASE-2-DESIGN.md): the studio's
  /// design steps, set in Settings, Design steps (owner). Checked by
  /// modules/studio-design/template.ts; null or a stored value that fails
  /// the checks reads as Hauspire's default. Copied onto each new project's
  /// DESIGN stage, so a later change never rewrites a running one.
  designTemplate Json?

  /// Studio OS Phase 3 (docs/studio-os/PHASE-3-EXECUTION.md): the studio's
  /// trades, its own routing rules (product name -> trade), rate templates,
  /// the due days, the labour-margin target, the advance limit, the
  /// installation rate and the execution payment locks. Set in Settings,
  /// Crews and trades (owner). Read only through
  /// modules/studio-crews/settings.ts, which repairs a bad value to
  /// Hauspire's defaults.
  crewSettings Json?

  /// The project lifecycle (owner, 13 Oct 2026; docs/studio-os/PROJECT-
  /// LIFECYCLE.md): how long the warranty runs after the client signs off
  /// the handover, in months. Settings, Warranty (owner). Hauspire 12.
  warrantyMonths Int @default(12)

  /// The snag window (owner, 15 Oct 2026; project/snag-window.ts): days the
  /// client may raise snags in the app once the handover (final) payment is
  /// recorded after the closure. After it, raising closes until the handover
  /// sign-off starts the warranty (warranty snags). Settings, Warranty.
  snagWindowDays Int @default(30)

  /// The per-studio pilot switch (owner, 14 Oct 2026): the full Studio OS
  /// (projects, design, site mode, the payments desk, crews, team) is open
  /// only for pilot studios; every other studio gets Leads, Quotations, the
  /// product master, their settings, Today and Calendar. Set by ops on the
  /// studio's page (audited). Read through modules/studio/pilot.ts.
  fullSoftware Boolean @default(false)

  /// The studio software plan (owner, 19 Oct 2026; modules/studio/software-plan.ts):
  /// PRO for every studio (Leads, Quotations, product master, settings, Today,
  /// Calendar), MAX for the full Studio OS (Hauspire while it is tested). The
  /// source of truth from 19 Oct; `fullSoftware` above is kept equal to
  /// (softwarePlan = MAX) for one release and then retired. Set by ops (audited).
  softwarePlan StudioSoftwarePlan @default(PRO)

  /// "New leads go to" (owner, 22 Oct 2026; studio-sales/lead-routing.ts):
  /// who gets a lead that arrives by itself (lead intake, the enquiry form).
  /// POOL is today's behaviour and the default. PERSON gives each one to
  /// `leadRouteMemberId`; TURNS goes round `leadRouteTurnIds` in order. Never
  /// a hand-added lead or an import. Member ids are plain text, not
  /// relations: a member who leaves, is suspended or cannot work leads is
  /// skipped, and with nobody left the lead falls back to the pool.
  /// Settings → Lead sources (owner and PM).
  leadRouteMode     LeadRouteMode @default(POOL)
  leadRouteMemberId String?
  leadRouteTurnIds  String[]      @default([])
  /// How many leads TURNS has handed out. Bumped atomically in the landing
  /// transaction (UPDATE … SET n = n + 1 RETURNING), so two leads landing in
  /// the same instant get different turns: the next person is
  /// `eligible[(n - 1) % eligible.length]`.
  leadRouteTurn     Int           @default(0)

  /// "Tell Meta which leads turned into customers" (owner, 22 Oct 2026;
  /// studio-intake/capi-rules.ts): off by default. When on, and the dataset
  /// and token are set for this studio in STUDIO_META_CAPI (env, never here),
  /// a Meta lead-ad lead moving into a chosen column sends one Conversions
  /// API event. `metaCapiStages` is { v: 1, stages: { [stageId]: event | null } };
  /// a column not named reads its default (WON → ConvertedLead, else none).
  metaCapiEnabled Boolean @default(false)
  metaCapiStages  Json?

  /// The owner's "Set up your studio" answers (modules/studio/setup-quiz.ts):
  /// { v, status: done | skipped, at, answers }. Null = never asked, so the
  /// owner sees the quiz on their first sign-in after the software opens.
  setupQuiz Json?

  /// The matching profile: work mix (modular / carpentry / both), scopes and
  /// minimums, civil capability, home types, city-wide and societies,
  /// capacity, earliest start, durations, how they work, materials,
  /// specialisms, languages, intro video, and the curated discount ops
  /// records from the studio agreement.
  ///
  /// One JSON column rather than thirty, because studios differ in shape —
  /// a carpenter-led studio has no factory and no hardware brands — and
  /// every field is optional until the studio says. Read and written only
  /// through `modules/studio/matching-profile.ts`, which drops anything it
  /// does not recognise. Null = not started.
  matchingProfile Json?

  /// The studio's band — ESSENTIAL | PREMIUM | LUXURY — as confirmed by ops
  /// from the proposal in `modules/studio/band.ts` (its rates on a reference
  /// home, checked against its finished homes). Never set by the studio.
  /// Null until confirmed; a customer who picks a band sees only studios
  /// confirmed in it.
  band            String?
  bandConfirmedAt DateTime?

  // ── Allocation ──
  //
  // What a subscription actually buys is VOLUME — how many briefs a studio is
  // shown for. It never buys POSITION: order within a customer's matches comes
  // from the matching engine and nothing else, which is why none of these
  // fields is readable by `score.ts` except `pausedAt`, and why there is no
  // "boost" or "priority" column here for anyone to reach for later.

  /// How many projects a month this studio says it can actually take on.
  /// Self-declared and used for allocation planning, never for ranking.
  capacityPerMonth Int?

  /// Set while a studio is out of rotation — at capacity, on holiday, unpaid,
  /// or under investigation. A paused studio fails the matching hard filters
  /// outright rather than ranking low: showing a customer a studio that cannot
  /// take the work wastes the one introduction we get.
  pausedAt     DateTime?
  /// Why. Required when pausing, and shown to the studio, because a studio that
  /// discovers it is invisible without being told is a studio that leaves.
  pausedReason String?
  /// What kind of pause. Distinguishes the ones that should lift by themselves —
  /// a capacity pause ends with the month, a payment pause ends when they pay —
  /// from a deliberate one that only a human should undo.
  pauseCause   PauseCause?

  /// Studio workspace Phases 2–5: the days this studio works, as ISO
  /// weekdays (1 = Monday … 7 = Sunday). Monday to Saturday until the owner
  /// decides (STUDIO-WORKSPACE-BUILD.md §8.4); configurable per studio. Read
  /// only through modules/project/working-days.ts `calendarOf`, which repairs
  /// a bad value rather than trusting it. Reminders, "no update today" and
  /// delays in working days all count on it, with `holidays`.
  workingDays Int[] @default([1, 2, 3, 4, 5, 6])

  // Derived performance — recomputed by a job, never written by hand.
  // Null until enough completed projects exist. Do NOT default these to
  // flattering values; the UI must render "not enough data".
  //
  // NOTHING WRITES THESE YET. The job named above does not exist, so every
  // studio sits at the defaults and the matching score and the verification
  // tier both read them as fact. That is safe in the sense that no studio is
  // flattered — a zero is a zero — but it means two ranked outputs are
  // currently ranking on a constant. Either the job gets written or the
  // inputs come out of the score; see docs/DATA-ARCHITECTURE.md §6.
  // `performanceComputedAt` was dropped in 20260923070000: a timestamp for a
  // computation that never runs is worse than no timestamp.
  completedProjects   Int    @default(0)
  avgVarianceDays     Float?
  upheldDisputes      Int    @default(0)
  specComplianceRate  Float?
  /// Mean past-client rating for communication, 1–5. Null until ~3 ratings.
  communicationRating Float?
  /// 0 = hands-off, 1 = highly collaborative. Drives the working-style match.
  autonomyProfile     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       StudioMember[]
  verifications VerificationCheck[]
  portfolio     PortfolioProject[]
  rateCard      RateCardItem[]
  matches       Match[]
  quotations    Quotation[]
  projects      Project[]
  subscription  Subscription?
  profileDraft  ProfileDraft?
  allocations   AllocationPeriod[]
  introductions Introduction[]

  /// First quotes generated against this studio, and the briefs it won.
  /// `wonQuoteDecisions` is named because a Studio reaches QuoteDecision
  /// twice — once through its quotes, once as the winner.
  firstQuotes       FirstQuote[]
  wonQuoteDecisions QuoteDecision[] @relation("FirstQuoteWinner")

  // The studio's own software. See the section at the foot of this file.
  branding           StudioBranding?
  products           StudioProduct[]
  productDrafts      StudioProductDraft[]
  productBackups     StudioProductBackup[]
  studioQuotes       StudioQuote[]
  studioClients      StudioClient[]
  studioClientEvents StudioClientEvent[]
  studioSavedViews   StudioSavedView[]
  studioForm         StudioForm?
  /// Lead intake (21 Oct 2026): Meta lead ads, Google lead forms, the
  /// studio's website and portals posting leads straight onto the board.
  studioLeadConnections StudioLeadConnection[]
  /// Meta Conversions API outbox (22 Oct 2026): one row per lead and event.
  conversionEvents   StudioConversionEvent[]
  studioStages       StudioStage[]
  studioFields       StudioField[]
  studioProjects     StudioProject[]
  studioVendors      StudioVendor[]
  studioWorkOrders   StudioWorkOrder[]
  /// Studio OS Phase 1: lead files, the studio's own source names, and the
  /// frozen copy of each quotation as it was sent.
  studioClientFiles  StudioClientFile[]
  studioLeadSources  StudioLeadSource[]
  quoteRevisions     StudioQuoteRevision[]
  /// Leads at scale (12 Oct 2026): calendar tasks.
  studioTasks        StudioTask[]
  /// Studio OS Phase 3: work orders for site crews on customer projects, and
  /// what was paid against them.
  homeWorkOrders     HomeWorkOrder[]
  homeCrewPayments   HomeCrewPayment[]

  /// Studio workspace Phase 2: the saved crew faces site mode taps, and the
  /// days off that are not reminder days.
  crew     StudioCrewMember[]
  holidays StudioHoliday[]

  /// Past quotations the studio sent us, for deriving their rate card.
  quotationArchives QuotationArchive[]
  documents         StudioDocument[]
  filedRates        StudioFiledRate[]

  @@index([city, status, tier])
  /// Every customer-facing query filters paused studios out.
  @@index([pausedAt])
  @@map("studios")
}

model StudioMember {
  id String @id @default(cuid())

  /// What this person has been shown, and what they have done.
  ///
  /// On the MEMBER and not on the Studio, deliberately. A second person
  /// joining an established studio has learned none of this, and showing them
  /// a finished walkthrough because a colleague completed it two months ago is
  /// how software gets a reputation for being impenetrable. Equally it is not
  /// in the browser: somebody who switches laptop should not be walked through
  /// it twice.
  ///
  /// Shape is `{ dismissed: string[], seen: string[] }` — see
  /// `modules/studio/guide.ts`. Deliberately loose JSON: guides are added and
  /// retired often, and a migration per tour step is a tax on improving them.
  guideState Json?
  /// Their own home, set from the profile menu (12 Oct 2026): which app tiles
  /// show and in what order, whether "Right now" shows, and where they land
  /// after signing in. `{ order, hidden, strip, landing }`, read through
  /// `modules/studio/home-prefs.ts`, which ignores anything not in their apps.
  /// Personal, never a permission: the door (`mayOpen`) still decides.
  homePrefs  Json?
  studioId   String
  studio     Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /// Unique: one person belongs to one studio (owner, 11 Oct 2026). The
  /// tenancy model rests on it — `myStudioId()` reads the studio off this row.
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept while code still reads it; derived from `role` (OWNER) from the
  /// studio workspace migration on. Expand → migrate → contract: it goes
  /// once nothing reads it. Never decide a permission on it — use `role`.
  isOwner    Boolean @default(false)

  /// What this person may do (modules/studio/roles.ts `can`). Defaults to
  /// OWNER because the only path that creates a member without saying —
  /// studio approval — creates the owner; an invite always names a role.
  role        StudioRole         @default(OWNER)
  /// INVITED until their first sign-in; SUSPENDED can do nothing at all.
  /// Phone and language are on `User` (`phone`, `locale`): one person, one
  /// account, whichever side they sign in from.
  status      StudioMemberStatus @default(ACTIVE)
  /// The member who added them. SetNull, so removing the inviter keeps the row.
  invitedById String?
  invitedBy   StudioMember?      @relation("StudioMemberInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees    StudioMember[]     @relation("StudioMemberInvites")
  invitedAt   DateTime?
  /// Last time they used the studio side; "last active" on Settings → Team.
  lastSeenAt  DateTime?

  createdAt DateTime @default(now())

  /// The customer projects this PM or supervisor is on (owners and accounts
  /// see across the studio without rows here).
  projects       StudioProjectMember[]
  /// Invites to the app this member sent their studio's own clients.
  projectInvites HomeProjectInvite[]   @relation("ProjectInvitesSent")

  /// Snags the PM gave this person to fix (Phase 4).
  assignedSnags HomeSnag[]

  /// Everything this person is working. See `StudioClient.assignedTo`.
  clients StudioClient[]

  /// What they have done. SetNull on removal, so a leaver's history stays.
  clientEvents StudioClientEvent[]

  /// Their own saved views. Cascade — see the model.
  savedViews StudioSavedView[]

  /// Studio OS Phase 1: files they attached to leads, quotation revisions
  /// they sent. SetNull on removal, so who did it stays as a name.
  clientFiles    StudioClientFile[]
  quoteRevisions StudioQuoteRevision[]

  /// Studio OS Phase 2: the projects they are the designer on.
  designing HomeProject[] @relation("ProjectDesigner")

  /// Leads at scale: calendar tasks given to them, and ones they wrote.
  tasksAssigned StudioTask[] @relation("TaskAssignee")
  tasksCreated  StudioTask[] @relation("TaskCreator")

  @@index([studioId])
  @@index([invitedById])
  @@map("studio_members")
}

/// The studio workspace roles (docs/studio-workspace/STUDIO-WORKSPACE-BUILD.md
/// §3). The table of who may do what is `modules/studio/roles.ts`, not here.
enum StudioRole {
  OWNER
  PM
  SUPERVISOR
  ACCOUNTS
  /// Studio OS Phase 1: a salesperson. Sees only the leads assigned to them,
  /// those leads' quotations and files; nothing of projects or payments.
  SALES
  /// Studio OS Phase 2: a designer. Works the design phase of the projects
  /// they are the designer on (HomeProject.designerId); sees no money.
  DESIGNER
}

/// A seat is a member who has signed in at least once and is not suspended.
enum StudioMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// Which project manager or site supervisor is on which customer project.
/// Owners and accounts need no row: they see across the studio by role. A
/// PM or supervisor without a row on a project cannot read it at all.
///
/// `homeProjectId`, not `projectId`, so it is never mistaken for the older
/// internal `StudioProject`.
model StudioProjectMember {
  id            String       @id @default(cuid())
  homeProjectId String
  homeProject   HomeProject  @relation(fields: [homeProjectId], references: [id], onDelete: Cascade)
  memberId      String
  member        StudioMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([homeProjectId, memberId])
  @@index([memberId])
  @@map("studio_project_members")
}

/// A face on the studio's crew list: the carpenter, the electrician, the
/// painter site mode lets a supervisor tap under "Who is on site?" (Phase 2).
/// Not a `StudioMember`: crew do not sign in. Only `name` (first name) and
/// `role` ever reach a customer, through `HomeSiteLogCrew`; `phone` never
/// crosses (STUDIO-WORKSPACE-BUILD.md §5). No wages or attendance here.
model StudioCrewMember {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name   String
  /// "Carpenter", "Electrician" — the studio's words.
  role   String
  /// For the studio to call them. Never selected by the customer projection.
  phone  String?
  /// A leaver is switched off, never deleted: their past days on site keep
  /// pointing at them.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  siteDays HomeSiteLogCrew[]

  @@index([studioId, active])
  @@map("studio_crew_members")
}

/// A day the studio does not work although it is one of its `workingDays`
/// (Diwali, a site-wide shutdown). No reminder goes out and a missing update
/// does not count against the studio. Read through working-days.ts.
model StudioHoliday {
  id       String   @id @default(cuid())
  studioId String
  studio   Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  /// The IST calendar day.
  day      DateTime @db.Date
  name     String?

  createdAt DateTime @default(now())

  @@unique([studioId, day])
  @@map("studio_holidays")
}

// Every verification item is a row with a source and a date, because the
// profile publishes "GST filings current as of 12 Aug 2026", not a badge.
enum CheckType {
  PAN_NAME_MATCH
  AADHAAR_KYC
  ADDRESS_VISIT
  CONTACT_REACHABLE
  CODE_OF_CONDUCT
  GSTIN_ACTIVE
  GST_FILING_HISTORY
  MCA_STATUS
  UDYAM
  CLIENT_REFERENCE
  SITE_INSPECTION
  LITIGATION_SEARCH
  // The landing page states fifteen mandatory checks. These are the last
  // three, and they gate the VERIFIED tier like the rest — see the note on
  // TIER_CHECKS in src/modules/studio/types.ts.
  RATE_CARD_FILED
  WARRANTY_TERMS
  LABOUR_INSURANCE
}

enum CheckResult {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
  EXPIRED
}

model VerificationCheck {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  type        CheckType
  result      CheckResult @default(PENDING)
  source      String? // "gst_portal" | "idfy" | "ops:manual" | "mca"
  evidenceUrl String? // private object storage key, never public
  notes       String?     @db.Text

  checkedById String?
  checkedAt   DateTime?
  expiresAt   DateTime? // Tier 2 re-audit every 6 months

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, type])
  @@index([studioId, result])
  @@map("verification_checks")
}

model PortfolioProject {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  title        String
  locality     String?
  propertyType PropertyType?
  scope        ScopeType?
  styleTags    String[]      @default([]) // must use the same vocabulary as Brief.styleLikes
  valuePaise   BigInt?
  durationDays Int?
  completedOn  DateTime?

  images          String[] @default([])
  isRender        Boolean  @default(false) // a render labelled as a render is fine; passing one off is not
  clientConsented Boolean  @default(false)

  /// Matching fields (modules/studio/portfolio-fields.ts). Carpet area turns
  /// the value into ₹/sq ft, which checks the studio's band against delivered
  /// work; society is "they have done a flat in your building"; tags are the
  /// evidence behind a specialism (two projects make it count).
  carpetAreaSqft Int?
  society        String?
  tags           String[] @default([])
  /// One room per image, aligned with `images` by index; '' = not said.
  imageRooms     String[] @default([])
  /// May these photos appear, without the studio's name, in a homeowner's
  /// style picker? Separate from clientConsented, which covers the studio's
  /// own page.
  pickerConsent  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("portfolio_projects")
}

model RateCardItem {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  category  String // "modular_kitchen" | "wardrobe" | "false_ceiling" | "painting" | "electrical"
  label     String
  unit      String // "sqft" | "rft" | "unit" | "lumpsum"
  ratePaise BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, category])
  @@map("rate_card_items")
