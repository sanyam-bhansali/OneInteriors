enum QuotationKind {
  INDICATIVE // generated from brief + rate card. Must render its assumptions.
  FIRM // studio-issued, binding within variance band
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

model Quotation {
  id       String @id @default(cuid())
  briefId  String
  brief    Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  kind   QuotationKind
  status QuotationStatus @default(DRAFT)

  subtotalPaise BigInt
  gstPaise      BigInt
  totalPaise    BigInt
  variancePct   Float? @default(15) // published band on indicative quotes

  assumptions String?   @db.Text
  validUntil  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems QuotationLineItem[]
  project   Project?

  @@index([briefId, studioId])
  @@map("quotations")
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  category    String
  description String
  unit        String
  quantity    Float
  ratePaise   BigInt
  amountPaise BigInt
  position    Int    @default(0)

  @@index([quotationId])
  @@map("quotation_line_items")
}

// ─────────────────────────────────────────────────────────────
// PROJECT + ESCROW — the actual product
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  CONTRACTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  DISPUTED
}

model Project {
  id          String     @id @default(cuid())
  briefId     String
  brief       Brief      @relation(fields: [briefId], references: [id], onDelete: Restrict)
  studioId    String
  studio      Studio     @relation(fields: [studioId], references: [id], onDelete: Restrict)
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  reference String        @unique // human-readable: "OI-PN-2026-0042"
  status    ProjectStatus @default(CONTRACTED)

  contractValuePaise BigInt
  /// Commission on a closed project, in basis points.
  ///
  /// 500 = 5.00%, matching `COMMISSION_BPS` in
  /// src/modules/studio/subscription.ts and every business document. This
  /// defaulted to 400 until a studio dashboard was about to render a take rate
  /// computed one way against an invoice computed the other — two sources of
  /// truth for the same rate, disagreeing silently.
  ///
  /// Stored per project rather than read from a constant because a studio's
  /// rate at the moment of signing must survive a later change to the pricing
  /// page. A row already written is never re-rated.
  commissionBps      Int    @default(500) // 5.00%
  commissionPaise    BigInt @default(0)
  escrowFeeBps       Int    @default(175) // 1.75% customer-side

  committedStartOn DateTime
  committedEndOn   DateTime // the date variance is measured against
  actualEndOn      DateTime?

  contractUrl      String?
  contractSignedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  escrow     EscrowTransaction[]
  disputes   Dispute[]

  @@index([studioId, status])
  @@index([status, committedEndOn])
  @@map("projects")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED // studio uploaded evidence, awaiting customer
  APPROVED // triggers escrow release
  REJECTED
}

model Milestone {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  position    Int
  title       String
  description String? @db.Text

  amountPaise BigInt
  status      MilestoneStatus @default(PENDING)

  dueOn           DateTime
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence MilestoneEvidence[]

  @@unique([projectId, position])
  @@index([projectId, status])
  @@map("milestones")
}

model MilestoneEvidence {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  kind         String // "photo" | "invoice" | "material_spec"
  storageKey   String
  caption      String?
  capturedAt   DateTime?
  uploadedById String

  createdAt DateTime @default(now())

  @@index([milestoneId])
  @@map("milestone_evidence")
}

enum EscrowDirection {
  DEPOSIT // customer -> escrow
  RELEASE // escrow -> studio
  REFUND // escrow -> customer
  FEE // escrow -> platform
}

enum EscrowStatus {
  INITIATED
  PENDING
  SETTLED
  FAILED
  REVERSED
}

// Append-only ledger. Corrections are new rows, never updates.
model EscrowTransaction {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestoneId String?

  direction   EscrowDirection
  status      EscrowStatus    @default(INITIATED)
  amountPaise BigInt

  providerRef     String? @unique // escrow partner's transaction id
  providerPayload Json?
  failureReason   String?

  initiatedAt DateTime  @default(now())
  settledAt   DateTime?

  @@index([projectId, direction])
  @@index([status])
  @@map("escrow_transactions")
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  UPHELD // against the studio — counts on their record
  DISMISSED
  WITHDRAWN
}

model Dispute {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  raisedByUserId String
  category       String // "delay" | "material_substitution" | "workmanship" | "billing"
  summary        String        @db.Text
  status         DisputeStatus @default(OPEN)

  resolution   String?   @db.Text
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("disputes")
}

// ─────────────────────────────────────────────────────────────
// BILLING + ALLOCATION
// ─────────────────────────────────────────────────────────────

/// Why a studio is out of rotation.
///
/// The three differ in who lifts them, which is the whole reason to record it:
/// AT_CAPACITY lifts itself when the month turns, PAYMENT_DUE lifts when the
/// invoice clears, and MANUAL only lifts when a person decides. Collapsing them
/// into one flag means either auto-resuming a studio somebody suspended, or
/// leaving a studio invisible for a month after they paid.
enum PauseCause {
  MANUAL
  AT_CAPACITY
  PAYMENT_DUE
}

/// Named for the customer-facing bands, because a studio that sits in the
/// Premium band and pays for a tier called "Verified" has two vocabularies to
/// hold in their head and will mix them up on a call with us.
///
/// Fees live in `src/modules/studio/subscription.ts`, not here — a price is a
/// commercial decision that changes, and a database enum is the wrong place to
/// find out what something costs.
enum SubscriptionTier {
  ESSENTIAL // ₹25k/mo
  PREMIUM // ₹50k/mo
  LUXURY // ₹1L/mo
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  tier   SubscriptionTier   @default(ESSENTIAL)
  status SubscriptionStatus @default(TRIAL)

  monthlyPaise BigInt @default(0)

  /// How many BRIEFS a tier guarantees per month. Not projects.
  ///
  /// The distinction is the whole promise. Whether a brief becomes a project is
  /// the customer's decision, and we do not get to guarantee other people's
  /// decisions — a studio told "sixteen projects" and given sixteen briefs has
  /// been mis-sold, and will say so.
  ///
  /// Renamed from `guaranteedProjects`, which promised exactly the thing the
  /// code comment in subscription.ts said we must never promise.
  guaranteedBriefs Int @default(0)

  startedOn   DateTime  @default(now())
  cancelledOn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}

// One row per studio per billing month. This is how the guarantee is tracked
// and how credit rollover is computed — never recalculated ad hoc.
model AllocationPeriod {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  guaranteed Int
  // "delivered" means SIGNED CONTRACTS, not leads. Contractual definition.
  delivered  Int @default(0)
  shortfall  Int @default(0)

  creditCarriedInPaise  BigInt @default(0)
  creditCarriedOutPaise BigInt @default(0)
  invoicedPaise         BigInt @default(0)

  closedAt DateTime?

  @@unique([studioId, periodStart])
  @@index([periodStart])
  @@map("allocation_periods")
}

// ─────────────────────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────────────────────

model Consultation {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// How to reach them. Collected at the request, because this is the first
  /// point in the flow where we genuinely need to call somebody back.
  contactName  String?
  contactPhone String?
  contactEmail String?

  /// The studios they want to talk about. Studio ids, in the order they
  /// picked them — the expert reads these before the call.
  studioIds      String[] @default([])
  /// What they want to get out of it, in their own words.
  askedAbout     String?  @db.Text
  /// Free text: "weekday evenings", "Saturday morning". A slot picker would
  /// hardcode a scheduling model before we know the shape of these calls.
  preferredTimes String?

  scheduledFor DateTime?
  expertUserId String?
  status       String    @default("requested") // requested | scheduled | completed | no_show | cancelled
  /// Booked from a real slot (plan §9) rather than requested with free text.
  /// No double booking: a partial unique index on (expertUserId,
  /// scheduledFor) WHERE status = 'scheduled', in raw SQL in the migration
  /// (Prisma cannot express a partial index), so a cancelled call frees its
  /// slot.
  durationMins Int       @default(30)
  bookedAt     DateTime?
  /// The private link to move or cancel a booked call (/call/<token>),
  /// usable without signing in — it is sent in the confirmation email.
  manageToken  String?   @unique

  // The expert's read is the training signal for the matching engine.
  outcomeNotes        String?  @db.Text
  recommendedStudioId String?
  matchWasCorrect     Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([briefId])
  @@map("consultations")
}

enum CustomerPlan {
  BASIC
  ASSURED
}

/// The customer's project tracker (Phase 7): one per introduction that became
/// a signed project. Stages and target dates come from modules/portal/tracker.ts;
/// a stage is done only when somebody marks it done. Started and updated by
/// ops (and by the studio, once its own tool is switched on); read by the
/// customer in "Your home". Not the escrow-era `Project` — this holds no money.
model HomeProject {
  id             String       @id @default(cuid())
  introductionId String       @unique
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)
  startOn        DateTime
  /// Sign-off to handover, in days — the studio's own for this work where known.
  totalDays      Int
  /// Stage keys marked done (TRACKER_STAGES).
  doneStages     String[]     @default([])

  /// Set when the customer signed the studio's final quote in the app (v79
  /// "Choose & sign"). Null on trackers ops started by hand before that.
  signedAt      DateTime?
  /// The StudioQuote they signed. Its issued lines are the locked price.
  signedQuoteId String?   @unique
  /// The locked total, GST included. The money the customer pays the studio
  /// directly; One Interiors only keeps track of it.
  contractPaise BigInt?
  /// The payment stages as signed, [{ label, pct, amountPaise }] — copied, so
  /// a later change to the studio's schedule never rewrites a signed one.
  paymentPhases Json?
  /// When each stage was paid, by index into paymentPhases: [{ index, paidOn }].
  /// Marked by the studio or ops; read by the customer's payment view.
  paidPhases    Json?

  /// The customer's plan (owner, 11 Oct 2026; docs/APP-API-JOURNEY.md).
  /// BASIC is free and the default. ASSURED (paid; fee set later) adds the
  /// daily tracker guarantee, GEIO and five expert calls. Only ops switches a
  /// project to ASSURED; the customer can only ask for it.
  plan               CustomerPlan @default(BASIC)
  /// When the customer asked for Assured, at signing or later from the app.
  /// The plan stays BASIC until ops confirms the fee and switches it. Expert
  /// calls used are counted from Consultation rows booked after `signedAt`,
  /// so there is no counter to drift.
  assuredRequestedAt DateTime?

  /// The studio's "Only your team" notes on the project workspace. Never
  /// crosses to the customer: the projection (portal/customer-project.ts)
  /// does not select it, and tests/customer-projection.test.ts checks.
  teamNotes String? @db.Text

  /// Studio OS Phase 1: the booking advance was refunded (within three days,
  /// or later by the owner). The project is kept, never deleted: its payment
  /// rows show the advance and its correction. A cancelled project is left out
  /// of the customer's app, the reminders and the studio's live lists.
  cancelledAt  DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates   HomeProjectUpdate[]
  decisions HomeDecision[]
  snags     HomeSnag[]
  documents HomeDocument[]
  family    FamilyMember[]

  /// Studio workspace Phase 1: who on the studio's team is on it, and the
  /// plan built from the signed quote (modules/studio/quote-to-plan.ts).
  team      StudioProjectMember[]
  stages    HomeProjectStage[]
  materials HomeMaterial[]

  /// Studio workspace Phases 2–5 (docs/studio-workspace/PHASES-2-5-
  /// FOUNDATION.md): the site log, moved dates, payments received, quote
  /// changes from decisions, and the append-only event log under them all.
  siteLogs     HomeSiteLog[]
  dateChanges  HomeProjectDateChange[]
  payments     HomeProjectPayment[]
  quoteChanges HomeQuoteChange[]
  events       HomeProjectEvent[]

  /// A studio's own client: the invites to follow it in the app
  /// (project/own-project.ts).
  invites HomeProjectInvite[]

  /// Studio OS Phase 2 — design (docs/studio-os/PHASE-2-DESIGN.md). The
  /// designer (also on the team, so access.ts lets them in), the mood board
  /// shared with its message to the client, the design final and when design
  /// closed, with a frozen "what changed vs the sales final" for the client.
  designerId         String?
  designer           StudioMember? @relation("ProjectDesigner", fields: [designerId], references: [id], onDelete: SetNull)
  moodBoardSharedAt  DateTime?
  moodBoardNote      String?
  designFinalQuoteId String?
  designClosedAt     DateTime?
  designChanges      Json?
  siteVisits         HomeSiteVisit[]
  measurements       HomeMeasurement[]
  designReviews      HomeDesignReview[]
  stepDelays         HomeStepDelay[]

  /// Studio OS Phase 3: the site crews' work orders. Internal: never in any
  /// customer projection.
  workOrders HomeWorkOrder[]

  /// The project lifecycle (owner, 13 Oct 2026; docs/studio-os/PROJECT-
  /// LIFECYCLE.md). Moved only through project/lifecycle-rules.ts, inside
  /// the transaction that records the event: design sign-off
  /// (designClosedAt) -> EXECUTION; the provisional handover step ticked ->
  /// CLOSURE; the closure fixed -> SNAGS; the client signs off the handover
  /// with no open snag -> WARRANTY; past warrantyEndsOn it reads as CLOSED.
  phase                 ProjectPhase @default(DESIGN)
  phaseAt               DateTime?
  provisionalHandoverAt DateTime?
  closedOutAt           DateTime?
  handoverSignedAt      DateTime?
  /// The customer (User id) who signed off. Never sent to anyone.
  handoverSignedById    String?
  warrantyEndsOn        DateTime?    @db.Date
  closures              HomeProjectClosure[]

  /// Extra work after design sign-off (change orders) and the client's
  /// digital sign-offs of quotations (owner, 15 Oct 2026;
  /// project/change-orders.ts, project/signoffs.ts).
  changeOrders HomeChangeOrder[]
  signoffs     HomeQuoteSignoff[]

  /// Brought onto One Interiors while already running ("Add an existing
  /// project", owner 20 Oct 2026; docs/studio-os/BRING-IN-PROJECTS.md): when,
  /// and the source quotation's number in the studio's old quotation app
  /// (null when the quotation was built in our builder).
  broughtInAt   DateTime?
  broughtInFrom String?

  @@map("home_projects")
}

/// Where a project is in its life (owner, 13 Oct 2026). CLOSED is also
/// read, not only stored: a WARRANTY project past warrantyEndsOn is closed.
enum ProjectPhase {
  DESIGN
  EXECUTION
  CLOSURE
  SNAGS
  WARRANTY
  CLOSED
}

/// The project closure (owner, 13 Oct 2026): the detailed final account.
/// Append-only (project/append-only.ts): every save is a new version; the
/// row with `final` set fixes the final payment and is never followed by
/// another. Money in integer paise; GST as the quotation charges it (last,
/// at the quotation's rate, on the net extra work).
model HomeProjectClosure {
  id              String      @id @default(cuid())
  projectId       String
  project         HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int
  /// The contract the closure starts from: the design final's total, else the signed total (GST included).
  contractPaise   BigInt
  /// Changes agreed on the client's decisions (HomeQuoteChange), GST included.
  changesPaise    BigInt      @default(0)
  /// Approved change orders (extra work after sign-off), GST included; read
  /// from the change orders, never typed on the closure.
  changeOrdersPaise BigInt    @default(0)
  extrasPaise     BigInt      @default(0)
  deductionsPaise BigInt      @default(0)
  gstBps          Int         @default(0)
  gstPaise        BigInt      @default(0)
  totalPaise      BigInt
  /// Payments recorded and counted when this version was saved.
  paidPaise       BigInt
  finalDuePaise   BigInt
  note            String?     @db.Text
  /// Set on the version that closed the project out (fixes the final payment).
  final           Boolean     @default(false)
  createdById     String?
  createdAt       DateTime    @default(now())
  lines           HomeProjectClosureLine[]

  @@unique([projectId, version])
  @@index([projectId, final])
  @@map("home_project_closures")
}

/// A line of a closure version: extra work done for the client, or a
/// deduction / credit. Append-only with its version.
model HomeProjectClosureLine {
  id          String             @id @default(cuid())
  closureId   String
  closure     HomeProjectClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  /// "EXTRA" | "DEDUCTION".
  kind        String
  description String
  /// Quantity in thousandths (1.5 = 1500); null with a lump amount.
  qtyMilli    Int?
  ratePaise   BigInt?
  /// Before GST, always positive; the kind says which way it goes.
  amountPaise BigInt
  note        String?
  sortOrder   Int                @default(0)

  @@index([closureId])
  @@map("home_project_closure_lines")
}

/// Extra work after design sign-off: a change order (owner, 15 Oct 2026;
/// project/change-orders.ts). DRAFT -> SENT_TO_CLIENT -> APPROVED | DECLINED
/// -> PAID -> RELEASED (to the factory / the work); a draft or a sent one can
/// be CANCELLED by the studio. `status` is the current state; every move is a
/// row in HomeChangeOrderEvent (append-only). Money in integer paise, priced
/// the quotation's way (its modular discount and GST) and never changing the
/// signed lines: approving writes one HomeQuoteChange on the final stage.
model HomeChangeOrder {
  id            String            @id @default(cuid())
  projectId     String
  project       HomeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… per project: "Extra work 3".
  number        Int
  title         String
  /// Why it is needed, in the studio's words to the client. Crosses to the client.
  reason        String?           @db.Text
  status        ChangeOrderStatus @default(DRAFT)
  /// The quotation it is priced from (design final, else the signed one).
  quoteId       String?
  /// Basis points copied from that quotation when the order is priced.
  discountBps   Int               @default(0)
  gstBps        Int               @default(0)
  workPaise     BigInt            @default(0)
  discountPaise BigInt            @default(0)
  gstPaise      BigInt            @default(0)
  /// What the client pays, GST included.
  totalPaise    BigInt            @default(0)
  /// An optional photo or drawing, filed in the locker (shared when sent).
  photoDocumentId String?
  createdById   String
  sentAt        DateTime?
  /// The client's answer (the owner of the brief).
  decidedAt     DateTime?
  decidedById   String?
  /// The client's reason for declining. Crosses back to the client.
  declineReason String?
  paidAt        DateTime?
  releasedAt    DateTime?
  releasedById  String?
  cancelledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  lines        HomeChangeOrderLine[]
  events       HomeChangeOrderEvent[]
  payments     HomeProjectPayment[]
  quoteChanges HomeQuoteChange[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("home_change_orders")
}

enum ChangeOrderStatus {
  DRAFT
  SENT_TO_CLIENT
  APPROVED
  DECLINED
  PAID
  RELEASED
  CANCELLED
}

/// One line of a change order: from the product master (sized like the
/// quotation builder: W x H, sq ft, rft or each, at the studio's rate) or a
/// custom line with an amount. Before discount and GST. Replaced only while
/// the order is a draft.
model HomeChangeOrderLine {
  id            String          @id @default(cuid())
  changeOrderId String
  changeOrder   HomeChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  /// The product it came from; null for a custom line. A snapshot either way.
  productId     String?
  room          String?
  product       String
  details       String?         @db.Text
  code          StudioWorkCode
  unit          QuoteUnit
  widthMm       Int?
  heightMm      Int?
  /// Thousandths.
  qtyMilli      Int?
  ratePaise     BigInt          @default(0)
  amountPaise   BigInt
  sortOrder     Int             @default(0)

  @@index([changeOrderId])
  @@map("home_change_order_lines")
}

/// Every status move of a change order, append-only (project/append-only.ts).
model HomeChangeOrderEvent {
  id            String             @id @default(cuid())
  changeOrderId String
  changeOrder   HomeChangeOrder    @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  fromStatus    ChangeOrderStatus?
  toStatus      ChangeOrderStatus
  actorType     ProjectActorType
  actorId       String?
  /// The decline reason or the studio's line; never internal.
  text          String?
  at            DateTime           @default(now())

  @@index([changeOrderId, at])
  @@map("home_change_order_events")
}

/// The client's digital sign-off of a quotation revision (owner, 15 Oct
/// 2026; project/signoffs.ts): the sales final (BOQ) or the design final.
/// The studio asks; the client reads the revision, ticks "I have read and
/// agree", types their full name and submits. Who, when, IP and user agent,
/// and a SHA-256 of exactly the revision they signed. Filled once when
/// signed, never deleted (project/append-only.ts). A newer revision needs a
/// new sign-off; this one stays on its revision.
model HomeQuoteSignoff {
  id               String              @id @default(cuid())
  projectId        String
  project          HomeProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// "SALES_FINAL" | "DESIGN_FINAL".
  kind             String
  quoteId          String
  revisionId       String
  revision         StudioQuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  quoteNumber      String
  revisionN        Int
  totalPaise       BigInt
  /// SHA-256 (hex) of the revision's stored content when the sign-off was asked.
  contentHash      String
  requestedById    String
  requestedAt      DateTime            @default(now())
  withdrawnAt      DateTime?
  signedAt         DateTime?
  /// The customer (User id) who signed. Never sent to anyone.
  signedById       String?
  /// The full name they typed as their signature.
  signerName       String?
  /// The exact sentence they ticked.
  agreedText       String?
  /// The hash of what they were shown when they signed (equals contentHash).
  signedHash       String?
  ip               String?
  userAgent        String?
  /// The locker record of the signed copy.
  lockerDocumentId String?

  @@index([projectId, requestedAt])
  @@index([revisionId])
  @@map("home_quote_signoffs")
}

/// The invite a studio sends its OWN client to follow their project in the
/// app (docs/studio-workspace/OWN-CLIENTS.md). The customer's account is
/// found or made by phone and linked when the project starts, so signing in
/// with that number is enough; the code only makes the link short and says
/// whether they have joined. Not a credential: the join page still needs a
/// sign-in with the invited number, so the code is stored as is (like
/// `FamilyMember.inviteToken`) and the studio can show it again.
/// Customers never get WhatsApp: SMS when a provider exists, email when the
/// client has one, otherwise the studio shares the link itself.
model HomeProjectInvite {
  id          String        @id @default(cuid())
  projectId   String
  project     HomeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Short, unambiguous, upper case: what goes in /app/join/<code>.
  code        String        @unique
  /// The customer's account (role CUSTOMER), found or made by phone.
  userId      String
  /// E.164, as invited. Matched against the number they sign in with.
  phone       String
  name        String
  email       String?
  createdById String?
  createdBy   StudioMember? @relation("ProjectInvitesSent", fields: [createdById], references: [id], onDelete: SetNull)
  /// Channels that took it: 'sms', 'email'. Empty = the studio shares the link.
  sentVia     String[]      @default([])
  /// When they opened the link signed in with the invited number.
  joinedAt    DateTime?
  /// A newer invite replaced this one.
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([createdById])
  @@map("home_project_invites")
}

/// What a stage is, whatever the studio calls it. Named so it does not clash
/// with the internal tracker's `ProjectStage` or the pipeline's `StageKind`.
enum ProjectStageKind {
  DESIGN
  CIVIL
  CARPENTRY
  FINISH
  HANDOVER
}

/// How a step was ticked: a tap, or confirmed from a voice note — either way
/// with its photo since the step tracker (docs/studio-workspace/STEP-TRACKER.md)
/// — or BACKFILL: ticked by scripts/studio/steps-from-template.ts because its
/// stage was already done, with no photo — or BEFORE_JOINING: done before the
/// project was brought onto One Interiors ("Add an existing project",
/// docs/studio-os/BRING-IN-PROJECTS.md), with no photo.
enum ChecklistDoneSource {
  TICK
  VOICE
  BACKFILL
  BEFORE_JOINING
}

/// A stage of a customer's project, built from the signed quote. The studio
/// owns `name` and the dates; we own `kind`, and every query reads the kind,
/// never the name (same rule as `StudioStage`). Replaces the fixed
/// `HomeProject.doneStages` keys: a stage is done when its items are.
model HomeProjectStage {
  id        String           @id @default(cuid())
  projectId String
  project   HomeProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      ProjectStageKind
  name      String
  sortOrder Int              @default(0)

  plannedStart DateTime
  plannedEnd   DateTime
  /// Set when the stage is complete. Null = not finished.
  actualEnd    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items HomeChecklistItem[]

  /// Site logs posted while this was the current stage (Phase 3: a stage
  /// shows done to the customer only with at least one photo from it), and
  /// every move of its dates.
  siteLogs    HomeSiteLog[]
  dateChanges HomeProjectDateChange[]

  @@index([projectId, sortOrder])
  @@map("home_project_stages")
}

/// One step of a stage (docs/studio-workspace/STEP-TRACKER.md): Hauspire's
/// execution steps with their weights (project/step-template.ts), which the
/// studio may rename, re-weight, add to, remove or mark not in scope.
/// `doneAt` null means open. Ticking needs a photo with a sentence, which
/// lands in that day's site log (`donePhotoId`). Older rows were generated
/// from the signed quote's lines, one per room (quoteLineId set).
model HomeChecklistItem {
  id      String           @id @default(cuid())
  stageId String
  stage   HomeProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /// The step's group inside its stage ("Execution stage 2A"); a room on
  /// the older quote-line items.
  room        String
  label       String
  /// The step's weight in basis points (10 000 = 100% of the project). What
  /// counts is the effective weight: in-scope weights shared so they sum to
  /// 100% (project/step-rules.ts). Never sent to the customer as stored.
  weightBp    Int       @default(0)
  /// False = not in scope for this home: hidden from the customer, its
  /// weight shared across the in-scope steps, never needed to finish a stage.
  inScope     Boolean   @default(true)
  /// The planned day, spread across the stage's window from the template's
  /// sheet days; moves with the stage.
  plannedOn   DateTime? @db.Date
  /// The signed quote line it came from. A snapshot reference, not a key:
  /// quote lines are copied at signing and may be edited or deleted later.
  quoteLineId String?
  sortOrder   Int     @default(0)

  doneAt        DateTime?
  /// The user who ticked it (studio member or ops). Not a foreign key, as
  /// with `postedById` on updates: a leaver's ticks stay.
  doneById      String?
  doneSource    ChecklistDoneSource?
  /// The day's site log it was ticked in (Phase 2 "What got done today?"),
  /// so the customer's feed can say what got done that day. Null for a tick
  /// made outside a post (office, or before Phase 2).
  doneSiteLogId String?
  doneSiteLog   HomeSiteLog?         @relation(fields: [doneSiteLogId], references: [id], onDelete: SetNull)
  /// The site-log photo that ticked it ("Done: {step}" in the customer's
  /// feed). Null for an untick, a backfill or an older tick. Unticking
  /// clears it; the photo stays in the log (append-only).
  donePhotoId   String?              @unique
  donePhoto     HomeSiteLogPhoto?    @relation("ChecklistDonePhoto", fields: [donePhotoId], references: [id], onDelete: SetNull)

  /// Studio OS Phase 2, design steps (modules/studio-design/template.ts):
  /// who does it (DESIGNER | SALES | ACCOUNTS | PM | CLIENT), whether ticking
  /// needs a file (filed in the locker, doneDocumentId), the payment stage
  /// (index into paymentPhases) that must be recorded before it opens, and
  /// its days after the previous step. doneNote is the team's sentence: it
  /// never crosses to the customer.
  responsible    String?
  needsDocument  Boolean @default(false)
  gatePayment    Int?
  gapDays        Int?
  doneNote       String? @db.Text
  doneDocumentId String?
  delays         HomeStepDelay[]

  /// A starred step (owner, 12 Oct 2026; docs/studio-os/CUSTOMER-MILESTONES.md):
  /// one of the stage's 2–3 milestones the customer sees. Every other step
  /// is the studio's own; percentages still count every step.
  customerMilestone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, sortOrder])
  @@index([doneSiteLogId])
  @@map("home_checklist_items")
}

/// The materials list of a signed project, copied from the quote at signing
/// so editing the product master never changes a running project. The
/// studio adds `productCode` when it orders.
model HomeMaterial {
  id        String      @id @default(cuid())
  projectId String
  project   HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  room        String
  item        String
  spec        String?
  quoteLineId String?
  productCode String?
  /// When the studio ordered it (Phase 5 locker: product codes are added
  /// when ordered). Null = not ordered yet.
  orderedAt   DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@map("home_materials")
}

/// A choice the customer has to make by a date (the app's "Decision with a
/// deadline"): posted by the studio or ops, made by the customer.
model HomeDecision {
  id        String      @id @default(cuid())
  projectId String
  project   HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title String
  /// What waiting costs, in the studio's words: "Shutters are cut next week…".
  /// This is the brief's `lateImpact` ("if she decides late"), customer-visible.
  why   String   @db.Text
  /// The last moment to decide: 23:59:59 IST on the due day (decisions.ts
  /// `endOfIstDay`). This is the brief's `dueAt`. Status is derived, never
  /// stored: picked when `pickedOptionId`/`chosenIndex` is set, expired once
  /// past `dueOn` unpicked, else open (decisions.ts `decisionState`).
  dueOn DateTime

  /// [{ name, note, extraPaise (0 = in the quote), swatch? }]. Validated by
  /// modules/portal/decisions.ts on the way in; never trusted on the way out.
  /// Phase 5 moves the options to `choices` (HomeDecisionOption), which can
  /// hold the studio's cost safely; this JSON is backfilled into it by the
  /// Phases 2–5 migration and keeps being written (without any studio cost)
  /// until the customer app reads `choices`.
  options Json

  /// Index into `options`, once chosen. Written alongside `pickedOptionId`
  /// until every reader moves.
  chosenIndex Int?
  chosenAt    DateTime?
  chosenById  String?

  /// The option the customer picked, as a row (Phase 5). Backfilled from
  /// `chosenIndex`.
  pickedOptionId String?
  pickedOption   HomeDecisionOption? @relation("HomeDecisionPicked", fields: [pickedOptionId], references: [id], onDelete: SetNull)
  /// The signed quote line this decision changes, when it changes one. A
  /// snapshot reference, like `HomeChecklistItem.quoteLineId`.
  quoteLineId    String?

  postedById String
  byStudio   Boolean   @default(false)
  /// Set when the 2-days-left reminder went out, so it goes out once.
  remindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes        DecisionVote[]
  /// The options as rows (Phase 5). Named `choices` because `options` is
  /// the older JSON column.
  choices      HomeDecisionOption[]    @relation("HomeDecisionChoices")
  quoteChanges HomeQuoteChange[]
  /// Moved dates blamed on this decision being late (customer delay).
  dateChanges  HomeProjectDateChange[]

  @@index([projectId, dueOn])
  @@index([pickedOptionId])
  @@map("home_decisions")
}

/// One option on a decision (Phase 5): what the customer sees — label,
/// detail, photo, and the price difference GST included — and, kept back,
/// what it costs the studio. A table rather than the JSON because the
/// customer projection selects columns: `studioCostDeltaPaise` is simply
/// never selected (tests/customer-projection.test.ts), where a JSON column
/// would carry it out whole.
model HomeDecisionOption {
  id         String       @id @default(cuid())
  decisionId String
  decision   HomeDecision @relation("HomeDecisionChoices", fields: [decisionId], references: [id], onDelete: Cascade)
  sortOrder  Int          @default(0)

  label                String
  detail               String?
  /// Private storage key in `site-photos`; served only as a signed link.
  photoPath            String?
  /// "#rrggbb" when the option is a finish (the JSON's `swatch`).
  swatch               String?
  /// What picking it adds to (or, negative, takes off) the price, in paise,
  /// GST included. Customer-visible. 0 = as quoted.
  deltaPaise           BigInt  @default(0)
  /// What it changes in the studio's own cost. NEVER crosses to the customer.
  studioCostDeltaPaise BigInt?

  createdAt DateTime @default(now())

  pickedBy     HomeDecision[]    @relation("HomeDecisionPicked")
  votes        DecisionVote[]
  quoteChanges HomeQuoteChange[]

  @@index([decisionId, sortOrder])
  @@map("home_decision_options")
}

/// v79 engagement (9 Oct 2026). Home Coins: one row per thing that earned
/// coins. 1 coin = ₹1 with partner brands; never spendable on the studio's
/// bill and never cashed out (owner's rules). Each thing earns once: the
/// unique (userId, kind, ref) is what makes every award idempotent.
model CoinEntry {
  id        String   @id @default(cuid())
  userId    String
  /// QUIZ, SIGNED, DAILY_UPDATE, STREAK_7, DECISION_ON_TIME, SNAG_PHOTO,
  /// CHALLENGE, SHARE_MILESTONE, FAMILY_JOINED, REFERRAL_SIGNED, SOCIETY_CIRCLE.
  kind      String
  coins     Int
  /// What earned it: "decision:<id>", "day:2026-10-09", "society:<key>".
  ref       String
  note      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, ref])
  @@index([userId, createdAt])
  @@map("coin_entries")
}

/// Family on a project: invited by the owner on WhatsApp, joined by signing
/// in with the invited number. Family see the project and vote on
/// decisions; only the owner decides and approves payments.
model FamilyMember {
  id          String      @id @default(cuid())
  projectId   String
  project     HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  name        String
  relation    String?
  /// Normalised "+91…", matched against the number they sign in with.
  phone       String
  inviteToken String      @unique
  /// Their account, once joined.
  userId      String?
  joinedAt    DateTime?
  removedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@unique([projectId, phone])
  @@index([userId])
  @@map("family_members")
}

/// A family vote on a decision. Advice to the owner, who still chooses.
model DecisionVote {
  id          String              @id @default(cuid())
  decisionId  String
  decision    HomeDecision        @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId      String
  optionIndex Int
  /// The option as a row (Phase 5), backfilled from `optionIndex`; both are
  /// written until every reader moves.
  optionId    String?
  option      HomeDecisionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([decisionId, userId])
  @@index([optionId])
  @@map("decision_votes")
}

/// Dream board: photos a customer saves, which their studio can see.
model DreamPin {
  id        String    @id @default(cuid())
  userId    String
  /// Private storage key in site-photos (dream/<userId>/…).
  photoPath String
  note      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, createdAt])
  @@map("dream_pins")
}

/// "Spot the mistake": one real site photo a week, set by ops, with where
/// the mistake is (as fractions of the photo) and what it teaches.
model WeeklyChallenge {
  id          String   @id @default(cuid())
  /// Monday of the week it runs, IST.
  weekOf      DateTime @unique
  photoPath   String
  x           Float
  y           Float
  radius      Float
  answer      String
  explain     String   @db.Text
  createdById String
  createdAt   DateTime @default(now())

  answers ChallengeAnswer[]

  @@map("weekly_challenges")
}

model ChallengeAnswer {
  id          String          @id @default(cuid())
  challengeId String
  challenge   WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  correct     Boolean
  createdAt   DateTime        @default(now())

  @@unique([challengeId, userId])
  @@map("challenge_answers")
}

/// Something wrong on site, to be fixed by a date (the app's "Snags").
/// Raised by the customer or at the handover walk-through; closed by the studio.
model HomeSnag {
  id        String      @id @default(cuid())
  projectId String
  project   HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title      String
  room       String?
  note       String?  @db.Text
  /// Paths in the private `site-photos` bucket, served only as signed links.
  photoPaths String[] @default([])

  raisedById      String
  /// The brief's `raisedBy`: true = STUDIO (incl. the handover walk-through),
  /// false = CUSTOMER.
  raisedByStudio  Boolean   @default(false)
  /// The current fix-by date; each change is also an ACCEPTED event.
  fixBy           DateTime?
  /// "OPEN" | "FIXED". LEGACY: from Phase 4 the status is DERIVED from
  /// `events` (snag-status.ts). This column is still written alongside —
  /// "FIXED" for fixed, confirmed or auto-closed, "OPEN" otherwise — so the
  /// app and the existing readers keep working. Never decide on it in new
  /// code; never write any other value into it.
  status          String    @default("OPEN")
  fixedAt         DateTime?
  fixedNote       String?   @db.Text
  fixedPhotoPaths String[]  @default([])

  /// Who on the studio's team is to fix it (Phase 4, set on accept). Never
  /// crosses to the customer ("who on the crew caused it" stays inside).
  assigneeId String?
  assignee   StudioMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Raised by the client during the warranty (owner, 13 Oct 2026): a
  /// warranty snag in the designer's My Snags.
  warranty Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Append-only history; the status is computed from it.
  events HomeSnagEvent[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@map("home_snags")
}

/// What happened to a snag, in order (Phase 4). Append-only: never updated
/// or deleted in code (tests/append-only.test.ts). The snag's status is
/// derived from these, including the 7-day auto-close (owner, 11 Oct 2026).
enum SnagEventKind {
  RAISED
  ACCEPTED
  DISPUTED
  FIXED
  CONFIRMED
  REOPENED
  AUTO_CLOSED
}

/// Who did something on a customer's project.
enum ProjectActorType {
  CUSTOMER
  STUDIO
  OPS
  SYSTEM
}

model HomeSnagEvent {
  id     String        @id @default(cuid())
  snagId String
  snag   HomeSnag      @relation(fields: [snagId], references: [id], onDelete: Cascade)
  kind   SnagEventKind

  /// Before photos on RAISED/REOPENED, after photos on FIXED: keys in the
  /// private `site-photos` bucket, signed links only. (An array, not the
  /// brief's single path: a snag already carries up to four.)
  photoPaths     String[]  @default([])
  /// The "Say what you fixed" recording and what it said. NEVER cross.
  voicePath      String?
  transcript     String?   @db.Text
  transcriptLang String?
  /// The one sentence the customer reads (the written fix sentence).
  customerText   String?   @db.Text
  customerLang   String?
  /// Customer-visible words: the customer's "not fixed" reason, the
  /// studio's dispute reason.
  note           String?   @db.Text
  /// The PM's "only your team" note to the fixer. NEVER crosses.
  internalNote   String?   @db.Text
  /// ACCEPTED: the fix-by date and the assignee given at that moment.
  fixBy          DateTime?
  assigneeId     String?

  actorType ProjectActorType
  /// The user who did it; null for SYSTEM (auto-close) and backfilled rows.
  byId      String?
  at        DateTime         @default(now())

  @@index([snagId, at])
  @@map("home_snag_events")
}

/// A document on a customer's project — the agreement, the signed quote,
/// drawings, receipts, warranties — uploaded by the studio or ops, read by the
/// customer in the app's Locker. Stored in the private `project-docs` bucket.
model HomeDocument {
  id        String      @id @default(cuid())
  projectId String
  project   HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// AGREEMENT | QUOTATION | DRAWINGS | RECEIPT | WARRANTY | OTHER
  kind         String
  title        String
  storageKey   String
  originalName String
  contentType  String
  bytes        Int

  uploadedById String
  byStudio     Boolean @default(false)

  /// When the customer could first see it. Null = a draft or an internal
  /// drawing, which stays with the studio; the customer projection reads
  /// only shared documents. Rows from before this column were all visible,
  /// so the migration set them to `createdAt`.
  sharedAt     DateTime?
  /// 1 for a first upload; a new drawing revision is `version + 1` with
  /// `supersedesId` pointing at the one it replaces. A shared document is
  /// superseded, never edited.
  version      Int            @default(1)
  supersedesId String?
  supersedes   HomeDocument?  @relation("HomeDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy HomeDocument[] @relation("HomeDocumentVersions")

  /// Payments this document is the receipt for (Phase 5).
  receiptFor HomeProjectPayment[]

  /// Studio OS Phase 2: a design drawing (LAYOUT_2D | FURNITURE | RENDER_3D |
  /// WORKING | SITE_PHOTO) and the room it is for; the client's answers.
  designKind String?
  room       String?
  reviews    HomeDesignReview[]

  createdAt DateTime  @default(now())
  /// Soft delete: a removed document stops showing and stays for the record.
  deletedAt DateTime?

  @@index([projectId, createdAt])
  @@index([supersedesId])
  @@map("home_documents")
}

/// A phone signed in to the app. The Expo push token is what a push is sent
/// to; a token the push service reports as gone is deleted.
model PushDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique
  /// "ios" | "android"
  platform String

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("push_devices")
}

/// A dated note on the project — "Kitchen carcasses delivered to site".
///
/// LEGACY from Phase 2: the daily site log is `HomeSiteLog`. Rows here are
/// not migrated (several a day, free text, no reason or crew: they do not
/// fit one-post-per-day), and the customer projection keeps showing them
/// beside the site log until they age out of the feed. New studio posts go
/// to `HomeSiteLog`; ops' notes may keep landing here until ops has a
/// site-log path.
model HomeProjectUpdate {
  id         String      @id @default(cuid())
  projectId  String
  project    HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The stage it belongs to, if any.
  stage      String?
  note       String      @db.Text
  postedById String
  /// Posted by the studio doing the work, not by us (queue item 22).
  byStudio   Boolean     @default(false)
  /// Site photographs: paths in the private `site-photos` bucket, served
  /// only through short-lived signed links (storage/site-photos.ts).
  photoPaths String[]    @default([])

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("home_project_updates")
}

// ── Studio workspace Phases 2–5 ────────────────────────────────
//
// docs/studio-workspace/PHASES-2-5-FOUNDATION.md. Everything hangs off the
// customer's `HomeProject`, never `StudioProject`. Append-only tables
// (HomeSiteLog, HomeProjectDateChange, HomeSnagEvent, HomeQuoteChange,
// HomeProjectEvent) have no update or delete path in code —
// tests/append-only.test.ts greps for one. Corrections are new rows.

/// What a day's site log says.
enum SiteLogKind {
  /// Work happened: photos, crew, ticks.
  UPDATE
  /// Nobody on site today, with a reason.
  NOBODY
  /// A correction to an earlier UPDATE/NOBODY, shown beside it.
  CORRECTION
}

/// Why nobody was on site. WAITING_CUSTOMER_DECISION and CUSTOMER_ASKED do
/// not count against the studio (brief, Phase 2).
enum NobodyReason {
  WAITING_MATERIAL
  WAITING_CUSTOMER_DECISION
  CREW_ELSEWHERE
  HOLIDAY
  CUSTOMER_ASKED
  OTHER
}

/// One day on one site (Phase 2): the supervisor's post, or "nobody on
/// site". At most one UPDATE/NOBODY per project per IST day — a partial
/// unique index in the migration (Prisma cannot express one); any number of
/// CORRECTIONs, each pointing at what it corrects. Append-only.
model HomeSiteLog {
  id        String        @id @default(cuid())
  projectId String
  project   HomeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// The IST calendar day the post is for (working-days.ts `istDay`).
  date      DateTime      @db.Date
  kind      SiteLogKind
  /// NOBODY only.
  reason    NobodyReason?
  /// The supervisor's own words, typed. Internal: NEVER crosses. What the
  /// customer reads is always `customerText`, previewed before posting.
  note      String?       @db.Text

  /// The "Say something else" mic, for what is not in a photo: the
  /// recording and transcript stay inside; `customerText` is the sentence
  /// the customer reads, in `customerLang`.
  voicePath      String?
  transcript     String? @db.Text
  transcriptLang String?
  customerText   String? @db.Text
  customerLang   String?

  /// The stage the project was in when posted (Phase 3 needs a photo
  /// during a stage before it shows done).
  stageId String?
  stage   HomeProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  /// The user who posted (not a key, like `postedById` on updates).
  postedById String
  /// When the supervisor pressed Post on the phone — kept from an offline
  /// post, so a late upload is not a late update.
  postedAt   DateTime
  /// When it reached us.
  createdAt  DateTime @default(now())
  /// The phone's id for this post, so an offline queue that sends twice
  /// lands once.
  clientRef  String?  @unique

  correctsId  String?
  corrects    HomeSiteLog?  @relation("HomeSiteLogCorrections", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections HomeSiteLog[] @relation("HomeSiteLogCorrections")

  photos HomeSiteLogPhoto[]
  crew   HomeSiteLogCrew[]
  /// Checklist items ticked in this post.
  ticked HomeChecklistItem[]

  @@index([projectId, date])
  @@index([stageId])
  @@index([correctsId])
  @@map("home_site_logs")
}

/// One photo in a day's post, with its own mic. The customer sees the photo
/// and `customerText`; `voicePath` and `transcript` stay with the studio and
/// us so a sentence can be checked against what was said. sortOrder 0 is the
/// same-corner photo (timelapse, later). Rows are never deleted; the speech
/// fields may be filled in after the row exists (an offline post).
model HomeSiteLogPhoto {
  id        String      @id @default(cuid())
  siteLogId String
  siteLog   HomeSiteLog @relation(fields: [siteLogId], references: [id], onDelete: Cascade)

  /// Private `site-photos` bucket; signed links only.
  storagePath String
  /// From EXIF or the capture moment on the phone.
  takenAt     DateTime
  /// Where the phone was. Never crosses.
  lat         Float?
  lng         Float?
  /// Picked from the gallery, not taken in the app; shown to the customer
  /// as "from gallery". The web cannot prove a camera capture (Phase 6).
  fromGallery Boolean  @default(false)

  voicePath      String?
  transcript     String? @db.Text
  transcriptLang String?
  customerText   String? @db.Text
  customerLang   String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// The step this photo ticked, if any (the link is on the step).
  doneStep HomeChecklistItem? @relation("ChecklistDonePhoto")

  @@index([siteLogId, sortOrder])
  @@map("home_site_log_photos")
}

/// Who was on site that day. Only `crewName` (first name), `crewRole` and
/// `arrivedAt` cross to the customer. `crewMemberId` is null for someone
/// typed in on the day rather than tapped from the saved list.
model HomeSiteLogCrew {
  id           String            @id @default(cuid())
  siteLogId    String
  siteLog      HomeSiteLog       @relation(fields: [siteLogId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember   StudioCrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  /// Copied at posting, so renaming a crew member never rewrites history.
  crewName     String
  crewRole     String
  arrivedAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([siteLogId])
  @@index([crewMemberId])
  @@map("home_site_log_crew")
}

/// Which date moved.
enum DateChangeField {
  PLANNED_START
  PLANNED_END
  /// The project's handover (the HANDOVER stage's plannedEnd).
  HANDOVER
}

/// Whose delay it is. CUSTOMER_CHANGE does not count against the studio.
enum DelayReason {
  SUPPLIER
  CUSTOMER_CHANGE
  SITE_CONDITION
  STUDIO
  OTHER
}

/// A plan date moved (Phase 3). The stage's own column holds the current
/// date; these rows are the history, append-only. The original plan is the
/// earliest row's `fromDate` (or the column, when nothing ever moved). The
/// customer sees the old date, the new date and the reason in plain words —
/// never `note`.
model HomeProjectDateChange {
  id         String            @id @default(cuid())
  projectId  String
  project    HomeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Null for HANDOVER when it is not tied to a stage row.
  stageId    String?
  stage      HomeProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  field      DateChangeField
  fromDate   DateTime
  toDate     DateTime
  reason     DelayReason
  /// When the delay is a late decision: which one (customer delay).
  decisionId String?
  decision   HomeDecision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  /// The PM's own words. Internal: NEVER crosses.
  note       String?           @db.Text
  byId       String
  at         DateTime          @default(now())

  @@index([projectId, at])
  @@index([stageId])
  @@index([decisionId])
  @@map("home_project_date_changes")
}

/// A payment the studio says it received (Phase 5) — the source of truth
/// for paid and balance, replacing the overwritten `HomeProject.paidPhases`
/// marks (still written alongside until every reader moves). It counts only
/// once the customer confirms it. A wrong entry is never edited: a new row
/// with `correctsId` replaces it (amount 0 to void). Only the customer's
/// confirm/dispute fields are ever set after insert, once.
model HomeProjectPayment {
  id                String        @id @default(cuid())
  projectId         String
  project           HomeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Index into `HomeProject.paymentPhases` (the stages as signed).
  stageIndex        Int
  amountPaise       BigInt
  /// The IST day the money arrived.
  receivedOn        DateTime      @db.Date
  /// Null only on rows backfilled from `paidPhases`, which never said.
  mode              PaymentMode?
  /// The receipt, filed in the locker as a RECEIPT document.
  receiptDocumentId String?
  receiptDocument   HomeDocument? @relation(fields: [receiptDocumentId], references: [id], onDelete: SetNull)
  /// Internal note (UTR, who paid). NEVER crosses.
  note              String?
  /// Money received for a change order (extra work), recorded on the stage
  /// its price landed on. Null for an ordinary stage payment.
  changeOrderId     String?
  changeOrder       HomeChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  recordedById String
  recordedAt   DateTime @default(now())

  correctsId  String?
  corrects    HomeProjectPayment?  @relation("HomeProjectPaymentCorrections", fields: [correctsId], references: [id], onDelete: SetNull)
  corrections HomeProjectPayment[] @relation("HomeProjectPaymentCorrections")

  /// Received before the project was brought onto One Interiors (docs/studio-os/
  /// BRING-IN-PROJECTS.md): reads as 'earlier' (counts as paid, no client
  /// confirmation needed), like the rows backfilled from `paidPhases`.
  beforeJoining Boolean @default(false)

  /// The customer said yes, this arrived.
  customerConfirmedAt   DateTime?
  customerConfirmedById String?
  /// The customer said "I didn't pay this". Goes to our team.
  disputedAt            DateTime?
  disputedById          String?
  /// The customer's words to our team. Not shown on the studio's or the
  /// customer's screens by the projection.
  disputeNote           String?   @db.Text

  @@index([projectId, stageIndex])
  @@index([correctsId])
  @@index([receiptDocumentId])
  @@index([changeOrderId])
  @@map("home_project_payments")
}

/// A recorded change to the signed quote (Phase 5): a picked decision
/// option, its price difference, the line it changes. The signed line stays
/// as signed; this row is the change beside it. Append-only: a re-pick is a
/// new row reversing the old one.
model HomeQuoteChange {
  id          String              @id @default(cuid())
  projectId   String
  project     HomeProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisionId  String?
  decision    HomeDecision?       @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  optionId    String?
  option      HomeDecisionOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  quoteLineId String?
  /// "Shutter finish: Gloss".
  label       String
  /// GST included, customer-visible; negative when it takes money off.
  deltaPaise  BigInt
  /// The payment stage it lands on (the final one, by the brief).
  stageIndex  Int?
  byId        String?
  at          DateTime            @default(now())
  /// The approved change order this price is (extra work after sign-off).
  /// Kept apart from decisions so the closure shows it as its own line.
  changeOrderId String?
  changeOrder   HomeChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([projectId, at])
  @@index([changeOrderId])
  @@index([decisionId])
  @@index([optionId])
  @@map("home_quote_changes")
}

/// The project's append-only event log: one row per thing that mattered,
/// written in the same transaction as the write itself
/// (modules/project/events.ts `recordEvent`). Feeds the customer feed,
/// notifications, reminders and the studio's score. `payload` is INTERNAL:
/// anything shown to the customer is read from the row `refId` names,
/// through the customer projection — never from the payload.
model HomeProjectEvent {
  id        String           @id @default(cuid())
  projectId String
  project   HomeProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at        DateTime         @default(now())
  actorType ProjectActorType
  /// The user, when there is one.
  actorId   String?
  /// One of events.ts `PROJECT_EVENT_TYPES` ("site.posted", "snag.fixed"…).
  type      String
  /// The row it is about (a site log, snag, payment…).
  refId     String?
  payload   Json             @default("{}")
  /// Set for things that must happen once (a reminder for a day): a second
  /// insert with the same key is skipped (events.ts `recordEventOnce`).
  dedupeKey String?          @unique

  @@index([projectId, at])
  @@index([type, at])
  @@map("home_project_events")
}

/// The society floor-plan library (Phase 7): the sizes a customer confirmed
/// from their own floor plan, kept against their society and home type so the
/// next family in the same building can use them without uploading anything.
/// Sizes only — never the file, the name or the brief's other answers — and
/// offered only once two or more homes agree (modules/floorplan/society-library.ts).
/// One row per brief: a customer who corrects their plan corrects their row.
model SocietyPlan {
  id             String @id @default(cuid())
  briefId        String @unique
  /// Deleted with the brief — an erasure request takes these sizes too.
  brief          Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  /// Lower-case letters and digits of the society name, so "Sapphire Heights"
  /// and "sapphire heights " are one building.
  societyKey     String
  bhk            Int
  carpetAreaSqft Int?
  bathrooms      Int
  kitchenRunMm   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyKey, bhk])
  @@map("society_plans")
}

/// Two questions to the customer after their first meeting with a studio
/// (plan §10): did the studio match what we told them, and how was the
/// communication. Enough of these (three or more) become the studio's
/// communication rating, which the matching engine reads (§5.5).
model MeetingCheckIn {
  id             String       @id @default(cuid())
  introductionId String       @unique
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)
  /// YES | PARTLY | NO — did the studio match what we told you?
  matched        String
  /// 1–5.
  communication  Int
  note           String?      @db.Text

  createdAt DateTime @default(now())

  @@map("meeting_check_ins")
}

/// An expert's weekly hours for booked calls, in IST (modules/consultation/slots.ts).
/// Set by ops. Several rows per expert and weekday are allowed (a morning and
/// an evening block).
model ExpertHours {
  id           String @id @default(cuid())
  expertUserId String
  expert       User   @relation("ExpertHours", fields: [expertUserId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday      Int
  /// Minutes after IST midnight, on the half-hour.
  startMin     Int
  endMin       Int

  createdAt DateTime @default(now())

  @@index([expertUserId])
  @@map("expert_hours")
}

/// A day an expert is away. No slots are offered on it.
model ExpertBlock {
  id           String  @id @default(cuid())
  expertUserId String
  expert       User    @relation("ExpertBlocks", fields: [expertUserId], references: [id], onDelete: Cascade)
  /// IST date, YYYY-MM-DD.
  day          String
  reason       String?

  createdAt DateTime @default(now())

  @@unique([expertUserId, day])
  @@map("expert_blocks")
}

// ─────────────────────────────────────────────────────────────
// INTRODUCTION — the handoff, and the meetings that follow
// ─────────────────────────────────────────────────────────────

/// We handed this customer to this studio.
///
/// ## Why this is its own table
///
/// It is the single event the business charges for, and until now it was
/// recorded nowhere. The expert took a call, decided, and told somebody on
/// WhatsApp. Three things depend on it and all three were running on trust:
///
///  - **Contact release.** "No studio receives your details until you tell an
///    expert which introduction you want" is on the landing page. With no row,
///    that promise had nothing to enforce it — it was a convention. Now it is a
///    query.
///  - **The commission clock.** 5% is charged on a project that came from an
///    introduction we made. A project with no introduction behind it is either
///    a data error or a studio that went around us, and both are worth seeing.
///  - **The honest denominator.** Introductions per studio, and what share of
///    them sign, is the real measure of whether matching works. The expert's
///    `matchWasCorrect` is an opinion; this is an outcome.
///
/// ## Created by a person, always
///
/// There is deliberately no code path that creates one automatically. An
/// introduction is a judgement made on a call — if it could be triggered by a
/// customer action, the expert call would stop being the gate and the whole
/// quality mechanic would quietly become optional.
/// Where an introduction came from. ONE_INTERIORS: our expert introduced
/// the customer (the event the business is paid for). STUDIO_OWN_CLIENT: the
/// studio's own client, linked only so they can follow the project in the
/// app (owner, 11 Oct 2026; docs/studio-workspace/OWN-CLIENTS.md). Never in
/// ops' queues, never counted as an introduction, no commission.
enum IntroductionSource {
  ONE_INTERIORS
  STUDIO_OWN_CLIENT
}

model Introduction {
  id String @id @default(cuid())

  /// See `IntroductionSource`. Every read that means "One Interiors
  /// introduced them" filters on ONE_INTERIORS (studio/introduction-source.ts).
  source IntroductionSource @default(ONE_INTERIORS)

  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// The call this came out of. Nullable only because an introduction could one
  /// day follow from something else; today it never does.
  consultationId String?

  introducedAt   DateTime @default(now())
  /// The expert. A human act, recorded as one.
  introducedById String

  /// When the studio became allowed to see the customer's name and phone.
  ///
  /// Separate from `introducedAt` on purpose: an expert may introduce and hold
  /// contact release until the customer has confirmed they are happy. Null
  /// means the studio knows a brief is coming and nothing about who.
  contactReleasedAt DateTime?

  /// The customer changed their mind. Contact access ends here — see
  /// `canSeeContact` in src/modules/studio/introduction-access.ts, which is the
  /// only place that decision is made.
  withdrawnAt     DateTime?
  withdrawnReason String?

  /// The studio's answer. Accepting says they will call the customer;
  /// declining (with a reason) hands the introduction back to ops to place
  /// elsewhere. Neither set means they have not answered yet.
  studioAcceptedAt    DateTime?
  studioDeclinedAt    DateTime?
  studioDeclineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  checkIn      MeetingCheckIn?
  homeProject  HomeProject?

  /// One introduction per studio per brief. A second one is the same
  /// introduction, not a new one.
  @@unique([briefId, studioId])
  @@index([studioId, introducedAt])
  @@map("introductions")
}

enum AppointmentKind {
  FIRST_MEETING
  SITE_VISIT
  FOLLOW_UP
}

enum AppointmentStatus {
  PROPOSED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum NoShowParty {
  CUSTOMER
  STUDIO
}

/// A meeting or site visit between a customer and a studio.
///
/// The product promises this in four separate places — "then we set up the
/// meeting or site visit with that studio directly" — and modelled it in none
/// of them until now.
///
/// Note what this is NOT: `Consultation.scheduledFor` is the expert's own call
/// with the customer, and a `VerificationCheck` site visit is us visiting the
/// studio. Three different things that all involve a date and a visit, kept
/// apart deliberately.
model Appointment {
  id String @id @default(cuid())

  introductionId String
  introduction   Introduction @relation(fields: [introductionId], references: [id], onDelete: Cascade)

  kind   AppointmentKind
  status AppointmentStatus @default(PROPOSED)

  /// Stored UTC, rendered IST. One city today, and storing a local time anyway
  /// is how a calendar breaks the first time anything moves.
  startsAt     DateTime
  durationMins Int      @default(60)

  /// The flat, or the studio office. Free text because a Pune address is not a
  /// structure worth modelling for this.
  location String?

  proposedById String
  confirmedAt  DateTime?

  /// Set only alongside `NO_SHOW`, and only by a human.
  ///
  /// Never inferred from an appointment passing its end time. This ends up in a
  /// studio's delivery record, it is the first thing they will dispute, and a
  /// missed appointment has too many innocent explanations for a cron job to
  /// judge.
  noShowBy NoShowParty?

  /// Ops-internal. Never rendered on a studio-facing page — if a studio needs
  /// to know something it is said to them, not left in a field they read over
  /// our shoulder.
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([introductionId])
  @@index([startsAt, status])
  @@map("appointments")
}

/// One room of the prep pack — what the customer did with it between booking
/// the expert call and taking it.
///
/// ## Why this is a table and not a JSON blob on Brief
///
/// Because the expert reads it one room at a time on the call, and because the
/// most valuable column here is `note` — the sentence a customer writes about
/// their own kitchen. That is free-text about their home, it is the thing the
/// designer most wants to have read beforehand, and burying it inside a JSON
/// column would make it unqueryable the first time someone asks which rooms
/// people actually write about.
///
/// ## What is deliberately absent
///
/// No score, no ranking, no completeness percentage. This is preparation, not
/// an exam, and a customer who fills in two rooms and stops has still made
/// their call better. Nothing here may ever be used to deprioritise them.
model PrepRoom {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// One of ROOM_KEYS in src/modules/prepare/rooms.ts. A plain string rather
  /// than an enum because the room set is product surface that will change more
  /// often than the schema should, and a value this table does not recognise
  /// should render as an unknown room, not fail a migration.
  roomKey String

  /// How many times they pressed Shuffle. The proposal is a pure function of
  /// this plus their liked styles, so the board is reproducible from the row —
  /// we store the input, never the generated output.
  shuffle Int @default(0)

  /// Index into the room's decision options, or null for "not decided yet",
  /// which is a genuine and useful answer for the expert to see.
  chosenOption Int?

  /// The board the customer composed: element slugs from
  /// src/modules/prepare/catalogue.ts, in the order they placed them.
  ///
  /// Slugs and not ids, because the catalogue is code rather than a table — it
  /// is vocabulary, revised in pull requests with the reasoning attached, not
  /// data anyone edits at runtime. A slug this array no longer recognises is
  /// skipped when the board is read, so retiring an element never breaks a
  /// board somebody is mid-way through.
  items String[] @default([])

  /// What the customer wrote about this room, in their own words.
  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([briefId, roomKey])
  @@index([briefId])
  @@map("prep_rooms")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel  String // "push" | "whatsapp" | "email"
  template String
  payload  Json
  readAt   DateTime?
  sentAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  action     String // "verification.pass" | "escrow.release" | "studio.suspend"
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipHash     String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// A drafted profile, waiting for the studio to read it.
///
/// Kept separate from `Studio` on purpose: a draft is a proposal, and it must
/// be impossible for one to be mistaken for published copy. Nothing here
/// appears anywhere public until the studio has read it and approved it, at
/// which point the text is copied onto the Studio row and `approvedAt` is set.
///
/// `issues` records what the honesty check found at generation time. A draft
/// with issues is still stored — knowing that a draft invented a number is
/// more useful than discarding it silently, and it is how we find out the
/// prompt has drifted.
model ProfileDraft {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  headline     String
  introduction String @db.Text
  notFor       String @db.Text
  /// [{ title, story }] — one per portfolio project, in the same order.
  stories      Json

  /// Which model wrote it, so a bad batch can be traced to a change.
  model       String
  /// Findings from verifyDraft() at generation time. Empty array = clean.
  issues      Json
  generatedAt DateTime @default(now())

  /// Set only when a human at the studio has read it and said yes.
  approvedAt   DateTime?
  approvedById String?

  @@map("profile_drafts")
}

/// A funnel event.
///
/// Deliberately thin, and deliberately ours rather than a third-party script:
/// under the DPDP Act the cheapest position is not to ship visitor data to
/// anyone else at all, and the questions we actually need answered — which
/// quiz question loses people, what did a qualified lead cost — are answerable
/// from our own rows.
///
/// **No personal data goes in `props`.** Not a name, phone, email or free
/// text. It carries counts, slugs and enum values only, and everything here is
/// readable by anyone with ops access.
model AnalyticsEvent {
  id   String @id @default(cuid())
  name String // "quiz.step.view" | "quiz.complete" | "match.view" | "enquiry.sent"

  /// The anonymous brief cookie token, when there is one. Lets a funnel be
  /// followed across a session without knowing who the person is.
  anonKey String?
  /// Set only once they have signed in.
  userId  String?
  briefId String?

  /// Small structured payload. Numbers, slugs and enums only — never free text.
  props Json?

  /// Where they came from. Recorded once per session, on the first event.
  source   String?
  campaign String?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonKey])
  @@index([briefId])
  @@map("analytics_events")
}

// ─────────────────────────────────────────────────────────────
// THE STUDIO'S OWN SOFTWARE
//
// Everything above this line is the marketplace: our briefs, our
// matching, our indicative quotes. Everything below belongs to the
// STUDIO and works whether or not we ever send them a lead.
//
// That distinction is the whole product thesis, so it is worth
// stating where the schema shows it. `Quotation` (above) is the
// indicative number WE produce from a studio's rate card to make two
// studios comparable on a customer's screen. `StudioQuote` (below) is
// the detailed document a studio sends its own client, on its own
// letterhead, for a project we may have had nothing to do with.
//
// Different authors, different audiences, different lifetimes. Naming
// them both "quotation" would have guaranteed somebody eventually
// wrote the wrong one to the wrong screen.
// ─────────────────────────────────────────────────────────────

/// How a line is measured. AREA is width × height in millimetres,
/// which is how carpentry is actually quoted here — the rate is per
/// square foot and the area comes off the drawing.
enum QuoteUnit {
  AREA
  SQFT
  RFT
  UNIT
}

/// The two work codes every quotation in this industry carries.
/// MODULAR is factory-made and is what a discount is usually given
/// against; ONSITE is labour and materials at the site.
enum StudioWorkCode {
  MODULAR
  ONSITE
}

enum StudioQuoteStage {
  /// Before booking. What wins the client.
  SALES
  /// After design sign-off. What the work is actually built against.
  DESIGN
}

enum StudioQuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
}

/// A studio's identity on its own documents.
///
/// This is what makes the quotation builder white-label rather than
/// ours with their name typed in. Nothing here is shown on the
/// marketplace — the public profile has its own fields — because a
/// studio's GSTIN and registered address belong on an invoice, not on
/// a listing.
model StudioBranding {
  id       String @id @default(cuid())
  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  legalName   String
  addressLine String?
  city        String  @default("Pune")
  pincode     String?
  gstin       String?
  phone       String?
  email       String?
  website     String?

  /// Storage path, never a public URL. Served through a signed link,
  /// the same way floor plans are.
  logoPath  String?
  accentHex String  @default("#1F5C4D")

  /// The studio's own words at the top of a quotation, and its own
  /// terms at the bottom. Both default to null rather than to ours:
  /// a document going out under their name must not carry copy they
  /// have never read.
  welcomeNote String? @db.Text
  terms       String? @db.Text

  /// Does the studio want our attribution mark off their documents?
  ///
  /// A WISH, not the outcome. Whether the mark actually appears is this
  /// combined with their subscription tier, decided at render time by
  /// `showsOurMark()` in modules/studio-quote/mark.ts.
  ///
  /// Kept apart deliberately: one boolean would have to be rewritten on every
  /// tier change by something that remembered to, and the thing that remembers
  /// is the thing that will one day forget — leaving a downgraded studio still
  /// white-labelled. This way a downgrade restores the mark on its own, and a
  /// later upgrade restores their choice.
  hideOurMark Boolean @default(false)

  /// Defaults a new quotation starts from. Basis points, so 700 = 7%.
  feeBps              Int    @default(700)
  discountBps         Int    @default(0)
  bookingAdvancePaise BigInt @default(2500000)
  /// GST a new quotation starts with: 0 (off) or 1800.
  gstBps              Int    @default(0)

  /// The material specification printed on every quotation:
  /// [{ item, spec }] — "Plywood" / "Century BWP 710, 18 mm". The
  /// studio's own brands; null prints no table.
  materialSpec Json?

  /// How many days a quotation holds its prices. Printed as "valid until".
  validityDays Int @default(30)

  /// Storage paths (the logo bucket, studio_<id>/brand/…) of up to three
  /// full-page images the studio designed — its cover, "Why choose us", its
  /// partners — printed before every quotation (owner, 13 Oct 2026). Empty:
  /// the PDF draws a cover from the studio's details.
  brandPages String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_branding")
}

/// One studio's product master.
///
/// Per studio, always. The alternative — a shared catalogue everyone
/// draws from — sounds tidier and would mean a studio's own product
/// names, rates and descriptions were visible in a table their
/// competitors also read.
model StudioProduct {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name    String
  code    StudioWorkCode @default(MODULAR)
  unit    QuoteUnit      @default(AREA)
  details String?        @db.Text

  /// Per sqft, per rft, or per unit, depending on `unit`.
  ratePaise BigInt

  /// Which rooms this belongs in, for the first-quote builder.
  rooms String[]

  /// Starting size or count when this lands on a quotation. Millimetres.
  defaultWidthMm  Int?
  defaultHeightMm Int?
  defaultQty      Int?

  /// Does this go on the quotation when a studio applies a
  /// configuration?
  ///
  /// The difference between a catalogue and a standard specification.
  /// A studio sells forty products and puts about twenty-five of them
  /// on nearly every 3 BHK; this marks which. Off by default, because
  /// a build we assembled from guesses is worse than an empty one —
  /// the studio ticks what they actually fit as standard, once, and
  /// every later quotation starts from their own practice.
  inStandardBuild Boolean @default(false)

  /// First-quote rules, as in the Hauspire builder: `perBath`, `perBed`,
  /// `useRun` (kitchen width follows the run), `balcony` (only with a dry
  /// balcony), `bhk` ("1BHK".."4BHK": only for that size of home), and a
  /// default `sqft` / `rft` for those units. Loose JSON because rules are
  /// added as studios teach us their habits.
  rules Json?

  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, name])
  @@index([studioId, sortOrder])
  @@map("studio_products")
}

/// A quotation a studio sends its own client.
model StudioQuote {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Per studio, and theirs to set — AKA-2026-014, or 2300, or
  /// whatever their existing books use. Unique within the studio only.
  number String
  stage  StudioQuoteStage  @default(SALES)
  status StudioQuoteStatus @default(DRAFT)

  clientName  String
  clientPhone String?
  clientEmail String?
  society     String?
  locality    String?
  config      String?
  carpetSqft  Int?

  /// The kitchen run, in millimetres: base + wall + loft are all
  /// priced on it.
  ///
  /// One measurement that sets three line widths, which is why it is
  /// a field on the quotation rather than three numbers typed three
  /// times. Kept after the build so re-applying a configuration does
  /// not ask for it again.
  kitchenRunMm Int?

  /// How many bathrooms get a vanity. Counted, not derived from the
  /// BHK: a 2 BHK with three bathrooms is ordinary in Pune.
  bathrooms Int?

  /// The lines as the client first received them.
  ///
  /// Written once, when the quotation is issued, and never again — so
  /// "what changed since we sent it" has something true to compare
  /// against. A revision history would be the general version of this
  /// and is not what anybody asks for: the question in the room is
  /// always about the document the client is holding.
  ///
  /// Json rather than a table because it is a frozen copy that is
  /// never queried across rows, and a table of snapshots invites
  /// somebody to edit one.
  issuedLines Json?

  /// Set when this client came from us. Null for the studio's own
  /// work, which is most of it and must stay first-class.
  briefId        String?
  introductionId String?

  /// The client this was written for, once there is one.
  ///
  /// Optional, and it stays optional. A studio often writes a quotation
  /// straight off a phone call before deciding the enquiry is worth a
  /// client record, and making this required would put a data-entry step
  /// in front of the fastest thing in the product.
  clientId String?
  client   StudioClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// The figures that shaped this document, copied at creation so a
  /// later change to the studio's defaults never rewrites a quotation
  /// already sent.
  feeBps              Int
  discountBps         Int
  onSpotPaise         BigInt @default(0)
  bookingAdvancePaise BigInt

  /// GST on this quotation, basis points: 0 (off) or 1800. Charged after
  /// every discount, on what the client pays for the work.
  gstBps Int @default(0)

  /// The name of the flat discount above — "On-spot", "Festive",
  /// "Referral". Null prints as "Additional discount".
  onSpotLabel String?

  /// The date printed on the quotation. Null means the day it was made.
  quoteDate DateTime? @db.Date

  /// The studio's payment schedule as it stood when this was made
  /// ([{ label, pct }], `payment-phases.ts`). Null means the studio's
  /// current one, or the standard stages when it has none.
  phases Json?

  /// The quotation this one was made from: a Design Final points at its
  /// Sales Final, so the two can be compared line by line. Null for a
  /// quotation written fresh or copied as a template.
  basedOnId String?

  /// Their words on this document, snapshotted for the same reason.
  welcomeNote String? @db.Text
  terms       String? @db.Text

  issuedOn DateTime?

  /// Studio OS Phase 1: every send is a frozen, numbered revision (R1, R2…).
  revisions StudioQuoteRevision[] @relation("QuoteRevisions")

  /// The revision marked "Sales final", with the payment schedule agreed for
  /// this client (payment-template.ts shape), when and by whom. Marking a
  /// later revision moves the mark; the lead's timeline keeps the history.
  /// The booking is recorded against this revision.
  salesFinalRevisionId String?              @unique
  salesFinalRevision   StudioQuoteRevision? @relation("SalesFinal", fields: [salesFinalRevisionId], references: [id], onDelete: SetNull)
  salesFinalSchedule   Json?
  salesFinalAt         DateTime?
  salesFinalById       String?

  /// Brought in from the studio's old quotation app (docs/studio-os/
  /// BRING-IN-PROJECTS.md): "hauspire:<source row id>", unique per studio,
  /// so importing the same quotation twice opens the one already made.
  importedFrom String?
  importedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines StudioQuoteLine[]

  @@unique([studioId, number])
  @@unique([studioId, importedFrom])
  @@index([studioId, status, updatedAt])
  /// The leads board loads up to 400 clients and includes their
  /// quotes, so Postgres runs `WHERE clientId IN (400 ids)` on every
  /// render. Without this it is 400 sequential scans of the studio's
  /// whole quotation history.
  @@index([clientId])
  @@map("studio_quotes")
}

/// One line of a studio's quotation.
///
/// Every product field is a SNAPSHOT. Editing the product master must
/// never change a quotation already sent to a client — that is how a
/// studio ends up in an argument it cannot win about what it quoted.
model StudioQuoteLine {
  id      String      @id @default(cuid())
  quoteId String
  quote   StudioQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  room    String
  product String
  code    StudioWorkCode
  unit    QuoteUnit
  details String?        @db.Text

  widthMm  Int?
  heightMm Int?

  /// Quantity in THOUSANDTHS, as an integer.
  ///
  /// 34.39 sqft is 34390. Quantities here are genuinely fractional —
  /// an area comes out at 34.39 sqft, not 34 — and a float would drift
  /// against the money, which is integer paise. Thousandths is finer
  /// than anyone measures and crosses the server/client boundary as a
  /// plain number, which a Prisma Decimal does not.
  qtyMilli Int?

  ratePaise   BigInt
  /// Stored, not computed. A designer overrides a line total often
  /// enough that the agreed number has to be the one that prints, and
  /// on an issued document it is a fact about that document.
  amountPaise BigInt

  /// A note for the client on this line (owner's team, 15 Oct 2026): written
  /// in the builder, printed under the line's details on the quotation PDF
  /// and the Final PDF like a margin comment. Client-facing.
  note String? @db.Text

  sortOrder Int @default(0)

  @@index([quoteId, sortOrder])
  @@map("studio_quote_lines")
}

/// A quotation as it was sent, frozen (Studio OS Phase 1). Each send makes
/// the next number (R1, R2, R3); drafts in between are not revisions. Never
/// edited, and deleted only with its quotation (project/append-only.ts).
/// Any two can be compared; one is marked the sales final on the quotation.
model StudioQuoteRevision {
  id String @id @default(cuid())

  /// Denormalised, like StudioClientEvent: every read is "this studio's".
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  quoteId String
  quote   StudioQuote @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Cascade)

  /// 1, 2, 3… per quotation.
  n Int

  /// Every line as sent (room, product, code, unit, details, sizes, rate,
  /// amount; paise as plain numbers).
  lines      Json
  /// The terms it was priced on: fee, discounts, GST, advance, phases.
  terms      Json
  /// What the client was told they pay, GST included.
  totalPaise BigInt
  /// The total's parts (work, fee, discounts, GST), for the comparison.
  totals     Json

  sentAt     DateTime      @default(now())
  sentById   String?
  sentBy     StudioMember? @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentByName String?

  salesFinalOf StudioQuote? @relation("SalesFinal")

  /// The client's digital sign-offs of this exact revision (15 Oct 2026).
  signoffs HomeQuoteSignoff[]

  @@unique([quoteId, n])
  @@index([studioId, sentAt])
  @@index([sentById])
  @@map("studio_quote_revisions")
}

// ─────────────────────────────────────────────────────────────
// RUNNING THE PRACTICE
//
// Clients, projects, vendors and what is owed. None of this needs
// us: a studio that never takes a single lead from the marketplace
// still has enquiries to chase, sites running and a carpenter waiting
// to be paid. That is the whole point — software they would keep using
// the day they left the roster.
//
// Two rules run through all of it.
//
//  1. NEVER STORE A TOTAL. A work order's bill, what has been paid and
//     what is left are computed from the lines and the payments, every
//     time. A stored total and a payments table disagree eventually,
//     and the disagreement is always found by a vendor who has been
//     paid twice.
//
//  2. WORK ORDER LINES ARE SNAPSHOTS. A line copies the vendor's rate
//     as it was when the order was raised. Editing a rate card later
//     must never silently reprice a bill already paid against.
// ─────────────────────────────────────────────────────────────

/// Where an enquiry came from. An enum rather than free text because
/// "Instagram", "instagram" and "IG" in one column is a source report
/// nobody can read, and the only reason to record a source is to count
/// it later.
enum ClientSource {
  ONE_INTERIORS
  REFERRAL
  REPEAT_CLIENT
  INSTAGRAM
  /// Studio OS Phase 1: Facebook ads and page messages.
  FACEBOOK
  WEBSITE
  WALK_IN
  ARCHITECT
  OTHER
}

/// What a stage MEANS, as opposed to what it is called.
///
/// This enum is the whole reason a studio can rename its pipeline without
/// breaking the software. The stage list used to be an enum — six fixed
/// values — and a studio whose real process is "New → Calling 1 → Calling 2
/// → Effective lead → Floor plan pending → Quotation pending → Quotation
/// shared" could not write any of that down.
///
/// But Projects, the dashboard and the vendor ledger all need answers to
/// questions that survive renaming: is this client still in play, have they
/// signed, is the job finished, did it go. So a stage carries a `kind`, and
/// every query in the codebase asks the kind rather than the name. A studio
/// owns the names, the order, the colours and how many there are; the four
/// meanings are ours.
enum StageKind {
  /// Still in play. Counts on the board and in "waiting on you".
  OPEN
  /// Signed. A project may be created from a client at this kind and no
  /// other — that rule is what keeps the board and the project list from
  /// disagreeing about whether a job was won.
  WON
  /// Handed over. Off the board, not lost.
  DONE
  /// Gone. Needs a reason.
  LOST
}

/// One column of a studio's pipeline.
///
/// Seeded with six defaults on first read — see `myStages()` — and then
/// entirely theirs. A studio may add, rename, reorder, recolour and delete,
/// with two rules the software enforces: exactly one intake stage, which is
/// where a new client lands and which cannot be deleted, and at least one
/// stage of each kind, because deleting the last WON stage would leave no
/// way to start a project.
model StudioStage {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name String
  kind StageKind @default(OPEN)

  /// One of the eight tokens in `STAGE_COLOURS`. A token and not a hex
  /// value, so the palette stays coherent and dark mode stays possible.
  colour    String @default("slate")
  sortOrder Int

  /// Where a new client lands. Exactly one per studio, undeletable.
  isIntake Boolean @default(false)

  /// A cold-calling column (owner, 21 Oct 2026): Hauspire's Calling 1–4.
  /// Logging a call that was not picked up suggests the next one, pre-ticked
  /// (studio-practice/call-step-rules.ts). Only an open column; a suggestion,
  /// never a move by itself.
  isCallStep Boolean @default(false)

  createdAt DateTime @default(now())

  clients StudioClient[]

  @@unique([studioId, name])
  @@index([studioId, sortOrder])
  @@map("studio_stages")
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

/// An extra thing a studio captures on every client.
///
/// Carpet area, society, possession month, BHK — every studio wants a
/// slightly different set and none of them is worth a schema migration. The
/// values live in `StudioClient.fields` as JSON, keyed by `key`.
///
/// `key` is machine-stable and `label` is not: renaming the label must never
/// orphan the values already captured under it, which is exactly what
/// happens if the label is the key.
model StudioField {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  key     String
  label   String
  type    FieldType @default(TEXT)
  /// SELECT only. Ignored for every other type.
  options String[]  @default([])

  /// Offer this field as a grouping on the client list. A studio working one
  /// tower at a time groups by society; one working referrals does not.
  groupBy Boolean @default(false)

  sortOrder Int

  createdAt DateTime @default(now())

  @@unique([studioId, key])
  @@index([studioId, sortOrder])
  @@map("studio_fields")
}

/// Why a client did not go ahead. Short list on purpose: seven reasons
/// a studio will actually pick between, not twenty it picks the first of.
enum LostReason {
  BUDGET
  TIMELINE
  WENT_ELSEWHERE
  NO_RESPONSE
  NOT_SERIOUS
  POSTPONED
  /// AxLeads (12 Oct 2026): the "Wrong number" call outcome offers it.
  WRONG_NUMBER
  OTHER
}

model StudioClient {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name       String
  phone      String?
  email      String?
  society    String?
  locality   String?
  city       String  @default("Pune")
  config     String?
  carpetSqft Int?

  source     ClientSource @default(OTHER)
  sourceNote String?

  /// The studio's own column, not one of ours. `onDelete: Restrict` because
  /// deleting a stage that still holds clients would silently drop them off
  /// the board — the settings screen makes you move them first.
  stageId String
  stage   StudioStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  lostReason LostReason?
  lostNote   String?

  /// Whatever the studio defined in Settings → Fields, keyed by the field's
  /// `key`. Untyped here and validated on write against the definitions.
  fields Json @default("{}")

  /// The only field here that earns its place every single day. A client
  /// list without a next action is a list; with one, the dashboard can
  /// say "four people are waiting on you".
  nextAction   String?
  nextActionOn DateTime?

  /// Set when they came from us. Null for the studio's own work, which
  /// is most of it and stays first-class.
  briefId        String?
  introductionId String?

  notes String? @db.Text

  /// Who is working this one.
  ///
  /// **Null means the pool** — nobody has taken it yet. That is a real and
  /// common state, not a missing value: two hundred imported rows all start
  /// there, and the pool screen exists to empty it.
  ///
  /// `SetNull` on delete, so removing somebody from the studio returns their
  /// clients to the pool rather than deleting them along with the membership.
  assignedToId String?
  assignedTo   StudioMember? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  /// When somebody last actually spoke to them.
  ///
  /// Deliberately not `updatedAt`, which moves when anything at all changes —
  /// including a bulk assignment or an import. "Nobody has called this person
  /// in three weeks" is only true if it is measuring calls.
  lastContactedAt DateTime?

  /// Soft delete. The row stays for thirty days and is then erased along with
  /// its history, which is what the bin screen counts down to.
  ///
  /// EVERY read of this table must filter on this being null. A deleted client
  /// reappearing on the board is worse than one that never deleted.
  deletedAt DateTime?

  /// The sample lead, put on an empty board so the screen can be learned by
  /// using it rather than by reading about it.
  ///
  /// It is a real row on purpose. A painted-on example cannot be dragged
  /// between columns, given a follow-up date or quoted from, which is the
  /// entire lesson — the moment somebody touches a fake one it stops teaching
  /// and starts lying.
  ///
  /// **Because it is real, every COUNT must exclude it.** The board lists it;
  /// nothing tallies it. The leads walkthrough ticks its first step off
  /// `clientCount > 0`, so a sample left in the count would congratulate a
  /// studio for work we did on their behalf, and the morning screen would
  /// report somebody waiting who does not exist. `demoLead.ts` holds the one
  /// filter every count uses, so this rule lives in one place.
  isDemo Boolean @default(false)

  /// Studio OS Phase 1 (docs/studio-os/PHASE-1-SALES.md).
  ///
  /// What they said they would spend, in paise. Theirs to say; nothing is
  /// computed from it.
  budgetPaise BigInt?
  /// The next meeting ("Office meeting Sat 11 am"), shown on Today that day.
  /// No calendar in this phase.
  meetingAt   DateTime?
  meetingNote String?

  /// One of the studio's own source names, when `source` is OTHER and the
  /// studio picked one ("Housing.com", "Builder tie-up"). SetNull: removing a
  /// name returns its leads to plain Other rather than deleting anything.
  leadSourceId String?
  leadSource   StudioLeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  /// The project this lead booked: the introduction `own-project.ts` made
  /// when the booking advance was recorded (lead → quote → project is one
  /// chain). Not `introductionId`, which means "introduced by One
  /// Interiors" everywhere it is read.
  bookedIntroductionId String?   @unique
  bookedAt             DateTime?
  /// The column it was in when booked, so a refunded booking goes back there.
  preBookingStageId    String?

  /// Free tags a person puts on a lead (the AxLeads look, 12 Oct 2026):
  /// at most 20, compared without case (studio-sales/tag-rules.ts).
  tags String[] @default([])

  /// Where an imported lead came from, and its id there (the AxLeads import,
  /// 21 Oct 2026: importedFrom "axleads", externalId the AxLeads lead id).
  /// Unique per studio, so running the import again skips what it already
  /// wrote. Null for everything made here, including CSV imports.
  importedFrom String?
  externalId   String?

  /// Where an ad lead came from (owner, 22 Oct 2026): columns, not only the
  /// human `sourceNote`, so lead analytics can count by campaign and Meta can
  /// be told which lead-ad leads turned into customers. Filled by lead intake
  /// (Meta from the Graph lead, Google from its webhook, a website or portal
  /// from utm_* and gclid/fbclid) and the AxLeads import. All optional; a
  /// hand-added lead has none. `adPlatform` is lower case: facebook,
  /// instagram, google, or what utm_source said.
  adPlatform   String?
  /// Meta's leadgen id. Set only for a Meta lead-ad lead: the one thing that
  /// makes a Conversions API event about this lead possible.
  leadgenId    String?
  campaignId   String?
  campaignName String?
  adsetId      String?
  adsetName    String?
  adId         String?
  adName       String?
  formId       String?
  gclid        String?
  /// { utm_source, utm_medium, utm_campaign, utm_term, utm_content, fbclid }, as sent.
  utm          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   StudioQuote[]
  projects StudioProject[]
  events   StudioClientEvent[]
  files    StudioClientFile[]
  tasks    StudioTask[]
  /// Conversions API events about this lead. Erased with it.
  conversionEvents StudioConversionEvent[]

  /// Where this row went when somebody merged it into another.
  ///
  /// Set on the LOSER, alongside `deletedAt`. Two reasons it is a column and
  /// not just a timeline entry: the board has to be able to send somebody
  /// from an old link to the row that survived, and a merge performed by
  /// mistake has to be undoable by reading one field rather than parsing
  /// prose.
  ///
  /// `onDelete: SetNull` so erasing the survivor does not cascade into
  /// deleting the record of the merge — the loser is already soft-deleted and
  /// its history is the only account of what happened.
  mergedIntoId String?
  mergedInto   StudioClient?  @relation("ClientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   StudioClient[] @relation("ClientMerge")

  /// One row per introduction, so a redelivery cannot create a second
  /// client for the same handoff.
  @@unique([studioId, introductionId])
  @@index([studioId, stageId, nextActionOn])
  /// The board, the pool and the bin are all "this studio, not deleted".
  @@index([studioId, deletedAt])
  @@index([studioId, assignedToId, deletedAt])
  /// Today's "meetings today", and the bin purge.
  @@index([studioId, meetingAt])
  @@index([deletedAt])
  @@index([leadSourceId])
  /// Leads at scale (12 Oct 2026, 20261012120000_studio_leads_scale): one
  /// index per list sort and dashboard filter, so 30,000 leads stay quick.
  @@index([studioId, createdAt])
  @@index([studioId, nextActionOn])
  @@index([studioId, lastContactedAt])
  @@index([studioId, phone])
  @@index([studioId, name])
  @@index([studioId, assignedToId, nextActionOn])
  @@index([studioId, bookedAt])
  /// The AxLeads look (20261012160000_studio_leads_tags): "Last active" sort, and tags.
  @@index([studioId, updatedAt])
  @@index([tags], type: Gin)
  @@index([stageId])
  /// The AxLeads import (20261021110000_axleads_import): one row per lead there.
  @@unique([studioId, importedFrom, externalId])
  /// "By campaign" on lead analytics (20261022100000_lead_routing_attribution).
  @@index([studioId, campaignId])
  @@map("studio_clients")
}

/// A to-do on the studio calendar (leads at scale, 12 Oct 2026): "Send the
/// revised kitchen", "Call the builder's office". Somebody writes it, it is
/// given to one person, it may hang off a lead, and it is ticked done.
/// Nothing creates one by itself — the owner's rule: easy, not automatic.
/// A salesperson sees and changes only the tasks given to them
/// (studio-sales/task-rules.ts).
model StudioTask {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  title String
  /// When it is due. Always a time; the calendar places it there.
  dueAt DateTime

  /// The lead it is about, if any. Cascade: erasing a lead from the bin
  /// takes its to-dos with it.
  leadId String?
  lead   StudioClient? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Whose it is. SetNull when they leave, so the task stays for the owner.
  assignedToId String?
  assignedTo   StudioMember? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  doneAt DateTime?

  createdById String?
  createdBy   StudioMember? @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studioId, dueAt])
  @@index([studioId, assignedToId, dueAt])
  @@index([leadId, dueAt])
  @@index([createdById])
  @@map("studio_tasks")
}

/// What a lead file is. The floor plan is what the salesperson waits for;
/// the rest is whatever else the client sent.
enum ClientFileKind {
  FLOOR_PLAN
  OTHER
}

/// A file attached to a lead (Studio OS Phase 1): the floor plan the client
/// sent on WhatsApp, or anything else. In the private `lead-files` bucket,
/// opened only through short signed links for somebody who may see the lead.
/// Erased with the lead by the bin purge (storage object first, then rows).
model StudioClientFile {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind        ClientFileKind @default(OTHER)
  /// `studio_<studioId>/lead_<clientId>/<uuid>.<ext>` in `lead-files`.
  storagePath String
  /// As it was named on their phone or laptop.
  name        String
  contentType String
  bytes       Int

  uploadedById   String?
  uploadedBy     StudioMember? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByName String?

  /// What "Read rooms" found on a floor plan (floorplan/reading.ts shape),
  /// only after somebody pressed it. Never read automatically.
  reading Json?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([studioId, createdAt])
  @@index([uploadedById])
  @@map("studio_client_files")
}

/// A studio's own name for where leads come from, beyond our list
/// (Studio OS Phase 1). A lead using one has `source = OTHER` and
/// `leadSourceId` set, so the enum still counts and filters, and the
/// studio's name shows wherever the source does.
model StudioLeadSource {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  clients StudioClient[]

  @@unique([studioId, name])
  @@map("studio_lead_sources")
}

/// What kind of thing happened to a lead.
///
/// Kept deliberately short. AxLeads carries twenty kinds and several of them
/// exist only because a feature was planned — COLD_TRIGGER_SENT and
/// HOT_ALERTED are written by code paths that have never run in production.
/// An enum value that nothing writes is a promise on a timeline that never
/// keeps it, so these are only the events something already emits.
///
/// Adding a kind is a migration, on purpose: it forces the question of who
/// writes it and what the line reads like before it can be rendered.
enum ClientEventKind {
  /// The lead arrived. The payload says how — typed, imported, or from us.
  CREATED
  /// Moved between columns. Payload carries the from/to stage names.
  STAGE_CHANGED
  /// Somebody rang, messaged or met them. The only writer of lastContactedAt.
  CONTACTED
  /// Given to a person, or returned to the pool.
  ASSIGNED
  /// Free text the studio wrote against this lead.
  NOTE
  /// A quotation was written for them.
  QUOTED
  /// Marked lost. Payload carries the reason.
  LOST
  /// Soft-deleted, or brought back out of the bin.
  BINNED
  RESTORED
  /// The customer asked One Interiors to withdraw the introduction.
  WITHDRAWN
  /// Studio OS Phase 1. Details changed (name, phone, budget…).
  EDITED
  /// A file attached or removed.
  FILE
  /// A meeting set, moved or cleared.
  MEETING
  /// A quotation revision marked as the sales final, or the mark moved.
  SALES_FINAL
  /// The booking advance recorded: the project exists.
  BOOKED
  /// The booking advance refunded: the project is cancelled.
  REFUNDED
  /// Brought over from another system (the AxLeads import, 21 Oct 2026):
  /// the "Imported from AxLeads" line, and the old system's events that have
  /// no kind here (WhatsApp messages, hot alerts, duplicate flags, tags).
  /// Not NOTE, which is the notes panel, and not CONTACTED, which counts calls.
  IMPORTED
}

/// Who did it.
///
/// `SYSTEM` is load-bearing rather than decorative: a timeline that renders
/// every line as "you" would credit a studio member with the introduction
/// bridge creating a card at 2am. When the actor is us, the line has to say
/// so, because the studio's reading of their own history depends on knowing
/// which half they were responsible for.
enum EventActor {
  MEMBER
  SYSTEM
}

/// One line of a lead's history.
///
/// ## Why this exists
///
/// Before this table, a lead's entire past was a single overwritable `notes`
/// column and `lastContactedAt` — one timestamp, which is not a log. Edits
/// were not even written to `AuditLog`. So "what happened with the Kothari
/// enquiry" had no answer beyond whatever the last person to touch it
/// remembered, and the studio's own record of its work disappeared every time
/// somebody retyped the notes box.
///
/// It is also the foundation the rest of the CRM stands on: call outcomes,
/// stage history and the assignment trail are all reads of this table rather
/// than three more columns on the client.
///
/// ## Append-only by convention
///
/// Nothing updates a row here and nothing deletes one except the cascade from
/// its client. A history you can edit is a history you cannot rely on, and the
/// entire point is to be relied on in an argument about what was promised.
///
/// The exception is the cascade itself: erasing a client from the bin takes
/// its timeline with it, because keeping a detailed record of somebody after
/// deleting them at their own request is the opposite of what the delete was
/// for.
model StudioClientEvent {
  id String @id @default(cuid())

  /// Denormalised from the client on purpose. Every read here is "this
  /// studio's", the same as everywhere else in studio-practice, and joining
  /// through studio_clients to prove ownership on a table this chatty would
  /// make the cheapest query in the module the most expensive.
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  kind  ClientEventKind
  actor EventActor      @default(MEMBER)

  /// The member who did it. Null for SYSTEM, and null for a member who has
  /// since left — `onDelete: SetNull`, because losing the fact that a stage
  /// change happened is worse than losing who made it.
  byId String?
  by   StudioMember? @relation(fields: [byId], references: [id], onDelete: SetNull)

  /// The name at the time, kept alongside the id.
  ///
  /// A timeline is a historical record, so it has to survive the person
  /// leaving. Reading the name through the relation would silently rewrite
  /// two years of history to "Unknown" the day somebody is removed from the
  /// team — the id is for linking, this is for reading.
  byName String?

  /// One line, already written, in the studio's own vocabulary.
  ///
  /// Composed at write time rather than rendered from `meta` at read time.
  /// A stage rename would otherwise retroactively change what the timeline
  /// says happened, and "moved to Quoted" has to keep saying Quoted even
  /// after the column is renamed to Priced — that is what makes it a record
  /// rather than a view.
  summary String @db.Text

  /// The structured version, for anything that needs to compute rather than
  /// display: from/to stage ids, a call outcome, a lost reason.
  meta Json?

  /// The event's id in the system it was imported from ("axleads:<id>"),
  /// unique per studio, so a second run of the import writes no line twice.
  /// Null for everything that happened here.
  externalId String?

  createdAt DateTime @default(now())

  /// The timeline read: one client, newest first.
  @@index([clientId, createdAt])
  /// The AxLeads import (20261021110000_axleads_import).
  @@unique([studioId, externalId])
  /// "What has this studio been doing", and the per-member activity read.
  @@index([studioId, createdAt])
  @@index([studioId, kind, createdAt])
  @@map("studio_client_events")
}

/// A filter somebody saved and named.
///
/// ## Per MEMBER, not per studio
///
/// "My overdue kitchens in Baner" is a person's working view, not a studio
/// policy. Sharing them would mean one person's tidy-up rearranges everybody
/// else's morning, and the first thing anyone would ask for is a way to make
/// one private — which is this, without the extra column.
///
/// The cost is that a studio cannot hand a new joiner a set of views. That is
/// a real gap and the right time to close it is when somebody asks, with a
/// `sharedAt` column, rather than by making every view shared today.
///
/// ## Why the filters are JSON
///
/// The filter shape belongs to the board and changes with it. Columns would
/// mean a migration every time a filter is added, and a saved view referencing
/// a filter that no longer exists has to degrade quietly — ignoring a key it
/// does not recognise — rather than fail to load. JSON makes that the default
/// behaviour instead of something to remember.
model StudioSavedView {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Whose view. Cascades: a member who leaves takes their views with them,
  /// because a named view nobody can explain is clutter on everybody's screen.
  memberId String
  member   StudioMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  name String

  /// `{ assigned, stageIds, due, quiet, source, groupBy }` — whatever the
  /// board understands today. Unknown keys are ignored on read.
  filters Json @default("{}")

  /// The one that loads when the board opens. At most one per member, which
  /// is enforced by the write path clearing the others in the same
  /// transaction rather than by a partial unique index — Prisma cannot
  /// express one, and a raw index here would drift from the schema silently.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One name per person. A second "Overdue" is somebody meaning to edit the
  /// first and getting two instead.
  @@unique([memberId, name])
  @@index([memberId, createdAt])
  @@map("studio_saved_views")
}

/// A studio's public enquiry form.
///
/// ## Why the fields are fixed
///
/// There is no field schema here — no JSON list of questions, no builder. A
/// form builder is a second product, and AxLeads' own known-gaps list shows
/// where that road ends: its forms are operator-managed because letting a
/// client define fields meant an import could reference a field that had been
/// hidden, and *"nothing about this is recoverable without deleting the leads
/// and starting again"*.
///
/// So the questions are the six an interiors enquiry actually needs, decided
/// once, in `capture-fields.ts`. What a studio controls is the wording around
/// them and whether the form is on at all — which is the part they would
/// actually change.
///
/// ## One per studio, created on first read
///
/// Same shape as the stage seeder and the starter catalogue: there is no
/// migration step and no moment where a studio has an account but not the
/// thing the screen is about.
model StudioForm {
  id String @id @default(cuid())

  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// The public path segment. Defaults to the studio's own slug, and is
  /// separate from it so a studio can rotate the link — the reason to rotate
  /// is that the old one is being abused, and rotating the studio's slug
  /// would break its public profile too.
  slug String @unique

  /// What the page says above the fields. Theirs to change, because it is
  /// the only part a visitor reads before deciding whether to fill it in.
  headline String
  blurb    String @db.Text

  /// Off means the page says the studio is not taking enquiries, rather than
  /// 404ing — a dead link somebody printed on a card is worse than a page
  /// that explains itself.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_forms")
}

/// Where an automatic lead comes from (lead intake, 21 Oct 2026;
/// docs/studio-os/LEAD-INTAKE.md).
enum LeadConnectionKind {
  /// The studio's own website form, posting JSON or a plain HTML form.
  WEBSITE
  /// A Google Ads lead form's webhook integration.
  GOOGLE_LEAD_FORM
  /// A portal (99acres, Housing.com), a WhatsApp tool, Zapier or Pabbly.
  PORTAL
  /// A Facebook Page whose lead ads (Facebook and Instagram) land here.
  META_PAGE
}

/// One door leads come in through by themselves (lead intake, 21 Oct 2026).
///
/// The secret is shown to the owner once, when the door is made or given a
/// new key, and only its SHA-256 is kept: a leaked database row cannot be
/// used to post leads. A Meta Page has no secret of ours (Meta signs its
/// posts with the app secret); it is found by `metaPageId`, which one studio
/// at a time may hold.
model StudioLeadConnection {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  kind  LeadConnectionKind
  /// The owner's name for it ("Website", "99acres", "Kitchen campaign").
  label String

  /// Off: posts are refused (generic, Google) or ignored (Meta), and nothing lands.
  enabled Boolean @default(true)

  /// SHA-256 (hex) of the secret. Never the secret itself.
  secretHash String

  /// The Facebook Page id, for META_PAGE only. Unique when set.
  metaPageId String? @unique

  lastEventAt DateTime?
  eventCount  Int       @default(0)

  /// "New leads go to", for this door only (owner, 22 Oct 2026): null follows
  /// the studio's rule; POOL keeps its leads in the pool; PERSON gives them to
  /// `routeMemberId`; TURNS uses the studio's turn list. Plain text member id.
  routeMode     LeadRouteMode?
  routeMemberId String?

  /// The member who made it (StudioMember id). Plain text, not a relation:
  /// removing somebody from the team must not touch the studio's lead doors.
  createdById String?
  createdAt   DateTime @default(now())

  events StudioLeadIntakeEvent[]

  @@index([studioId])
  @@map("studio_lead_connections")
}

/// What happened to one incoming lead.
enum LeadIntakeStatus {
  /// Taken, being worked on (a Meta lead between the ack and the Graph fetch).
  RECEIVED
  /// A new lead on the board.
  LANDED
  /// Could not land (no page token, Graph refused, no name or number).
  FAILED
  /// The phone was already on the board: added to that lead's timeline instead.
  DUPLICATE
}

/// One incoming lead, once (lead intake, 21 Oct 2026). Unique on the
/// connection and the provider's own id, so a Meta or Google retry of the
/// same lead can never make a second card. No payload is kept: the lead
/// itself is the record, and a copy of a stranger's answers here would be
/// personal data with no screen that reads it.
model StudioLeadIntakeEvent {
  id           String               @id @default(cuid())
  connectionId String
  connection   StudioLeadConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// The provider's id (Meta leadgen_id, Google lead_id), the caller's own
  /// id, or `h:` and a hash of phone and minute when the caller sends none.
  externalId String

  status LeadIntakeStatus @default(RECEIVED)
  /// The lead it landed as or on. Plain text, not a relation: erasing the
  /// lead from the bin keeps the receipt (the link then goes nowhere).
  clientId String?
  /// Why it failed, in words the owner can act on. Never a token.
  error    String?
  /// Google's "Send test data": recorded here, not put on the board.
  isTest   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
  @@index([connectionId, createdAt])
  @@map("studio_lead_intake_events")
}

/// Who gets a lead that arrives by itself (owner, 22 Oct 2026).
enum LeadRouteMode {
  /// Nobody: the pool, as before.
  POOL
  /// One chosen member.
  PERSON
  /// Round the chosen members in turn.
  TURNS
}

/// Where one Conversions API event is.
enum ConversionEventStatus {
  /// Waiting to be sent (in `after()`, or by the daily retry).
  QUEUED
  SENT
  /// Meta refused it or could not be reached; retried daily, five tries in all.
  FAILED
  /// Not sent and never will be: switched off, not set up, or the lead went.
  SKIPPED
}

/// One Meta Conversions API event about one lead (owner, 22 Oct 2026;
/// studio-sales/conversions.ts). Only for a lead with a `leadgenId` (it came
/// from a Meta lead ad), only when the studio switched it on. Unique on the
/// lead and the event, so each event is sent at most once per lead however
/// often the card moves back and forth. No payload is kept: it is rebuilt
/// from the lead when sent, so no hashed phone or email sits in this table.
model StudioConversionEvent {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// "QualifiedLead", "ConvertedLead", "Contacted".
  eventName String
  /// The column the move went into. Plain text: removing a column keeps the row.
  stageId   String?

  status    ConversionEventStatus @default(QUEUED)
  attempts  Int                   @default(0)
  /// Meta's words, short, never a token.
  lastError String?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, eventName])
  @@index([studioId, createdAt])
  @@index([status, updatedAt])
  @@map("studio_conversion_events")
}

/// One request against a rate-limited thing.
///
/// ## Why rows rather than a counter
///
/// A counter per window is one row and one upsert, and it is a FIXED window:
/// somebody can spend the whole quota at 09:59:59 and the whole of the next
/// one at 10:00:01, which is double the rate at exactly the moment an
/// automated caller lands. `lookup-limit.ts` already refuses that trade for
/// the in-memory limiter and the reasoning does not change here.
///
/// So each attempt is a row and the window slides. The cost is a delete of
/// expired rows on every consume, which is one indexed range delete — cheap,
/// and it keeps the table from growing without a cron.
///
/// ## Why this is not per-tenant
///
/// The bucket is whatever the caller says it is: an IP, a form id, a studio.
/// The table is infrastructure, not domain data, and scoping it to a studio
/// would make it useless for the case it exists for — an unauthenticated
/// stranger posting to a public form, who belongs to no studio at all.
model RateLimitHit {
  id String @id @default(cuid())

  /// Namespaced by the caller: `form:<id>`, `ip:<addr>`, `lookup:<addr>`.
  /// Namespacing is the caller's job so two features cannot collide on a
  /// bare IP and silently share a quota.
  bucket String

  createdAt DateTime @default(now())

  /// The only query: count and prune one bucket's recent rows.
  @@index([bucket, createdAt])
  @@map("rate_limit_hits")
}

enum ProjectStage {
  DESIGN
  EXECUTION
  FINISHING
  HANDOVER
  CLOSED
}

model StudioProject {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  clientId String
  client   StudioClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name  String
  stage ProjectStage @default(DESIGN)

  /// Frozen when the project is created from a won quotation, and the
  /// figure every later number is measured against. Editing the
  /// quotation afterwards must not move it.
  contractPaise BigInt?
  quoteId       String?

  startedOn    DateTime?
  targetDate   DateTime?
  handedOverOn DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders StudioWorkOrder[]

  @@index([studioId, stage])
  @@map("studio_projects")
}

/// A trade a studio subcontracts. Free text rather than an enum: every
/// studio's list is slightly different, and an enum cannot have a value
/// added by a user.
model StudioVendor {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name     String
  trade    String
  phone    String?
  gstin    String?
  notes    String? @db.Text
  isActive Boolean @default(true)

  /// Studio OS Phase 3 — a site crew (docs/studio-os/PHASE-3-EXECUTION.md).
  /// TEMPORARY needs a name and a trade; PERMANENT also a phone, PAN and
  /// Aadhaar (modules/studio-crews/kyc.ts). `trade` stays the primary trade's
  /// key; `trades` holds every trade they work in (keys from the studio's
  /// trade list). The full Aadhaar number is never stored: last 4 only.
  /// Scans and the agreement sit in the private `crew-kyc` bucket, owner and
  /// accounts only. Payee details are for paying them. Archived, never
  /// deleted once they have work.
  kind              CrewKind  @default(TEMPORARY)
  trades            String[]  @default([])
  altPhone          String?
  address           String?
  workingSince      String?
  panNumber         String?
  aadhaarLast4      String?
  aadhaarDocPath    String?
  panDocPath        String?
  agreementDocPath  String?
  kycCheckedAt      DateTime?
  kycCheckedById    String?
  upiId             String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  archivedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates          StudioVendorRate[]
  workOrders     StudioWorkOrder[]
  homeWorkOrders HomeWorkOrder[]

  @@unique([studioId, name])
  /// A PAN belongs to one crew per studio (NULLs do not clash).
  @@unique([studioId, panNumber])
  @@index([studioId, trade])
  @@map("studio_vendors")
}

/// What this vendor charges for one item.
///
/// A rate card belongs to the VENDOR, not the trade — two carpenters
/// price the same item differently, and the card that loads onto a work
/// order follows the vendor chosen.
model StudioVendorRate {
  id       String       @id @default(cuid())
  vendorId String
  vendor   StudioVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  item      String
  unit      QuoteUnit @default(SQFT)
  /// Null = "agree it per job" (a customised item). Studio OS Phase 3: a 0 is
  /// read as null too, so a line never silently prices at ₹0.
  ratePaise BigInt?

  /// Studio OS Phase 3: the crew's unit (sq ft, running ft, point, number,
  /// lump sum). Null on older rows, which read `unit`.
  crewUnit  CrewUnit?
  /// The trade key this item belongs to, for the card's grouping.
  trade     String?
  sortOrder Int       @default(0)

  @@unique([vendorId, item])
  @@map("studio_vendor_rates")
}

model StudioWorkOrder {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  projectId String
  project   StudioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   StudioVendor @relation(fields: [vendorId], references: [id])

  trade    String
  issuedOn DateTime  @default(now())
  dueOn    DateTime?
  notes    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    StudioWorkOrderLine[]
  payments StudioVendorPayment[]

  @@index([studioId, projectId])
  @@index([vendorId])
  @@map("studio_work_orders")
}

model StudioWorkOrderLine {
  id          String          @id @default(cuid())
  workOrderId String
  workOrder   StudioWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  description String
  unit        QuoteUnit
  /// Thousandths, like every other quantity in this schema.
  qtyMilli    Int?
  /// The vendor's rate AS IT WAS when this order was raised.
  ratePaise   BigInt
  amountPaise BigInt

  sortOrder Int @default(0)

  @@index([workOrderId, sortOrder])
  @@map("studio_work_order_lines")
}

enum PaymentMode {
  BANK
  UPI
  CASH
  CHEQUE
}

/// Money that has left the studio.
///
/// Append-only in spirit: a correction is another row, never an edit.
/// This is the table a vendor dispute turns on, and a record somebody
/// could quietly change is not a record.
model StudioVendorPayment {
  id          String          @id @default(cuid())
  workOrderId String
  workOrder   StudioWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  paidOn      DateTime    @default(now())
  amountPaise BigInt
  mode        PaymentMode @default(BANK)
  reference   String?
  note        String?

  createdAt DateTime @default(now())

  @@index([workOrderId, paidOn])
  @@map("studio_vendor_payments")
}

// ─────────────────────────────────────────────────────────────────────
// THE CUSTOMER JOURNEY, KEPT
//
// Everything below records what a customer actually did with the quotes
// we gave them. Until this existed, the single richest signal in the
// product was thrown away: the generated quotes, which studios were put
// side by side and which lines mattered lived in sessionStorage and died
// when the tab closed. The brief survived; what the brief led to did not.
//
// ## Why this is worth a table rather than an event
//
// `AnalyticsEvent` already records that a quote was viewed. That answers
// "how many" and can never answer "which" — it carries no amounts, no
// lines and no materials, and by design it holds numbers and slugs only.
// The question this business eventually has to answer is *which quotes
// turned into work, and what did the ones that won have in common* — and
// that needs the quote itself, not a counter that one happened.
//
// ## The rule these tables obey
//
// A quote with no outcome teaches nothing. `FirstQuoteSet.wonByStudioId`
// is the column everything here exists to eventually fill; recording the
// quotes without it would be collecting homework nobody marks. It is
// nullable because most briefs never reach a decision, and an unfilled
// outcome must read as unknown rather than as a loss.
//
// ## What is deliberately NOT here
//
// The floor plan file (it is in a private bucket, and its object path is
// already on Brief). Anything the studio wrote. And any judgement about
// why one quote beat another — that is an inference, and inferences do
// not belong in the same table as facts.
// ─────────────────────────────────────────────────────────────────────

/// One studio, priced once, against one brief.
///
/// Regenerating replaces the row rather than adding a second: the customer
/// has one quote per studio at any moment and a history of supersedes would
/// make every later query ask "which one did they actually see?".
model FirstQuote {
  id      String @id @default(cuid())
  briefId String
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // The commercial shape, in paise. Stored rather than recomputed, because
  // the rate card behind it moves and a quote is a thing we said on a day.
  modularPaise         BigInt
  nonModularPaise      BigInt
  modularDiscountPaise BigInt
  professionalFeePaise BigInt
  /// The One Interiors curated discount on this quote, as the customer saw
  /// it. Zero when the studio has none (or the quote predates it).
  curatedDiscountPaise BigInt @default(0)
  gstPaise             BigInt
  totalPaise           BigInt
  lowPaise             BigInt
  highPaise            BigInt
  variancePct          Float

  /// The one measurement that genuinely comes from the plan, and the single
  /// biggest mover of the total. Null when a standard kitchen was assumed.
  kitchenRunMm Int?

  /// Where that number came from: the plan, the customer's tape measure, or
  /// our standard. It is why the band is ±10% or ±16%, so it has to survive.
  runSource RunSource

  /// Catalogue codes this studio had filed no rate for. A quote that silently
  /// omits work is the defect the whole product argues against, so the gaps
  /// are recorded as explicitly as the prices.
  notPriced String[] @default([])

  /// Which rate data produced this. While `ratesAreReal()` is false every row
  /// here is priced on archive medians wearing a studio's name, and a year
  /// from now nobody will remember that unless the row says so.
  ratesVersion String

  builtAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines FirstQuoteLine[]

  /// One quote per studio per brief. Regenerating updates in place.
  @@unique([briefId, studioId])
  @@index([briefId, totalPaise])
  @@index([studioId, builtAt])
  @@map("first_quotes")
}

/// A line of a first quote, with its quantity and its material.
///
/// The lines are kept in full, not summarised to a room subtotal. A total
/// without the lines under it is precisely what the landing page holds up as
/// the thing wrong with every other quote in this market, and storing it that
/// way would make our own records worse than the document we showed.
model FirstQuoteLine {
  id      String     @id @default(cuid())
  quoteId String
  quote   FirstQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Catalogue code — the reason a row means the same thing across studios.
  code  String
  room  String
  label String

  /// MO / NM. Which half of the total this falls in.
  work String

  /// "1800 × 2100 mm", "104 sq ft". What the customer was shown.
  size     String
  quantity Float
  unit     String

  ratePaise   BigInt
  amountPaise BigInt

  /// THIS studio's own wording for the material. The only column that can
  /// differ between two studios on the same code, and therefore the only one
  /// that can ever explain a price gap.
  spec String

  /// False when a real kitchen run was supplied and this line used it.
  standard Boolean @default(true)

  @@unique([quoteId, code])
  @@index([code])
  @@map("first_quote_lines")
}

/// What the customer did with the quotes, and how it ended.
///
/// One row per brief. Starring and comparing are revisions of a single
/// opinion rather than a log of separate acts — somebody who stars a line and
/// unstars it has not told us two things.
model QuoteDecision {
  id      String @id @default(cuid())
  briefId String @unique
  brief   Brief  @relation(fields: [briefId], references: [id], onDelete: Cascade)

  /// Studio slugs put side by side, in the order they were added.
  comparedSlugs String[] @default([])

  /// Catalogue codes the customer starred on the comparison.
  ///
  /// The most direct statement of intent anywhere in the product: not what
  /// they said they wanted in the quiz, but which work they checked the price
  /// of twice. Worth more than the brief for understanding a customer, and it
  /// was being discarded.
  starredCodes String[] @default([])

  /// Set when we know. Null means unknown, never "lost" — most briefs simply
  /// never reach a decision, and an unfilled outcome that reads as a loss
  /// would poison every rate this is eventually used to calculate.
  wonByStudioId String?
  wonByStudio   Studio? @relation("FirstQuoteWinner", fields: [wonByStudioId], references: [id], onDelete: SetNull)

  /// How we came to know. An outcome with no provenance is a rumour.
  outcomeSource OutcomeSource?
  decidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wonByStudioId])
  @@map("quote_decisions")
}

/// Where the kitchen run came from, which is what sets the band.
enum RunSource {
  /// Read from the floor plan they uploaded. ±10%.
  FLOOR_PLAN
  /// They measured it themselves. ±12%.
  CUSTOMER
  /// Nobody measured; the standard 4400mm was used. ±16%.
  STANDARD
}

/// How we learned who won. Never inferred from silence.
enum OutcomeSource {
  /// Ops recorded it after the introduction.
  OPS_RECORDED
  /// The studio marked the introduced client won in their own CRM.
  STUDIO_CRM
  /// The customer told us.
  CUSTOMER_REPORTED
}

// ─────────────────────────────────────────────────────────────
// QUOTATION ARCHIVE
//
// A studio's own past quotations, sent so we can derive their rate card
// instead of asking them to type forty numbers from memory.
//
// `modules/quotation/ingest.ts` is what turns those quotations into rates, and
// it has existed and been tested for a long time against a real archive — 934
// quotations, 25,592 line items, 412 distinct spellings of about twenty
// products. What did not exist was any way for a studio to actually send us
// anything. These two models are that missing half.
//
// The extraction itself is deliberately NOT automated here. Quotation formats
// vary wildly between studios, a parser that is wrong is worse than no parser
// because it produces a plausible rate rather than an error, and at ten
// studios a person reading the files is both affordable and more accurate.
// So: the studio uploads whatever they have, ops pulls the rows out, and
// `ingestQuotations` does the arithmetic.
// ─────────────────────────────────────────────────────────────

enum ArchiveState {
  /// Files are in. Nobody has looked yet.
  RECEIVED
  /// Ops is reading them.
  READING
  /// Rates were derived and filed against the studio's rate card.
  FILED
  /// Not usable — too few, unreadable, or not quotations. `note` says why.
  REJECTED
}

model QuotationArchive {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  state ArchiveState @default(RECEIVED)

  /// How many quotations ops counted once they opened the files.
  ///
  /// Deliberately not a count of FILES: one workbook can hold two hundred
  /// quotations and one PDF can hold a single one, so file count says nothing
  /// about whether there is enough here to derive a rate from. Null until
  /// somebody has actually looked.
  quotationCount Int?

  /// What ops wants the studio to know — why it was rejected, what is missing,
  /// what to send instead. Shown to the studio verbatim, so it is written for
  /// them rather than for us.
  note String? @db.Text

  /// The IngestReport from `ingestQuotations`, kept whole.
  ///
  /// Stored rather than recomputed because it is evidence: which rate came
  /// from how many quotations, the quartile spread behind each one, and the
  /// product strings we could not place. When a studio disputes a number a
  /// year from now, this is the answer.
  report Json?

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?
  updatedAt  DateTime  @updatedAt

  /// Where automatic reading has got to, separate from `state`.
  ///
  /// `state` describes what OPS has done. This describes what the MACHINE has
  /// done, and they move independently: an archive can be read automatically
  /// and still be waiting on a person, which is the normal case and the one
  /// this split exists to represent. See `analysis-states.ts`.
  analysisState String    @default("NOT_STARTED")
  /// For ops, not for the studio. Extraction fails in ways worth reading.
  analysisError String?   @db.Text
  analysedAt    DateTime?

  files      QuotationFile[]
  drafts     StudioProductDraft[]
  filedRates StudioFiledRate[]

  @@index([studioId, uploadedAt])
  @@index([state])
  @@map("quotation_archives")
}

model QuotationFile {
  id        String           @id @default(cuid())
  archiveId String
  archive   QuotationArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  /// Object path in the private quotation bucket. Never a public URL — these
  /// are somebody's commercial pricing, and they are served only through a
  /// short-lived signed link to ops. Same rule as floor plans.
  path String

  /// What the studio called it. Shown back to them so they can tell which
  /// file we could not read, and useful to ops for exactly the same reason.
  filename    String
  contentType String
  bytes       Int

  uploadedAt DateTime @default(now())

  @@index([archiveId])
  @@map("quotation_files")
}

/// A file a studio sent to back up its registration.
///
/// ## Why a table and not a `proofUrl` column on Studio
///
/// Because more than one is the normal answer. A GST certificate AND a Udyam
/// registration AND a shop licence is an ordinary set for a Pune practice,
/// and a single column would mean each upload silently erased the last — the
/// studio would see their newest file and have no idea the others were gone.
///
/// ## `kind` and `state` are strings, not enums
///
/// Unlike `QuotationArchive`, which uses `ArchiveState`. The values here are
/// a list we expect to extend as often as somebody sends a document type we
/// had not thought of, and every addition to a Postgres enum is a migration
/// that has to ship before the code that writes the value. The trade is
/// deliberate: `document-kinds.ts` holds the allowed values and is the thing
/// to read.
model StudioDocument {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// What the studio says it is. A claim — nobody has opened it yet.
  kind String

  storageKey   String
  /// Kept because it is often the only thing telling two scans apart, and it
  /// is what ops reads before deciding whether to open anything.
  originalName String
  contentType  String
  bytes        Int

  /// RECEIVED until a person looks. Deliberately not "PENDING", which reads
  /// as a queue position we are not promising.
  state String @default("RECEIVED")

  /// Shown to the studio verbatim, so it is written for them and not for us.
  note String? @db.Text

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("StudioDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  /// Soft delete. A withdrawn upload stays for the audit trail and stops
  /// counting toward anything — see the partial index.
  deletedAt DateTime?

  @@index([studioId])
  @@index([studioId, state])
  @@map("studio_documents")
}

/// One rate, for one catalogue item, derived from one studio's own quotations.
///
/// ## Why this table exists
///
/// `src/data/filed-rates.ts` says in its own header that the per-studio
/// variation in it is a placeholder, to be replaced by what
/// `ingestQuotations()` derives from each studio's archive. That function has
/// been written and tested for some time; there was simply nowhere to put its
/// output. This is that place, and the placeholder file stays as the fallback
/// for a studio that has not filed.
///
/// ## Nothing here reaches a customer unreviewed
///
/// Rows land as PENDING. A rate read out of a PDF by a model is evidence, not
/// a price — see `analysis-states.ts` for the whole progression.
model StudioFiledRate {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// The archive this was derived from, so a rate can always be traced back
  /// to the documents behind it. SetNull: deleting an archive must not
  /// silently remove the rates a customer is being quoted at.
  archiveId String?
  archive   QuotationArchive? @relation(fields: [archiveId], references: [id], onDelete: SetNull)

  /// A catalogue item code. Text, not a relation — the catalogue lives in
  /// code because it is the one thing identical for every studio, and a row
  /// for a code since retired must stay readable rather than break a join.
  code String

  /// Per sqft of face for AREA, per unit for UNIT, per sqft carpet, per bath.
  ratePaise BigInt

  /// How many of the studio's quotations this ONE rate came from.
  ///
  /// Per rate and not per archive, which is the point: a studio can file
  /// forty quotations of which three mention a mandir. The kitchen rate is
  /// then solid and the mandir rate is one designer's mood, and without this
  /// they look identical on the screen ops approves them from.
  fromQuotations Int

  /// The studio's own words for the material on this line. The canonical line
  /// is identical for everybody, so this is the only place two studios can
  /// visibly differ on something other than price.
  spec String?

  /// PENDING · LIVE · REJECTED · SUPERSEDED. See `analysis-states.ts`.
  state String  @default("PENDING")
  /// Why it was rejected, in words ops writes for the studio.
  note  String? @db.Text

  derivedAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("FiledRateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([studioId, state])
  @@index([archiveId])
  @@map("studio_filed_rates")
}

// ─────────────────────────────────────────────────────────────
// WAITLIST — the pre-launch landing page
// ─────────────────────────────────────────────────────────────
// Fed by oneinteriors.in (a separate deployment) through
// POST /api/waitlist, authenticated with WAITLIST_INGEST_TOKEN.
//
// That page deliberately holds no database credential. A Supabase
// service_role key would let a marketing landing page read every user,
// brief and quote in this project; a bearer token scoped to one route
// lets it do exactly one thing — add a name to this table.

model WaitlistSignup {
  id String @id @default(cuid())

  name String

  /// E.164, as everywhere else in this schema. Unique, so someone who
  /// signs up twice updates their row instead of appearing twice — the
  /// total gets quoted to studios and has to mean people, not form
  /// submissions.
  phone String? @unique
  email String? @unique

  /// Their pick from the four style cards. Useful when deciding which
  /// studios to recruit first.
  style String?
  city  String  @default("Pune")

  /// Which share link brought them (?s=baner-greens). The campaign is
  /// one WhatsApp message per society, and this column is the only way
  /// to know which of those groups actually worked.
  via    String?
  source String  @default("waitlist-landing")

  /// What they were told when they handed over the number, and that
  /// they were told it. Consent does not survive a material change to
  /// the wording, and that is only knowable if the version in force at
  /// the time was written down — the same rule as Consent.policyVersion.
  notifyConsent Boolean @default(true)
  policyVersion String

  /// Their personal link's code (oneinteriors.in/?r=CODE). Everyone who
  /// joins through it moves them up the queue (modules/waitlist/queue.ts).
  referralCode   String? @unique
  /// Whose link brought them — another row's referralCode.
  referredByCode String?

  /// The optional "skip 20 places" answers, given after joining.
  possession String? // HAVE_KEYS | WITHIN_3_MONTHS | LATER
  bhk        String? // 1 | 2 | 3 | 4+
  society    String?
  extrasAt   DateTime?

  /// When the welcome message went out, and on which channel.
  welcomedAt     DateTime?
  welcomeChannel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([via])
  @@index([referredByCode])
  @@index([society])
  @@map("waitlist_signups")
}

/// A product-master row read from a studio's own quotations, waiting for ops.
///
/// Written by the owner's local read (`/read-quotations` in Claude Code —
/// docs/READ-QUOTATIONS.md), never by the web app: reading quotations through
/// the API from a request got stuck and ran up the bill (10 Oct 2026). Ops
/// approves the run on /ops/[slug], which upserts these into StudioProduct
/// and asks the studio to check them. Same shape as StudioProduct on purpose.
/// A copy of a studio's whole product master, taken before anything replaces
/// it in bulk (an approved quotation read). Restored from the laptop with
/// `scripts/quotations/restore.ts`. Rates are private: ops and the owner only.
model StudioProductBackup {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  /// Why it was taken: "before approving run-…".
  reason  String
  /// Every product row as it stood, rates in paise as strings.
  rows    Json
  takenAt DateTime @default(now())

  @@index([studioId, takenAt])
  @@map("studio_product_backups")
}

model StudioProductDraft {
  id        String            @id @default(cuid())
  studioId  String
  studio    Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  archiveId String?
  archive   QuotationArchive? @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  /// One read = one run; a newer run supersedes the older PENDING rows.
  runId     String

  name            String
  code            StudioWorkCode @default(MODULAR)
  unit            QuoteUnit      @default(AREA)
  details         String?        @db.Text
  ratePaise       BigInt
  rooms           String[]
  defaultWidthMm  Int?
  defaultHeightMm Int?
  defaultQty      Int?
  inStandardBuild Boolean        @default(false)
  rules           Json?
  sortOrder       Int            @default(100)

  /// How many of the studio's quotations this rate was seen in, and the
  /// spread, so ops can tell a firm rate from a guess.
  fromQuotations Int   @default(0)
  evidence       Json?

  /// PENDING | APPROVED | REJECTED | SUPERSEDED
  state        String    @default("PENDING")
  note         String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([studioId, state])
  @@map("studio_product_drafts")
}

// ── Floor plan → first quotation (studio-quote, 12 Oct 2026) ──────────────
// Migration 20261012130000_studio_quote_floorplan. Plain id columns, no
// relations, so no existing model is edited (three agents share this file).

/// One Claude read of one floor plan, per studio, keyed by the file's
/// content hash: the same file is never read twice (floorplan/plan-cache.ts).
model StudioPlanReading {
  id            String   @id @default(cuid())
  studioId      String
  /// sha256 (hex) of the file's bytes.
  contentHash   String
  /// READING | READ | FAILED
  status        String   @default("READING")
  /// Why it failed, as a short code (never the plan or the reply).
  reason        String?
  /// floorplan/reading.ts shape, when READ.
  reading       Json?
  attempts      Int      @default(1)
  lastAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studioId, contentHash])
  @@index([studioId, lastAttemptAt])
  @@map("studio_plan_readings")
}

/// The latest "read this plan and build the first quotation" run for one
/// lead file, so the lead page can say what happened after a reload.
model StudioPlanJob {
  id         String    @id @default(cuid())
  studioId   String
  clientId   String
  fileId     String    @unique
  /// READING | BUILT | READ | FALLBACK | FAILED
  status     String
  message    String?
  quoteId    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([studioId, clientId])
  @@map("studio_plan_jobs")
}

/// Which lead file a quotation's rooms were read from ("Read rooms" on a
/// draft, or the first quotation built from a plan).
model StudioQuotePlan {
  quoteId   String   @id
  studioId  String
  fileId    String
  createdAt DateTime @default(now())

  @@index([studioId])
  @@map("studio_quote_plans")
}

/// A product somebody proposed from the quotation builder that is not in the
/// product master yet (Hauspire's "Propose a NEW product"): a salesperson's
/// waits here until the owner or a project manager approves it (it is then
/// added to the product master) or rejects it. Migration
/// 20261013100000_studio_product_proposals. Plain id columns, no relations.
model StudioProductProposal {
  id           String         @id @default(cuid())
  studioId     String
  name         String
  code         StudioWorkCode @default(ONSITE)
  unit         QuoteUnit      @default(UNIT)
  /// Per sq ft, per rft or per unit, depending on `unit`. Paise.
  ratePaise    BigInt
  details      String?        @db.Text
  /// The room category it was proposed in ("Kitchen", "Bedroom", …).
  room         String?
  /// The quotation it was proposed on, and who proposed it (member ids).
  quoteId      String?
  proposedById String?
  proposedBy   String?
  /// PENDING | APPROVED | REJECTED
  state        String         @default("PENDING")
  createdAt    DateTime       @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([studioId, state])
  @@map("studio_product_proposals")
}

// ── Studio OS Phase 2: design (docs/studio-os/PHASE-2-DESIGN.md) ─────────

enum SiteVisitStatus {
  BOOKED
  DONE
  CANCELLED
}

/// A site visit the designer books (measurement, a visit with the carpenter).
/// The customer sees the day, time, what it is for and its status; `note`
/// stays with the team.
model HomeSiteVisit {
  id        String          @id @default(cuid())
  projectId String
  project   HomeProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  at        DateTime
  purpose   String
  status    SiteVisitStatus @default(BOOKED)
  /// Internal: NEVER crosses.
  note      String?         @db.Text
  byId      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([projectId, at])
  @@map("home_site_visits")
}

/// One room's measurements, in millimetres (typed in feet). A simple list
/// the designer keeps up to date; the customer sees it.
model HomeMeasurement {
  id          String      @id @default(cuid())
  projectId   String
  project     HomeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room        String
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  note        String?
  sortOrder   Int         @default(0)
  updatedById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId, sortOrder])
  @@map("home_measurements")
}

enum DesignVerdict {
  APPROVED
  CHANGES
}

/// The customer's answer to a shared drawing: approved, or changes asked
/// with a comment. Append-only (project/append-only.ts): a new answer is a
/// new row; the latest on the newest version is the drawing's state.
model HomeDesignReview {
  id         String        @id @default(cuid())
  projectId  String
  project    HomeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String
  document   HomeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  verdict    DesignVerdict
  comment    String?       @db.Text
  byUserId   String
  at         DateTime      @default(now())

  @@index([projectId, at])
  @@index([documentId])
  @@map("home_design_reviews")
}

enum DelaySide {
  CLIENT
  STUDIO
}

/// A design step's planned day moved, and why (client side or studio side).
/// Append-only: the step's `plannedOn` holds today's day, these rows the
/// history. The customer sees the new day and the reason in plain words,
/// never `note`.
model HomeStepDelay {
  id        String            @id @default(cuid())
  projectId String
  project   HomeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepId    String
  step      HomeChecklistItem @relation(fields: [stepId], references: [id], onDelete: Cascade)
  fromDate  DateTime          @db.Date
  toDate    DateTime          @db.Date
  side      DelaySide
  reason    String
  /// Internal: NEVER crosses.
  note      String?           @db.Text
  byId      String
  at        DateTime          @default(now())

  @@index([projectId, at])
  @@index([stepId])
  @@map("home_step_delays")
}

// ─────────────────────────────────────────────────────────────
// STUDIO OS PHASE 3 — SITE CREWS (docs/studio-os/PHASE-3-EXECUTION.md)
//
// Hauspire's Vendor Ledger, ported (docs/studio-os/HAUSPIRE-VENDOR-APP.md):
// one work order per crew per project, built from the design final (else
// the sales final); every line freezes the quote's figures and the crew's
// rate when it is raised; measured beats quoted and an agreed amount beats
// rate × quantity; bill, paid and balance are never stored, always added up
// (modules/studio-crews/money.ts). Internal only: crews never log in, and no
// customer projection reads these tables. Money is integer paise.
// ─────────────────────────────────────────────────────────────

/// Temporary: a one-site hire, name and trade only. Permanent: phone, PAN
/// and Aadhaar (last 4) on file.
enum CrewKind {
  TEMPORARY
  PERMANENT
}

/// How a crew is paid for an item.
enum CrewUnit {
  SQFT
  RFT
  POINT
  NOS
  LUMP
}

/// Where a work order is. SETTLED is marked by owner or accounts once the
/// balance is within ₹1; WORK_DONE is the PM's signal that it can be paid.
enum WorkOrderStatus {
  DRAFT
  ISSUED
  IN_PROGRESS
  WORK_DONE
  SETTLED
}

/// Where a line's quantity came from: the quote's own sizes, a person's
/// estimate, measured on site, added by hand, or billed on invoice.
enum CrewQtySource {
  QUOTE
  ESTIMATE
  SITE
  MANUAL
  INVOICE
}

/// A carpentry line: installation only (the units come made; per sq ft,
/// ₹150 by default) or full carpentry (per sq ft per product type).
enum CarpentryMode {
  INSTALL
  FULL
}

/// A payment against the balance, an advance (may run ahead of the bill up
/// to the studio's advance limit), or a correction (reverses one earlier
/// payment; the right one is then recorded again).
enum CrewPaymentKind {
  PAYMENT
  ADVANCE
  CORRECTION
}

/// One crew's work on one customer project. One per crew per project:
/// a crew working in two trades gets one work order, so their balance stays
/// in one place. Never deleted once anything is paid; archived instead.
model HomeWorkOrder {
  id       String @id @default(cuid())
  /// Denormalised: every overview reads "this studio's".
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  projectId String
  project   HomeProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    StudioVendor @relation(fields: [vendorId], references: [id])

  /// 1, 2, 3… per project, for the statement's reference.
  number Int
  /// The trade keys on this work order.
  trades String[]        @default([])
  status WorkOrderStatus @default(DRAFT)
  dueOn  DateTime?       @db.Date

  /// The quotation it was built from, and which final that was
  /// (DESIGN_FINAL or SALES_FINAL).
  sourceQuoteId String?
  sourceKind    String?

  /// Tracker steps (HomeChecklistItem ids of this project) linked to it, so
  /// the PM sees the work's progress beside it. Not keys: steps may be
  /// removed from the plan.
  stepIds String[] @default([])

  notes String? @db.Text

  workDoneAt     DateTime?
  workDoneByName String?
  settledAt      DateTime?
  archivedAt     DateTime?
  createdById    String?
  createdByName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    HomeWorkOrderLine[]
  payments HomeCrewPayment[]

  @@unique([projectId, vendorId])
  @@unique([projectId, number])
  @@index([studioId, status])
  @@index([vendorId])
  @@map("home_work_orders")
}

/// One line of a work order. A SNAPSHOT: the quote's room, product, sizes,
/// quantity and client value, and the crew's item, unit and rate as they
/// were when it was raised. Changing a rate card never re-prices it.
model HomeWorkOrderLine {
  id          String        @id @default(cuid())
  workOrderId String
  workOrder   HomeWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  /// The quote line it came from (a reference, not a key). Null for extras.
  quoteLineId String?

  room     String
  product  String
  code     StudioWorkCode?
  details  String?         @db.Text
  widthMm  Int?
  heightMm Int?
  /// What the client is charged for this line, paise. Null for extras.
  quotedAmountPaise BigInt?

  /// The trade key it was routed to, and whether the router only guessed.
  trade   String
  guessed Boolean @default(false)

  /// The crew's item, unit and rate (paise per unit; null = needs a price).
  item       String
  unit       CrewUnit
  ratePaise  BigInt?
  /// The rate differs from the crew's card for this project only.
  rateEdited Boolean        @default(false)
  carpentry  CarpentryMode?

  /// Thousandths. The quantity from the quote (or a person's estimate);
  /// `measuredQtyMilli`, measured on site, wins over it.
  qtyMilli         Int?
  measuredQtyMilli Int?
  qtySource        CrewQtySource @default(QUOTE)
  /// Agreed for this line, paise: wins over rate × quantity entirely.
  agreedPaise      BigInt?
  /// Work outside the quotation (no client value).
  isExtra          Boolean       @default(false)

  sortOrder Int       @default(0)
  /// Taken off the work order (the bill recomputes). Kept for the record.
  removedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workOrderId, sortOrder])
  @@map("home_work_order_lines")
}

/// Money paid to a crew. Append-only: a mistake is reversed by a CORRECTION
/// row (negative amount, `correctsId`) and the right payment recorded again.
/// Recorded BY NAME: the person, not a role.
model HomeCrewPayment {
  id          String        @id @default(cuid())
  studioId    String
  studio      Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder   HomeWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  kind        CrewPaymentKind @default(PAYMENT)
  /// Paise; negative only on a CORRECTION.
  amountPaise BigInt
  mode        PaymentMode     @default(UPI)
  reference   String?
  note        String?
  paidOn      DateTime        @db.Date
  byId        String?
  byName      String
  /// The payment this one reverses. Unique: a payment is corrected once.
  correctsId  String?         @unique

  createdAt DateTime @default(now())

  @@index([workOrderId, paidOn])
  @@index([studioId, paidOn])
  @@map("home_crew_payments")
}

/// The studio software plans (owner, 19 Oct 2026). Pro: Leads, Quotations,
/// the product master, settings, Today and Calendar. Max: the full Studio OS.
enum StudioSoftwarePlan {
  /// Pro for a one-person company (owner, 21 Oct 2026): one login.
  SOLO
  PRO
  MAX
}
