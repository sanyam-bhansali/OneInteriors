# ─────────────────────────────────────────────────────────────
# One Interiors — environment
#
# v0.1 runs entirely on fixture data and needs NONE of these.
# Deploy to Vercel with an empty environment and it will work.
# Fill these in as each subsystem is wired up (see README).
# ─────────────────────────────────────────────────────────────

# ── Supabase project ──
# The publishable key is PUBLIC by design — it ships in the browser bundle.
# It is safe only because Row Level Security decides what it can reach. With
# RLS off, this key is full read/write on every table. See docs/DATABASE.md.
# Nothing uses these yet; they are here for Storage (evidence uploads, OI-5c).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Public endpoint. Used to verify Supabase-issued JWTs if we ever accept them.
SUPABASE_JWKS_URL=""

# ── The secret key ──
# sb_secret_ (and the legacy service_role key) BYPASS Row Level Security
# entirely: full read/write on every table, all storage, admin operations.
#
#   · Server-only. NEVER prefix it with NEXT_PUBLIC_ — that inlines it into the
#     browser bundle and publishes it to every visitor.
#   · Never commit it, never send it through chat, Slack or email.
#   · If it is ever exposed, rotate it in Supabase → Settings → API Keys.
#     Rotation is cheap; a leaked key with RLS bypass is not.
#
# We do not currently need it. Prisma authenticates with the database password.
SUPABASE_SECRET_KEY=""

# ── Database — Supabase (see docs/DATABASE.md) ──
# BOTH are required. Pooled for runtime, direct for migrations; migrations
# through the pooler hang. Leave blank to run on fixture studios.
DATABASE_URL=""   # transaction pooler, port 6543, ?pgbouncer=true
DIRECT_URL=""     # direct connection, port 5432
REDIS_URL=""

# ── Sessions ──
# openssl rand -base64 32 — generate a DIFFERENT one for production.
SESSION_SECRET=""

# ── WhatsApp Business API — OTP login + milestone notifications ──
# Meta business verification has a lead time. Start it early.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# The approved template that carries the sign-in code. Must be category
# AUTHENTICATION — a free-form message to someone who has not written to you in
# the last 24 hours is rejected, which is every first-time customer.
# Configurable so an approval delay does not need a code change.
WHATSAPP_OTP_TEMPLATE="one_interiors_otp"
WHATSAPP_OTP_LOCALE="en"

# ── Pre-launch scaffolding — DELETE BOTH BEFORE THE FIRST REAL CUSTOMER ──
# Each refuses to work once NEXT_PUBLIC_ROSTER_IS_REAL=1, so declaring the
# roster real disables them everywhere at once.
#
# Show studios that have not passed verification, so the funnel can be walked
# before any studio is live.
DEV_SHOW_UNVERIFIED_STUDIOS=""
# Print the sign-in code on the page instead of waiting for WhatsApp.
# WARNING: with this on the OTP verifies NOTHING — anyone can claim any number.
# It exists only so the pages behind the sign-in gate are testable while a
# WhatsApp template waits on Meta approval.
DEV_SHOW_OTP_ON_SCREEN=""

# ── Escrow provider (sprint 6) ──
# RBI rules: a licensed partner holds client funds, never us.
ESCROW_PROVIDER="sandbox"
ESCROW_API_KEY=""
ESCROW_WEBHOOK_SECRET=""

# ── Subscription billing (phase 2) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── KYC / registry lookups (sprint 3) ──
# idfy | signzy | surepass | authbridge — none publish flat pricing, get quotes
KYC_PROVIDER=""
KYC_API_KEY=""

# ── Object storage — milestone photos, verification evidence ──
# Private by default. Never serve these from a public bucket.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Analytics ──
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── Public config ──
# Set to "1" ONLY once the roster is real pilot studios rather than the
# invented fixtures. Anything else (including unset) shows the pre-launch
# notice on every page. Default errs toward disclosure on purpose.
NEXT_PUBLIC_ROSTER_IS_REAL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Portfolio drafting agent ─────────────────────────────────────
# Optional. With this unset, drafting is simply off and studios write
# their own copy — nothing else changes, and every test runs without it.
#
# The agent only ever sees facts from our own database, and every draft
# is machine-checked against those facts before a human sees it: any
# number it cannot trace fails the draft. See
# src/modules/studio/portfolio-draft.ts.
ANTHROPIC_API_KEY=""
# Optional override. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=""
